# phpstorm project files
.idea

# netbeans project files
nbproject

# zend studio for eclipse project files
.buildpath
.project
.settings

# sublime text project / workspace files
*.sublime-project
*.sublime-workspace

# windows thumbnail cache
Thumbs.db

# Mac DS_Store Files
.DS_Store

# composer vendor dir
/vendor

# npm dependencies
/node_modules

# Codeception C3
c3.php

# Local environment configuration
.env
/env

# Runtime files (compiled Twig templates, caches, logs)
/runtime

# Local secret material and scratch: VAPID key pairs generated while wiring Web
# Push, JWT test vectors, and dev-server logs. None of it is source, and the
# EC private keys in here are real — storage/ must never reach a commit.
/storage/

# Application cache directory
/cache

# Published/compiled front-end assets (rebuild with `npm run build`).
# Only the three things the build actually emits are ignored: the compiled CSS,
# the synced JS bundle, and the generated icon sprite.
#
# The brand, webmanifest and share-card assets under here are *source*. Nothing
# in `npm run build` produces them, so ignoring the whole directory meant the
# logo, the PWA manifest, the app icons and the OG cards existed only on the
# machine that generated them and never reached a deploy.
/public/assets/*
!/public/assets/brand/
!/public/assets/img/

# User-uploaded recharge receipts (private, served through an authenticated action)
/web/receipts

# Finished service-request files uploaded by an admin. Private by definition —
# NID printouts, certificates — and must never end up in a commit.
/web/deliverables

# Built APKs, promoted into place by an admin. Binaries do not belong in a
# repository: they are rebuilt per release, and /app/apk streams them from
# here through AppReleaseService.
/web/releases

# Python bytecode cache from importing the scripts/ generators as modules
__pycache__/

# Freebuff agent workspace metadata (local only)
/.freebuff

# Project-local agent skill library (installed SKILL.md packs, ~1.3 MB of
# third-party agent docs). Not app source: nothing in this repo references it,
# and every clone would carry 137 files that no build or deploy reads.
/.agents/

# The skills CLI also writes these when installing project-local packs. Same
# rationale as /.agents/: third-party agent docs, not app source.
/.claude/
/skills-lock.json

# Local editor temp metadata and crash files
*.swp
*.swo
*.tmp
*.log
*.bak
*~

# Vite / frontend dev cache (if used locally)
.vite/

# Local PHP CLI / dev caches
.phpunit.result.cache

# Freebuff local project config (contains service UUID, never commit)
config/.freebuff/

# Android build output, Gradle caches and the distributions Gradle downloads
# on first run. One unpacked distribution is ~146 MB and the wrapper cache
# hundreds more, none of it source — `gradlew` reproduces the build, and
# local.properties is this machine's SDK path (see local.properties.example).
# Without these, a plain `git add -A` would stage half a gigabyte of binaries.
/android-admin/.gradle/
/android-admin/build/
/android-admin/app/build/
/android-admin/gradle-*
/android-admin/local.properties
/android-admin/keystore.properties
/android-admin/*.jks
/android-admin/*.keystore
/android-admin/*.p12
/android-admin/*.pfx
/keystore_base64.txt
/admin-release.jks
/android-admin/admin-release.jks
/twa/keystore.properties
/twa/*.jks
/twa/*.keystore
/twa/*.p12

# SQLite databases the test suite creates under tests/Support/Data/ at runtime,
# plus SQLite's sidecar files (-wal/-shm/-journal), which can be non-empty even
# when test.db itself is zero bytes. Only .gitkeep and the fixture are source.
/tests/Support/Data/*.db*

# Android admin keystore material
/keystore_base64.txt
/admin-release.jks
/android-admin/admin-release.jks
/admin-release.jks
/android-admin/admin-release.jks

/android-admin/.kotlin/
.kotlin/
