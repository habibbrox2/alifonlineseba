# Local Gradle/Android build output
.gradle/
build/
local.properties
*.iml
.idea/

# Release signing material. The keystore is what the origin half of the TWA
# trust handshake publishes in /.well-known/assetlinks.json, so leaking it here
# means anyone can sign an update that Chrome will accept for this domain.
keystore.properties
*.jks
*.keystore

# Keystores pasted in by hand rather than by the signing step above.
android.keystore
