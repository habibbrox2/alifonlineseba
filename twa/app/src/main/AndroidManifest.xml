<?xml version="1.0" encoding="utf-8"?>
<!--
  Trusted Web Activity for https://allseba.online.

  There is deliberately NO android:usesCleartextTraffic here. The native client
  in ../../android sets it because it talks to a dev server over http; a TWA
  does not, and shipping that flag would make every WebView-fallback page
  loadable over plaintext.

  The package attribute is gone on purpose: since AGP 8 the namespace in
  build.gradle.kts owns it, and the "." shorthand for activity names below is
  resolved against that namespace.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Without this the delegated notifications are silently dropped on
      Android 13+. The permission is only *requested* at runtime by
      NotificationPermissionRequestActivity, which is declared below.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <meta-data
            android:name="twa_generator"
            android:value="@string/generatorApp" />

        <activity
            android:name=".LauncherActivity"
            android:alwaysRetainTaskState="true"
            android:exported="true"
            android:label="@string/launcherName">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launchUrl" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/colorPrimaryDark" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/navigationColor" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/navigationColorDark" />
            <!-- Note the "androix" spelling: it is the library's own constant,
                 not a typo introduced here. Renaming it silently drops the
                 navbar divider colour. -->
            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/navigationDividerColor" />
            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR_DARK"
                android:resource="@color/navigationDividerColorDark" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/backgroundColor" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="@integer/splash_screen_fade_out_duration" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="@string/providerAuthority" />
            <!-- "customtabs", not "webview": a WebView fallback shows a bare
                 WebView with no address bar and no push notifications. Keeping
                 Custom Tabs means a device without a TWA-capable browser still
                 gets a real, address-barred browser instead. -->
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="@string/fallbackType" />
            <meta-data
                android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="@string/orientation" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              autoVerify is what makes Chrome run
              https://allseba.online/.well-known/assetlinks.json
              during install. If that file does not name this package and this
              signing certificate, verification fails, the TWA silently falls
              back to a browser Custom Tab, and the installed app looks broken
              (no push). See ../../docs/webpush-runbook.md.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="@string/hostName" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/providerAuthority"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!--
          The service that actually runs the TWA, and the one that receives the
          web-push messages the site's Service Worker posts. Both enabled and
          exported are driven from @bool/enableNotification so notifications
          can be turned off in one place.
        -->
        <service
            android:name=".DelegationService"
            android:enabled="@bool/enableNotification"
            android:exported="@bool/enableNotification">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification_icon" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
