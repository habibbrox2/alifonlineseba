<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon. Referenced by the SMALL_ICON meta-data on
  DelegationService; without this file the resource-linking step fails and no
  APK builds at all.

  Two rules Android enforces on small icons, both satisfied here:

    1. It must be a silhouette. The system renders it as a flat mask, so the
       fill colour below is only a fallback for API < 21 and for the
       WebView-fallback path. Everything is #FFFFFFFF: one colour, fully
       opaque, no gradients and no second accent.
    2. It must read at 24dp, which is the height of the whole status bar
       strip. So the mark is redrawn here in a 24x24 viewport rather than
       scaled from the 108dp adaptive-icon foreground, where the strokes
       would thin out to about one pixel.

  The shape is the same brand mark as the launcher icon: the leaning alif
  stroke, its dot, and the baseline bar. Keeping the two in sync is the point
  consistent is the point: a notification that does not look like the app that
  raised it reads as spam, and users block the app to make it stop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- dot, sitting above the top of the stroke so the two do not merge -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18,3.2 m-2.1,0 a2.1,2.1 0 1,1 4.2,0 a2.1,2.1 0 1,1 -4.2,0 Z" />

    <!-- alif stroke: leans left as it descends, like the letter ا -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18.2,6.4 L13.6,6.4 L7.4,18.4 L12,18.4 Z" />

    <!-- rounded baseline -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.6,20.4 L18.4,20.4 A1.1,1.1 0 0,1 18.4,22.6 L5.6,22.6 A1.1,1.1 0 0,1 5.6,20.4 Z" />
</vector>
