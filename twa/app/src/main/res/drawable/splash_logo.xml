<?xml version="1.0" encoding="utf-8"?>
<!-- Alif Tools splash mark, converted from public/assets/brand/logo-mark.svg.
     The tile rectangle is deliberately omitted: the splash backdrop is already
     brand_primary, so drawing the tile inside it would show a visible square
     seam (and on API 31+ the system masks the icon to a circle anyway).
     The 64x64 source art is scaled 1.1x and re-centred inside a 108x108
     viewport so the glyph survives the 160x160dp masked icon area. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:translateX="18.8"
        android:translateY="17.15">

        <!-- golden alif: a vertical stroke that leans like the Arabic letter ا -->
        <path
            android:fillColor="@color/brand_accent"
            android:pathData="M36.5,12 L31,12 L23.5,47.5 L29,47.5 Z" />

        <!-- dot over the alif -->
        <path
            android:fillColor="@color/brand_white"
            android:pathData="M32.5,15.5 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />

        <!-- rounded baseline -->
        <path
            android:fillColor="@color/brand_white"
            android:pathData="M19,51 L45,51 A2,2 0 0,1 45,55 L19,55 A2,2 0 0,1 19,51 Z" />
    </group>
</vector>
