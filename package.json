{
  "name": "th-tools",
  "private": true,
  "description": "TH Tools — digital services hub (Yii 3 + Twig + Tailwind + Alpine)",
  "scripts": {
    "build": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --minify && node scripts/sync-js.js && php scripts/generate-sprite.php",
    "watch": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --watch",
    "copy-js": "node scripts/sync-js.js"
  },
  "devDependencies": {
    "alpinejs": "^3.14.9",
    "lucide-static": "^0.544.0",
    "tailwindcss": "^3.4.17"
  }
}
