{% extends 'layouts/base.twig' %}

{# Authenticated app area — never index. #}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
<div x-data="{ sidebarOpen: false }" class="min-h-screen">
    <!-- Topbar -->
    <header class="sticky top-0 z-40 bg-gradient-to-r from-primary-900 via-primary-800 to-primary-700 shadow-md">
        <div class="container-app flex h-16 items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <!-- Mobile menu button -->
                <button @click="sidebarOpen = true" class="btn btn-ghost-dark btn-sm lg:hidden" aria-label="সাইডবার খুলুন">
                    {{ icon('menu', 'w-5 h-5') }}
                </button>
                <a href="/dashboard" class="flex items-center gap-2.5 font-bold text-white tap-target">
                    <img src="/assets/brand/logo-mark.svg" alt="" class="h-9 w-9" width="36" height="36">
                    <span class="hidden text-lg tracking-tight sm:block">All Seba</span>
                </a>
            </div>

            <div class="flex min-w-0 items-center gap-2 sm:gap-3">
                {# Live balance. Rendered from the fresh DB identity on every request,
                   then kept in sync by app.js (see initHeaderBalance). Sits right
                   before the bell so the amount is always one glance away. #}
                <a href="/profile" id="header-balance" data-balance="{{ identity.balance }}"
                   class="tap-target flex min-w-0 items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-1.5 text-sm font-semibold tabular-nums text-white transition hover:bg-white/15 sm:gap-2 sm:px-3.5"
                   title="আপনার বর্তমান ব্যালেন্স">
                    {{ icon('wallet', 'w-4 h-4 hidden shrink-0 sm:block') }}
                    <span data-balance-text class="truncate">{{ identity.balance|money }}</span>
                </a>

                <!-- Notifications -->
                <div x-data="thNotifications({{ unread }})" @keydown.escape.window="open = false" class="relative">
                    <button @click="toggle()" class="tap-target relative rounded-full p-2 text-white/90 transition hover:bg-white/10" aria-label="নোটিফিকেশন" :aria-expanded="open.toString()">
                        {{ icon('bell', 'w-5 h-5') }}
                        <span x-show="unread > 0" x-cloak
                              class="absolute right-1 top-1 flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-accent-500 px-1 text-[10px] font-bold text-primary-900"
                              x-text="badge">{{ unread > 0 ? (unread > 9 ? '9+' : unread) : '' }}</span>
                    </button>
                    <div x-show="open" x-cloak @click.outside="open = false" x-transition
                         class="fixed left-4 right-4 top-16 z-50 mt-2 rounded-xl border border-neutral-200 bg-white shadow-lg sm:absolute sm:left-auto sm:right-0 sm:top-auto sm:z-auto sm:mt-2 sm:w-80">
                        <div class="flex items-center justify-between border-b border-neutral-100 px-4 py-3">
                            <p class="text-sm font-semibold text-neutral-800">নোটিফিকেশন</p>
                            {# Still works without JS: the plain form post lands back on /notifications. #}
                            <form method="post" action="/notifications/read-all" @submit.prevent="markAllRead()">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <button type="submit" class="tap-target text-xs font-medium text-primary-600 hover:underline disabled:cursor-default disabled:opacity-40"
                                        :disabled="unread === 0">সব পড়া হয়েছে</button>
                            </form>
                        </div>
                        <div class="max-h-80 overflow-y-auto" id="notification-dropdown-body">
                            <!-- Safety net only: the poller has usually filled the
                                 list before the bell is ever clicked. -->
                            <div x-show="loading && !loaded" class="space-y-3 p-4">
                                <template x-for="n in 3" :key="n">
                                    <div class="flex gap-3">
                                        <span class="h-9 w-9 shrink-0 animate-pulse rounded-xl bg-neutral-100"></span>
                                        <span class="flex-1 space-y-2 py-1">
                                            <span class="block h-3 w-2/3 animate-pulse rounded bg-neutral-100"></span>
                                            <span class="block h-2.5 w-full animate-pulse rounded bg-neutral-100"></span>
                                        </span>
                                    </div>
                                </template>
                            </div>

                            <!-- Failed -->
                            <div x-show="error" class="flex flex-col items-center gap-2 px-4 py-8 text-center">
                                <p class="text-sm text-danger-600" x-text="error"></p>
                                <button type="button" @click="load(true)" class="btn btn-ghost btn-sm">আবার চেষ্টা করুন</button>
                            </div>

                            <!-- Empty -->
                            <div x-show="isEmpty" class="flex flex-col items-center gap-2 px-4 py-10 text-center">
                                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                                    {{ icon('bell-off', 'w-6 h-6') }}
                                </span>
                                <p class="text-sm text-neutral-500">কোনো নোটিফিকেশন নেই।</p>
                            </div>

                            <!-- Rows -->
                            <template x-for="item in items" :key="item.id">
                                <a href="/notifications" @click.prevent="markRead(item)"
                                   class="flex gap-3 border-b border-neutral-100 px-4 py-3 transition last:border-b-0 hover:bg-neutral-50"
                                   :class="item.read_at ? 'opacity-60' : 'bg-primary-50/40'">
                                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl" :class="toneClass(item.type)">
                                        <svg class="h-4 w-4" aria-hidden="true"><use :href="iconHref(item.type)"></use></svg>
                                    </span>
                                    <span class="min-w-0 flex-1">
                                        <span class="flex items-center gap-2">
                                            <span class="truncate text-sm font-semibold text-neutral-800" x-text="item.title"></span>
                                            <span class="badge badge-primary shrink-0 bg-primary-50 text-primary-700" x-show="!item.read_at">নতুন</span>
                                        </span>
                                        <span class="mt-0.5 block text-xs leading-relaxed text-neutral-500" x-text="item.message"></span>
                                        <span class="mt-1 block text-[11px] text-neutral-400" x-text="time(item.created_at)"></span>
                                    </span>
                                </a>
                            </template>
                        </div>

                        <a href="/notifications" class="block border-t border-neutral-100 px-4 py-2.5 text-center text-xs font-semibold text-primary-600 transition hover:bg-neutral-50">
                            সব নোটিফিকেশন দেখুন
                        </a>
                    </div>
                </div>

                <!-- User menu -->
                <div x-data="{ open: false }" class="relative">
                    <button @click="open = !open" class="flex items-center gap-2 rounded-full p-1 pr-2 transition hover:bg-white/10" aria-label="ইউজার মেনু" aria-expanded="false">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-500 text-sm font-bold text-primary-900">{{ identity.username|first|upper }}</span>
                        {# The chevron is the first thing to go on narrow phones —
                           the balance chip in the topbar is more useful. #}
                        {{ icon('chevron-down', 'hidden w-4 h-4 text-white/70 sm:block') }}
                    </button>
                    <div x-show="open" x-cloak @click.outside="open = false" x-transition
                         class="absolute right-0 mt-2 w-52 rounded-xl border border-neutral-200 bg-white py-1.5 shadow-lg">
                        <div class="border-b border-neutral-100 px-4 py-2.5">
                            <p class="truncate text-sm font-semibold text-neutral-800">{{ identity.username }}</p>
                            <p class="text-xs text-neutral-500">{{ identity.phone }}</p>
                        </div>
                        <a href="/profile" class="nav-link">{{ icon('user', 'w-4 h-4') }} প্রোফাইল</a>
                        <a href="/service-history" class="nav-link">{{ icon('history', 'w-4 h-4') }} সার্ভিস হিস্ট্রি</a>
                        {% if identity.canAccessAdmin() %}
                            <a href="/admin" class="nav-link">{{ icon('shield', 'w-4 h-4') }} অ্যাডমিন প্যানেল</a>
                        {% endif %}
                        <form method="post" action="/logout" class="mt-1 border-t border-neutral-100 pt-1">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button type="submit" class="nav-link w-full text-danger-600 hover:bg-danger-50 hover:text-danger-700">
                                {{ icon('log-out', 'w-4 h-4') }} লগআউট
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="flex">
        <!-- Sidebar (desktop) -->
        <aside class="fixed inset-y-16 left-0 z-30 hidden w-64 overflow-y-auto border-r border-neutral-200 bg-white lg:block">
            {% include 'partials/sidebar.twig' %}
        </aside>

        <!-- Sidebar (mobile drawer) -->
        <div x-show="sidebarOpen" x-cloak class="fixed inset-0 z-50 lg:hidden">
            <div x-show="sidebarOpen" @click="sidebarOpen = false" x-transition.opacity class="absolute inset-0 bg-neutral-900/50"></div>
            <aside x-show="sidebarOpen" x-transition class="absolute inset-y-0 left-0 w-72 overflow-y-auto bg-white shadow-xl">
                <div class="flex items-center justify-between border-b border-neutral-100 px-4 py-3">
                    <span class="font-bold text-neutral-800">মেনু</span>
                    <button @click="sidebarOpen = false" class="tap-target rounded-lg p-1.5 text-neutral-500 hover:bg-neutral-100" aria-label="বন্ধ করুন">
                        {{ icon('x', 'w-5 h-5') }}
                    </button>
                </div>
                {% include 'partials/sidebar.twig' %}
            </aside>
        </div>

        <!-- Content -->
        <main class="min-w-0 flex-1 lg:ml-64">
            <div class="container-app py-6 sm:py-8">
                {% if flash_success is defined and flash_success %}
                    <div class="alert alert-success" role="status">
                        {{ icon('check-circle', 'w-5 h-5 shrink-0') }}
                        <span>{{ flash_success }}</span>
                        {# The way back from a bulk trash/purge, beside the message
                           that announces it — one banner, so the button cannot end
                           up on a different screen from the batch it reverses. The
                           `return_*` fields are the filter the batch ran from, so
                           Undo lands the admin back on the list they were looking
                           at rather than on an unfiltered one. #}
                        {% if flash_undo is defined and flash_undo %}
                            <form method="post" action="/admin/services" class="ml-auto shrink-0">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input type="hidden" name="do" value="bulk_undo">
                                <input type="hidden" name="return_q" value="{{ flash_undo.state.q }}">
                                <input type="hidden" name="return_category" value="{{ flash_undo.state.category }}">
                                <input type="hidden" name="return_status" value="{{ flash_undo.state.status }}">
                                <input type="hidden" name="return_trashed" value="{{ flash_undo.state.trashed }}">
                                <button type="submit" class="btn btn-sm">
                                    {{ icon('undo-2', 'w-4 h-4') }}
                                    ফিরিয়ে আনুন ({{ flash_undo.count }})
                                </button>
                            </form>
                        {% endif %}
                    </div>
                {% endif %}
                {% if flash_error is defined and flash_error %}
                    <div class="alert alert-danger" role="alert">
                        {{ icon('alert-circle', 'w-5 h-5 shrink-0') }}
                        <span>{{ flash_error }}</span>
                    </div>
                {% endif %}
                {# Signed-in pages only, and only while this account's push switch
                   is off — see the partial for why it has no dismissal. #}
                {% include 'partials/push-reminder.twig' %}
                {% block dashboard_content %}{% endblock %}
            </div>
        </main>
    </div>
</div>

{% include 'partials/whatsapp-float.twig' %}
{% endblock %}
