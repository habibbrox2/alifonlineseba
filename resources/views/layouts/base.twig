<!DOCTYPE html>
<html lang="bn" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="_csrf" content="{{ csrf }}">
    {# The VAPID *public* key, so push-subscribe.js can ask for permission from
       any page. Injected by PushViewInjection; empty when the deployment has no
       keys, which push-prompt.js reads as "never ask". #}
    <meta name="vapid-public-key" content="{{ vapidPublicKey|default('') }}">

    {# ————— SEO core ————— #}
    {% set seoUrl = siteUrl is defined and siteUrl ? siteUrl : 'http://localhost:8099' %}
    {% set seoTitle = block('title')|default('All Seba — ডিজিটাল সার্ভিস প্ল্যাটফর্ম')|trim %}
    {% set seoDesc = block('description') is defined ? block('description')|trim : 'All Seba — ইনস্ট্যান্ট ডিজিটাল সার্ভিস প্ল্যাটফর্ম।' %}
    {% set seoRobots = block('robots') is defined ? block('robots')|trim : 'index, follow' %}
    {% set seoCanonical = block('canonical_url') is defined ? block('canonical_url')|trim : seoUrl ~ currentPath %}

    <title>{{ seoTitle }}</title>
    <meta name="description" content="{{ seoDesc }}">
    <meta name="robots" content="{{ seoRobots }}">
    <link rel="canonical" href="{{ seoCanonical }}">

    {# ————— Brand icons ————— #}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    {# ————— Open Graph / Twitter ————— #}
    {# Share card. Every page inherits the site-wide cover; a page with its own
       artwork overrides the og_image block and re-emits the whole set.

       The twitter:image tags live *inside* that block rather than beside it.
       They used to read a variable set outside the block, so a child that
       overrode the OG image silently left Twitter pointing at the old
       site-wide cover — the two networks disagree about what the page is.
       Same reason width/height are declared here and not hardcoded upstream:
       crawlers lay the card out from them before the image loads, so a page
       sharing a 1200x600 variant while claiming 1200x630 shifts the preview.
       Per-service variants are 1200x600; see scripts/generate-service-og-image.py. #}
    <meta property="og:title" content="{{ seoTitle }}">
    <meta property="og:description" content="{{ seoDesc }}">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="All Seba">
    <meta property="og:url" content="{{ seoCanonical }}">
    <meta property="og:locale" content="bn_BD">
    {% block og_image %}
    <meta property="og:image" content="{{ seoUrl }}/assets/img/og-cover.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="All Seba — ইনস্ট্যান্ট ডিজিটাল সার্ভিস হাব">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seoTitle }}">
    <meta name="twitter:description" content="{{ seoDesc }}">
    <meta name="twitter:image" content="{{ seoUrl }}/assets/img/og-cover.png">
    <meta name="twitter:image:alt" content="All Seba — ইনস্ট্যান্ট ডিজিটাল সার্ভিস হাব">
    {% endblock %}

    {# ————— Structured data (site identity + WebSite) ————— #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "All Seba",
        "url": "{{ seoUrl }}/",
        "description": "ইনস্ট্যান্ট ডিজিটাল সার্ভিস প্ল্যাটফর্ম",
        "inLanguage": "bn-BD"
    }
    </script>
    {% block structured_data %}{% endblock %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('/assets/css/app.css') }}">
    <script type="module" src="{{ asset('/assets/js/app.js') }}"></script>
    {# The install banner ships in every layout, so its bootstrap cannot live
       in a page. Kept inline and tiny rather than added to app.js because
       app.js is loaded on pages that have no `data-app-install` element and
       would then carry a second entry point for no reason. #}
    <script type="module">
        import { initAppInstall } from '{{ asset('/assets/js/app-install.js') }}';
        initAppInstall();
    </script>
    {# Likewise site-wide: the browser permission prompt must not require a trip
       to /app first. #}
    <script type="module">
        import { initPushPrompt } from '{{ asset('/assets/js/push-prompt.js') }}';
        initPushPrompt();
    </script>
    {# Date fields appear only on service forms, but they are rendered by the
       shared row component rather than by a page, so there is no better place
       than here — one module, one pass over `[data-date-field]`, and no
       calendar library behind either (see resources/js/date-field.js). #}
    <script type="module">
        import { initDateFields } from '{{ asset('/assets/js/date-field.js') }}';
        initDateFields();
    </script>
    {% block page_scripts %}{% endblock %}
    {% block scripts %}{% endblock %}
</head>
<body class="flex min-h-full flex-col">
    {% block body %}{% endblock %}

    {# Outside `block body` on purpose: this ships on public pages, signed-in
       pages and the app page alike. #}
    {% include 'partials/app-install.twig' %}
    {% include 'partials/push-prompt.twig' %}

    {# Alpine boots LAST, at the very end of <body>, and that position is load-
       bearing — do not move this back into <head>.

       Alpine's cdn build ends with `queueMicrotask(() => Alpine.start())`, and
       the HTML spec runs a microtask checkpoint after *each* deferred script.
       So a deferred <script defer> in <head> does not merely finish before the
       body's deferred scripts — Alpine.start() already has. Any component whose
       x-data calls a global defined by a body-rendered script is then evaluated
       a microtask too early, and every binding inside it throws
       "ReferenceError: <fn> is not defined".

       That is not a cosmetic failure: with no data object in scope the
       expressions fall through to same-named window globals, so `x-show="open"`
       reads window.open and `@click.outside="close()"` calls window.close() —
       the browser answers "Scripts may close only the windows that were opened
       by them". See components/icon-picker.twig and the dashboard provider for
       the two that broke on this.

       Deferred scripts run in document order, and everything that can define
       such a provider now sits above this tag, so all of them have executed by
       the time start() walks the DOM. `defer` is still needed for this tag: it
       keeps Alpine out of the parser's way until the document is complete, and
       Alpine tolerates being started on an already-parsed document. #}
    <script defer src="/assets/js/alpine.min.js"></script>
</body>
</html>
