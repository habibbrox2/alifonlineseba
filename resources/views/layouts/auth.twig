{% extends 'layouts/base.twig' %}

{% block body %}
<div class="flex min-h-screen flex-col bg-gradient-to-br from-primary-900 via-primary-800 to-primary-600">
    <header class="flex items-center justify-between px-4 py-4 sm:px-8">
        {# Full horizontal lockup instead of the bare mark + text: the wordmark
           is drawn type, so it stays crisp at any DPI and the login screen
           reads as the same brand as the app icon. The light variant is
           required here — the default lockup is near-black green and vanishes
           on this gradient. #}
        <a href="/" class="flex items-center" aria-label="Alif Tools — হোম">
            <img src="/assets/brand/logo-horizontal-light.svg" alt="Alif Tools"
                 class="h-11 w-auto" width="165" height="44">
        </a>
        {% if site.telegram_url|default('') %}
            <a href="{{ site.telegram_url }}" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 rounded-full border border-white/25 px-3.5 py-2 text-[13px] font-medium text-white/90 transition hover:bg-white/10 sm:px-4 sm:text-sm">
                {{ icon('send', 'w-4 h-4 shrink-0') }} টেলিগ্রাম চ্যানেল
            </a>
        {% endif %}
    </header>

    <main class="flex flex-1 items-center justify-center px-4 py-8 sm:px-6">
        <div class="w-full max-w-md">
            {% block auth_content %}{% endblock %}
        </div>
    </main>

    <footer class="px-4 py-6 text-center text-xs text-white/50 sm:px-8">
        &copy; {{ 'now'|date('Y') }} Alif Group (Demo). সকল ডাটা কাল্পনিক।
    </footer>
</div>

{% include 'partials/whatsapp-float.twig' %}
{% endblock %}
