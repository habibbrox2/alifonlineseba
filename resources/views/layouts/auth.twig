{% extends 'layouts/base.twig' %}

{% block body %}
<div class="flex min-h-screen flex-col bg-gradient-to-br from-primary-900 via-primary-800 to-primary-600">
    <header class="flex items-center justify-between px-4 py-4 sm:px-8">
        {# Exactly the lockup the public and dashboard headers use — the green
           mark plus the "All Seba" wordmark in HTML text. This page used to
           show logo-horizontal-light.svg instead: a different-looking
           white-tile mark whose wordmark still read "Digital Sheba" (the old
           brand), so the login screen looked like it belonged to another
           site. HTML text is also what keeps the wordmark crisp at any DPI
           without shipping a font. #}
        <a href="/" class="flex items-center gap-2.5 font-bold text-white tap-target" aria-label="All Seba — হোম">
            <img src="/assets/brand/logo-mark.svg" alt="" class="h-9 w-9" width="36" height="36">
            <span class="text-lg tracking-tight">All Seba</span>
        </a>
        {% if site.telegram_url|default('') %}
            <a href="{{ site.telegram_url }}" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 rounded-full border border-white/25 px-3.5 py-2 text-[13px] font-medium text-white/90 transition hover:bg-white/10 sm:px-4 sm:text-sm">
                {{ icon('send', 'w-4 h-4 shrink-0') }} টেলিগ্রাম চ্যানেল
            </a>
        {% endif %}
    </header>

    <main class="flex flex-1 items-center justify-center px-4 py-8 sm:px-6">
        <div class="w-full max-w-md">
            {# The signed-out pages are the ones that most need to say what
               just happened: the recovery flow answers with a redirect and a
               one-shot flash, so without this banner the visitor is bounced to
               the next screen and told nothing at all. Same classes as the
               dashboard layout, so a message looks identical wherever it lands. #}
            {% if flash_success is defined and flash_success %}
                <div class="alert alert-success" role="status">
                    {{ icon('check-circle', 'w-5 h-5 shrink-0') }}
                    <span>{{ flash_success }}</span>
                </div>
            {% endif %}
            {% if flash_error is defined and flash_error %}
                <div class="alert alert-danger" role="alert">
                    {{ icon('alert-circle', 'w-5 h-5 shrink-0') }}
                    <span>{{ flash_error }}</span>
                </div>
            {% endif %}
            {% block auth_content %}{% endblock %}
        </div>
    </main>

    <footer class="px-4 py-6 text-center text-xs text-white/50 sm:px-8">
        &copy; {{ 'now'|date('Y') }} Alif Group. সর্বস্বত্ব সংরক্ষিত।
        {% if site.footer_updated_at %}
            <p class="mt-1 text-white/30">সর্বশেষ হালনাগাদ: {{ site.footer_updated_at }}</p>
        {% endif %}
    </footer>
</div>

{% include 'partials/firebase-auth-head.twig' %}
{% include 'partials/whatsapp-float.twig' %}
{% endblock %}
