{% extends 'layouts/base.twig' %}

{% block body %}
<header class="sticky top-0 z-40 bg-gradient-to-r from-primary-900 via-primary-800 to-primary-700 shadow-md">
    <div class="container-app flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 font-bold text-white tap-target">
            <img src="/assets/brand/logo-mark.svg" alt="" class="h-9 w-9" width="36" height="36">
            <span class="text-lg tracking-tight">All Seba</span>
        </a>
        <nav class="hidden items-center gap-6 text-sm font-medium text-white/85 md:flex">
            <a href="/" class="transition hover:text-accent-400">হোম</a>
            <a href="/about" class="transition hover:text-accent-400">আমাদের সম্পর্কে</a>
            <a href="/app" class="transition hover:text-accent-400">অ্যাপ ডাউনলোড</a>
            <a href="/login" class="transition hover:text-accent-400">লগইন</a>
        </nav>
        {# `relative` anchors the dropdown below: without it the absolutely
           positioned panel resolves against the page and can open off the
           right edge of a narrow phone screen. #}
        <div class="relative flex items-center gap-3 md:hidden" x-data="{ open: false }" @keydown.escape.window="open = false">
            <button @click="open = !open" class="btn btn-ghost-dark btn-sm" aria-label="মেনু" :aria-expanded="open.toString()">
                <span x-show="!open">{{ icon('menu', 'w-5 h-5') }}</span>
                <span x-show="open" x-cloak>{{ icon('x', 'w-5 h-5') }}</span>
            </button>
            <div x-show="open" x-cloak @click.outside="open = false" x-transition
                 class="absolute right-0 top-14 w-48 rounded-xl border border-neutral-200 bg-white p-2 shadow-lg">
                <a href="/" class="nav-link">হোম</a>
                <a href="/about" class="nav-link">আমাদের সম্পর্কে</a>
                <a href="/app" class="nav-link">অ্যাপ ডাউনলোড</a>
                <a href="/login" class="nav-link">লগইন</a>
                <a href="/register" class="nav-link">নিবন্ধন</a>
            </div>
        </div>
    </div>
</header>

<main class="flex-1">
    {% block content %}{% endblock %}
</main>

<footer class="bg-primary-900 py-8 text-center text-sm text-white/70">
    <div class="container-app">
        {% set siteTagline = site.site_tagline|default('ইনস্ট্যান্ট ডিজিটাল সার্ভিস প্ল্যাটফর্ম') %}
        {% set socialLinks = [
            site.facebook_url ? { href: site.facebook_url, icon: 'facebook', label: 'ফেসবুক', aria: 'Facebook' },
            site.youtube_url ? { href: site.youtube_url, icon: 'youtube', label: 'ইউটিউব', aria: 'YouTube' },
            site.whatsapp_url ? { href: site.whatsapp_url, icon: 'message-circle', label: 'হোয়াটসঅ্যাপ', aria: 'WhatsApp' },
            site.telegram_url ? { href: site.telegram_url, icon: 'send', label: 'টেলিগ্রাম', aria: 'Telegram' },
        ]|filter(s => s) %}
        {% set contactLinks = [
            site.contact_email ? { href: 'mailto:' ~ site.contact_email, label: site.contact_email, icon: 'send' },
            site.contact_phone ? { href: 'tel:' ~ site.contact_phone, label: site.contact_phone, icon: 'smartphone' },
        ]|filter(c => c) %}

        <p class="text-base font-bold text-white">All Seba</p>
        <p class="mt-1 text-xs text-white/60">{{ siteTagline }}</p>

        {% if socialLinks|length or contactLinks|length %}
            <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                {% for s in socialLinks %}
                    <a href="{{ s.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.aria }}"
                       class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/80 transition hover:bg-accent-500 hover:text-primary-900">
                        {{ icon(s.icon, 'w-4 h-4') }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}

        <nav class="mt-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
            <a href="/about" class="tap-target transition hover:text-accent-400">আমাদের সম্পর্কে</a>
            <a href="/privacy" class="tap-target transition hover:text-accent-400">গোপনীয়তা নীতি</a>
            <a href="/terms" class="tap-target transition hover:text-accent-400">শর্তাবলী</a>
            <a href="/app" class="tap-target transition hover:text-accent-400">অ্যাপ ডাউনলোড</a>
            {% for c in contactLinks %}
                <a href="{{ c.href }}" class="tap-target inline-flex items-center gap-1.5 transition hover:text-accent-400">
                    {{ icon(c.icon, 'w-3.5 h-3.5') }} {{ c.label }}
                </a>
            {% endfor %}
        </nav>

        {% if site.footer_note %}
            <p class="mt-3 text-xs text-white/40">{{ site.footer_note }}</p>
        {% endif %}
        {% if site.footer_updated_at %}
            <p class="mt-2 text-xs text-white/30">সর্বশেষ হালনাগাদ: {{ site.footer_updated_at }}</p>
        {% endif %}
    </div>
</footer>

{% include 'partials/whatsapp-float.twig' %}
{% endblock %}
