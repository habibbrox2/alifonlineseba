{# Reusable service card #}
{# @var service array with name, slug, description, icon, badge, price, accent #}
{# @var variant 'catalog' (default) is the bordered card with its price footer
   for the category listing; 'board' is the homepage shelf cell — the whole
   row is the link and no price is drawn, because the home page sells the
   click while the catalog is the place that quotes a number. #}
{# The `accent-*` class re-points --accent and friends (see app.css); everything
   coloured below reads those variables, so the card is tinted by its category. #}
{% if variant|default('catalog') == 'board' %}
<a href="/services/view/{{ service.slug }}"
   class="group flex items-center gap-4 bg-white p-5 transition-colors duration-200 hover:bg-[var(--accent-soft)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500 accent-{{ service.accent ?? 'emerald' }}">
    <span class="shrink-0" style="color: var(--accent)">
        {{ icon(service.icon ?? 'zap', 'h-6 w-6') }}
    </span>
    <span class="min-w-0 flex-1">
        <span class="flex items-center gap-2">
            <span class="text-[15px] font-bold leading-snug text-neutral-800">{{ service.name }}</span>
            {% if service.badge %}
                <span class="badge shrink-0" style="background-color: var(--accent-soft); color: var(--accent-ink);">{{ service.badge }}</span>
            {% endif %}
        </span>
        {% if service.description %}
            <span class="mt-0.5 block truncate text-sm text-neutral-500">{{ service.description }}</span>
        {% endif %}
    </span>
    <svg class="h-4 w-4 shrink-0 text-neutral-300 transition-all duration-200 group-hover:translate-x-1 group-hover:text-[color:var(--accent)]" aria-hidden="true"><use href="/assets/icons/lucide-sprite.svg#arrow-right"></use></svg>
</a>
{% else %}
<article class="card card-hover card-accent flex flex-col p-5 accent-{{ service.accent ?? 'emerald' }}">
    <div class="mb-3 flex items-start justify-between gap-2">
        <span class="accent-tile h-11 w-11">
            {{ icon(service.icon ?? 'zap', 'w-6 h-6') }}
        </span>
        {% if service.badge %}
            <span class="badge" style="background-color: var(--accent-soft); color: var(--accent-ink);">{{ service.badge }}</span>
        {% endif %}
    </div>

    <h3 class="text-base font-bold leading-snug text-neutral-800">{{ service.name }}</h3>
    <p class="mt-1.5 line-clamp-2 flex-1 text-sm leading-relaxed text-neutral-500">{{ service.description }}</p>

    <div class="mt-4 flex items-center justify-between border-t border-neutral-100 pt-4">
        <span class="accent-value text-lg">{{ service.price|money }}</span>
        <a href="/services/view/{{ service.slug }}" class="btn btn-accent-solid btn-sm">
            অর্ডার করুন
            <svg class="h-4 w-4" aria-hidden="true"><use href="/assets/icons/lucide-sprite.svg#arrow-right"></use></svg>
        </a>
    </div>
</article>
{% endif %}
