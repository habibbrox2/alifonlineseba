{% extends 'layouts/public.twig' %}

{% block title %}শর্তাবলী — TH Tools{% endblock %}
{% block description %}TH Tools ব্যবহারের শর্তাবলী — ডেমো সেবার প্রকৃতি, অ্যাকাউন্ট নিয়ম ও দায়বদ্ধতা।{% endblock %}

{% block content %}
<section class="container-app py-12">
    <div class="mx-auto max-w-3xl">
        <h1 class="text-3xl font-extrabold text-neutral-900">ব্যবহারের শর্তাবলী</h1>
        <div class="card mt-6 p-6 leading-relaxed text-neutral-600 sm:p-8">
            <h2 class="text-lg font-bold text-neutral-900">১. সেবার প্রকৃতি</h2>
            <p class="mt-2">
                TH Tools একটি ডেমো প্ল্যাটফর্ম। সকল সার্ভিস মক — কোনো বাস্তব ফলাফল বা সরকারি ডাটা
                প্রদান করা হয় না। প্রতিটি ফলাফলে "ডেমো" চিহ্নিত করা থাকে।
            </p>
            <h2 class="mt-6 text-lg font-bold text-neutral-900">২. অ্যাকাউন্ট</h2>
            <p class="mt-2">
                সঠিক তথ্য দিয়ে ডেমো অ্যাকাউন্ট খুলুন — বাস্তব পরিচয় তথ্য দেওয়ার প্রয়োজন নেই।
                অ্যাকাউন্ট নিষ্ক্রিয় করার সিদ্ধান্ত অ্যাডমিনের।
            </p>
            <h2 class="mt-6 text-lg font-bold text-neutral-900">৩. দায়বদ্ধতা</h2>
            <p class="mt-2">
                ডেমো সিস্টেম হিসেবে সেবা "যেমন আছে তেমন" প্রদান করা হয়। কোনো আসল আর্থিক লেনদেন
                সম্পাদিত হয় না এবং রিফান্ড প্রযোজ্য নয়।
            </p>
        </div>
    </div>
</section>
{% endblock %}
