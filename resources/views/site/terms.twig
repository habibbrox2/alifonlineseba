{% extends 'layouts/public.twig' %}

{% block title %}শর্তাবলী — All Seba{% endblock %}
{% block description %}All Seba ব্যবহারের শর্তাবলী — সেবার প্রকৃতি, অ্যাকাউন্ট নিয়ম ও দায়বদ্ধতা।{% endblock %}

{% block content %}
<section class="container-app py-12">
    <div class="mx-auto max-w-3xl">
        <h1 class="text-3xl font-extrabold text-neutral-900">ব্যবহারের শর্তাবলী</h1>
        <div class="card mt-6 p-6 leading-relaxed text-neutral-600 sm:p-8">
            <h2 class="text-lg font-bold text-neutral-900">১. সেবার প্রকৃতি</h2>
            <p class="mt-2">
                All Seba একটি ডিজিটাল সার্ভিস প্ল্যাটফর্ম। প্রতিটি সার্ভিস একটি নির্দিষ্ট প্রোভাইডারের
                মাধ্যমে সম্পাদিত হয় এবং ফলাফলে প্রদানকারী সংস্থার পরিচয় ও প্রকৃতি উল্লেখ থাকে।
                কোনো সার্ভিস কোনো সরকারি সংস্থার সরাসরি সনদ নয়।
            </p>
            <h2 class="mt-6 text-lg font-bold text-neutral-900">২. অ্যাকাউন্ট</h2>
            <p class="mt-2">
                সঠিক তথ্য দিয়ে অ্যাকাউন্ট খুলুন — শুধুমাত্র প্রয়োজনীয় যোগাযোগের তথ্য দিন।
                অ্যাকাউন্ট নিষ্ক্রিয় করার সিদ্ধান্ত অ্যাডমিনের।
            </p>
            <h2 class="mt-6 text-lg font-bold text-neutral-900">৩. দায়বদ্ধতা</h2>
            <p class="mt-2">
                সেবা "যেমন আছে তেমন" ভিত্তিতে প্রদান করা হয়। ব্যালেন্স জমা ও খরচের ক্ষেত্রে
                প্রযোজ্য নীতিমালা ও অ্যাকাউন্ট ব্যবহারের শর্ত অনুসরণ করা হয়।
            </p>
        </div>
    </div>
</section>
{% endblock %}
