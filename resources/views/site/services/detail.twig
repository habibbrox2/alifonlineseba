{% extends 'layouts/dashboard.twig' %}

{% block title %}{{ service.name }} — TH Tools{% endblock %}

{% block dashboard_content %}
<nav class="mb-5 flex flex-wrap items-center gap-2 text-sm text-neutral-500" aria-label="ব্রেডকাম্ব">
    <a href="/dashboard" class="hover:text-primary-600">ড্যাশবোর্ড</a>
    <svg class="h-4 w-4" aria-hidden="true"><use href="/assets/icons/lucide-sprite.svg#chevron-right"></use></svg>
    <a href="/services/category/{{ category.slug }}" class="hover:text-primary-600">{{ category.name }}</a>
    <svg class="h-4 w-4" aria-hidden="true"><use href="/assets/icons/lucide-sprite.svg#chevron-right"></use></svg>
    <span class="font-medium text-neutral-700">{{ service.name }}</span>
</nav>

<div class="grid gap-6 lg:grid-cols-3">
    <!-- Main column -->
    <div class="space-y-6 lg:col-span-2">
        <!-- Service header -->
        <header class="card p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="flex items-center gap-4">
                    <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-50 text-primary-600">
                        {{ icon(service.icon ?? 'zap', 'w-7 h-7') }}
                    </span>
                    <div>
                        <h1 class="text-xl font-extrabold text-neutral-900">{{ service.name }}</h1>
                        {% if service.badge %}
                            <span class="badge badge-info mt-1.5">{{ service.badge }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-xs text-neutral-400">মূল্য</p>
                    <p class="text-2xl font-extrabold text-primary-700">{{ service.price|money }}</p>
                </div>
            </div>
            {% if service.description %}
                <p class="mt-4 text-sm leading-relaxed text-neutral-500">{{ service.description }}</p>
            {% endif %}
        </header>

        <!-- Result -->
        {% if result %}
            <section class="card p-6 {{ result.success ? 'border-success-200' : 'border-danger-200' }}" x-data="{ copied: false }">
                <div class="mb-4 flex items-center gap-2.5">
                    {% if result.success %}
                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-success-50 text-success-600">{{ icon('check-circle', 'w-5 h-5') }}</span>
                        <h2 class="font-bold text-success-700">ফলাফল প্রস্তুত</h2>
                    {% else %}
                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-danger-50 text-danger-600">{{ icon('alert-circle', 'w-5 h-5') }}</span>
                        <h2 class="font-bold text-danger-700">সম্পন্ন হয়নি</h2>
                    {% endif %}
                </div>

                {% if result.success %}
                    <div class="mb-4 rounded-xl bg-warning-50 px-4 py-3 text-xs font-medium text-warning-700">
                        ⚠️ {{ result.data._notice ?? 'এটি ডেমো ডাটা — সম্পূর্ণ কাল্পনিক' }}
                    </div>
                    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
                        {% for key, value in result.data %}
                            {% if key not in ['_demo', '_notice'] %}
                                <div class="rounded-lg bg-neutral-50 px-4 py-2.5">
                                    <dt class="text-[11px] font-semibold uppercase tracking-wide text-neutral-400">{{ key|replace({'_': ' '}) }}</dt>
                                    <dd class="mt-0.5 break-words text-sm font-medium text-neutral-800" x-show="!copied">{{ value }}</dd>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </dl>
                    {% if result.data._reference %}
                        <p class="mt-4 text-xs text-neutral-400">রেফারেন্স: <code class="rounded bg-neutral-100 px-1.5 py-0.5">{{ result.data._reference }}</code></p>
                    {% endif %}
                {% else %}
                    <p class="text-sm text-neutral-600">{{ result.message }}</p>
                {% endif %}
            </section>
        {% endif %}

        <!-- Form -->
        <section class="card p-6" x-data="{ submitting: false }">
            <h2 class="mb-5 text-lg font-bold text-neutral-900">ফর্ম পূরণ করুন</h2>

            {% if errors %}
                <div class="alert alert-danger" role="alert">
                    {{ icon('alert-circle', 'w-5 h-5 shrink-0') }}
                    <span>কিছু তথ্য সঠিক নয় — নিচে দেখুন।</span>
                </div>
            {% endif %}

            <form method="post" action="/services/view/{{ service.slug }}" @submit="submitting = true" class="space-y-4">
                <input type="hidden" name="_csrf" value="{{ csrf }}">

                {% for field in fields %}
                    {% include 'components/form-row.twig' with {
                        field: {
                            name: field.name,
                            label: field.label,
                            type: field.type,
                            required: field.required,
                            placeholder: field.placeholder,
                            help: field.help,
                            error: errors[field.name] ?? null,
                        }
                    } %}
                {% endfor %}

                <button type="submit" class="btn btn-primary btn-block" :disabled="submitting">
                    <svg x-show="submitting" class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                    <span x-show="!submitting">{{ icon('zap', 'w-4 h-4') }} সাবমিট করুন</span>
                    <span x-cloak x-show="submitting">প্রসেসিং…</span>
                </button>
            </form>
        </section>
    </div>

    <!-- Side column -->
    <aside class="space-y-6">
        <!-- Requirements -->
        <section class="card p-6">
            <h2 class="mb-3 flex items-center gap-2 text-base font-bold text-neutral-900">
                {{ icon('clipboard-check', 'w-5 h-5 text-primary-600') }} প্রয়োজনীয় তথ্য
            </h2>
            <ul class="space-y-2.5">
                {% for requirement in requirements %}
                    <li class="flex items-start gap-2.5 text-sm text-neutral-600">
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-success-600" aria-hidden="true"><use href="/assets/icons/lucide-sprite.svg#check"></use></svg>
                        {{ requirement }}
                    </li>
                {% endfor %}
            </ul>
        </section>

        <!-- Balance -->
        <section class="card bg-gradient-to-br from-primary-800 to-primary-600 p-6 text-white">
            <p class="text-xs font-semibold uppercase tracking-wide text-white/70">বর্তমান ব্যালেন্স</p>
            <p class="mt-1 text-3xl font-extrabold">{{ identity.balance|money }}</p>
            <a href="/profile" class="btn btn-ghost-dark btn-sm mt-4">{{ icon('wallet', 'w-4 h-4') }} রিচার্জ করুন (ডেমো)</a>
        </section>

        <!-- Recent history -->
        <section class="card p-6">
            <h2 class="mb-3 flex items-center gap-2 text-base font-bold text-neutral-900">
                {{ icon('history', 'w-5 h-5 text-primary-600') }} সাম্প্রতিক অর্ডার
            </h2>
            {% if history is empty %}
                <p class="py-4 text-center text-sm text-neutral-400">এখনো কোনো অর্ডার নেই।</p>
            {% else %}
                <ul class="divide-y divide-neutral-100">
                    {% for tx in history %}
                        <li class="flex items-center justify-between gap-3 py-2.5">
                            <div class="min-w-0">
                                <p class="truncate text-sm font-medium text-neutral-700">{{ tx.service_name ?? 'সার্ভিস' }}</p>
                                <p class="text-xs text-neutral-400">{{ tx.created_at|bndate }}</p>
                            </div>
                            {% include 'components/status-badge.twig' with { status: tx.status } %}
                        </li>
                    {% endfor %}
                </ul>
                <a href="/service-history" class="mt-3 block text-center text-xs font-medium text-primary-600 hover:underline">সব দেখুন →</a>
            {% endif %}
        </section>
    </aside>
</div>
{% endblock %}
