{% extends 'layouts/base.twig' %}

{% block title %}{{ heading }} — TH Tools{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center bg-surface-100 px-4">
    <div class="w-full max-w-md text-center">
        <p class="text-7xl font-extrabold text-primary-600">{{ code }}</p>
        <h1 class="mt-3 text-2xl font-extrabold text-neutral-900">{{ heading }}</h1>
        <p class="mt-2 text-sm leading-relaxed text-neutral-500">{{ message }}</p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
            <a href="/" class="btn btn-primary">{{ icon('home', 'w-4 h-4') }} হোমে যান</a>
            <a href="javascript:history.back()" class="btn btn-ghost">{{ icon('arrow-left', 'w-4 h-4') }} পেছনে যান</a>
        </div>
    </div>
</div>
{% endblock %}
