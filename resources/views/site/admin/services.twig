{% extends 'layouts/dashboard.twig' %}

{% block title %}সার্ভিস ম্যানেজমেন্ট — Admin{% endblock %}

{# Scoped to this page on purpose. app.css owns the bottom slot and says so:
   the push prompt (z-index 61) and the install banner never stack, whichever is
   visible wins. The bulk bar is a third bottom-fixed thing, and it lost that
   contest — a real click landed on the prompt instead of প্রয়োগ করুন, because
   the bar's buttons sit inside the prompt's 60px band. So while the admin is
   composing a bulk action the bar takes the slot and the prompt steps aside,
   exactly the way .app-install already steps aside for the prompt. Alpine adds
   and removes `services-bulk-active` alongside `count`, so dismissing the
   selection hands the space straight back. #}
{% block page_scripts %}
<style>
    body.services-bulk-active .push-prompt {
        display: none;
    }
</style>
{# Deferred, and ahead of Alpine at the end of <body> — the same ordering
   icon-picker relies on. See the comment on Alpine's tag in base.twig. #}
<script defer src="{{ asset('/assets/js/field-sorter.js') }}"></script>
{% endblock %}

{% block dashboard_content %}
{% set isEdit = editService is defined and editService %}
{# Rejected submissions come back as formValues so the admin does not retype them. #}
{% set fv = formValues|default({}) %}
{% set fvName = fv.name|default(editService.name|default('')) %}
{% set fvSlug = fv.slug|default('') %}
{% set fvCategory = fv.category_id|default(editService.category_id|default('')) %}
{% set fvPrice = fv.price|default(editService.price|default('0')) %}
{% set fvIcon = fv.icon|default(editService.icon|default('zap')) %}
{% set fvBadge = fv.badge|default(editService.badge|default('')) %}
{% set fvDescription = fv.description|default(editService.description|default('')) %}
{% set fvRules = fv.rules|default(editService.rules|default('')) %}
{% set fvVariants = fv.variants|default([]) %}
{% set fvStatus = fv.status|default(editService.status|default('active')) %}
{% set fvSortOrder = fv.sort_order|default(editService.sort_order|default(0)) %}
{# Labels for ServiceBulkAction::ACTIONS, which the bar is drawn from so the two
   cannot drift. An action with no label here still renders — as its raw name,
   which is ugly and impossible to miss in review, not invisible in production. #}
{% set bulkActionLabels = {
    activate: 'সক্রিয় করুন',
    deactivate: 'নিষ্ক্রিয় করুন',
    trash: 'ট্র্যাশে পাঠান',
    restore: 'রিস্টোর করুন',
    purge: 'স্থায়ীভাবে মুছুন',
} %}

{% include 'components/page-header.twig' with {
    title: 'সার্ভিস ম্যানেজমেন্ট',
    description: (filterSet|default(false) ? 'এই ফিল্টারে ' : 'মোট ') ~ filterTotal|default(0) ~ ' টি সার্ভিস — নতুন যোগ করুন, ফিল্ড ও ভ্যারিয়েন্ট কনফিগার করুন, পুরোনো সার্ভিস নিষ্ক্রিয় করুন',
} %}

{# ---- Filter bar ----
   One GET form rather than a row of chip links, because four dimensions of
   filter multiply into fifteen links and each one would have to carry the other
   three. A form cannot drop the state the admin just set, and it works with
   JavaScript off — which matters here, since the bulk bar degrades to "submit
   whatever is ticked" without Alpine and the filter must still hold.

   `trashed` defaults to "exclude" upstream, so this select shows live services
   unless the admin asks otherwise; that default is also what makes the bar's
   "everything matching" button switch itself off, since an empty filter over
   `purge` would mean the whole shop. #}
<form method="get" action="/admin/services" class="card mb-4 flex flex-wrap items-end gap-3 px-4 py-3">
    <div class="min-w-0 flex-1">
        <label for="services-filter-q" class="form-label">খুঁজুন</label>
        <input id="services-filter-q" type="text" name="q" value="{{ filterState.q }}" class="form-input"
               placeholder="সার্ভিসের নাম বা স্লাগ">
    </div>
    <div>
        <label for="services-filter-category" class="form-label">ক্যাটাগরি</label>
        <select id="services-filter-category" name="category" class="form-input">
            <option value="">সব ক্যাটাগরি</option>
            {% for category in categories %}
                <option value="{{ category.id }}" {{ filterState.category == category.id ? 'selected' }}>{{ category.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label for="services-filter-status" class="form-label">স্ট্যাটাস</label>
        <select id="services-filter-status" name="status" class="form-input">
            <option value="">সব</option>
            <option value="active" {{ filterState.status == 'active' ? 'selected' }}>সক্রিয়</option>
            <option value="inactive" {{ filterState.status == 'inactive' ? 'selected' }}>নিষ্ক্রিয়</option>
        </select>
    </div>
    <div>
        <label for="services-filter-trashed" class="form-label">ট্র্যাশ</label>
        <select id="services-filter-trashed" name="trashed" class="form-input">
            <option value="exclude" {{ filterState.trashed == 'exclude' ? 'selected' }}>সক্রিয় সার্ভিস</option>
            <option value="only" {{ filterState.trashed == 'only' ? 'selected' }}>শুধু ট্র্যাশ</option>
            <option value="all" {{ filterState.trashed == 'all' ? 'selected' }}>সবাই দেখুন</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">{{ icon('search', 'w-4 h-4') }} ফিল্টার</button>
    {% if filterSet %}
        <a href="/admin/services" class="btn btn-ghost btn-sm">{{ icon('x', 'w-4 h-4') }} ফিল্টার মুছুন</a>
    {% endif %}
</form>

<div class="grid gap-6 lg:grid-cols-3">
    <!-- Create / Edit form -->
    <section class="card h-fit p-6">
        <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-neutral-900">
            {{ icon(isEdit ? 'file-text' : 'plus', 'w-5 h-5 text-primary-600') }}
            {{ isEdit ? 'সার্ভিস এডিট করুন' : 'নতুন সার্ভিস' }}
        </h2>
        {% if isEdit %}
            <p class="mb-3 rounded-lg bg-info-50 px-3 py-2 text-xs text-info-700">
                এডিট করা হচ্ছে: <strong>{{ editService.name }}</strong>
                ({{ editService.slug }}) —
                <a href="/admin/services" class="font-semibold underline">বাতিল</a>
            </p>
        {% endif %}
        <form method="post" action="/admin/services" class="space-y-4">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="do" value="{{ isEdit ? 'update' : 'create' }}">
            {% if isEdit %}<input type="hidden" name="id" value="{{ editService.id }}">{% endif %}
            <div>
                <label for="name" class="form-label">নাম <span class="text-danger-600">*</span></label>
                <input id="name" type="text" name="name" class="form-input" required maxlength="190" value="{{ fvName }}">
            </div>
            {% if not isEdit %}
                <div>
                    <label for="slug" class="form-label">স্লাগ (ঐচ্ছিক)</label>
                    <input id="slug" type="text" name="slug" class="form-input" maxlength="190" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="নাম থেকে অটো তৈরি হবে" value="{{ fvSlug }}">
                    <p class="form-help">শুধু ছোট ইংরেজি অক্ষর, সংখ্যা ও হাইফেন (-) — ডুপ্লিকেট স্লাগ সংরক্ষণ করা হবে না।</p>
                </div>
            {% endif %}
            <div>
                <label for="category_id" class="form-label">ক্যাটাগরি <span class="text-danger-600">*</span></label>
                <select id="category_id" name="category_id" class="form-input" required>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if fvCategory == category.id %}selected{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="price" class="form-label">মূল্য (৳)</label>
                <input id="price" type="number" step="0.01" min="0" name="price" class="form-input" value="{{ fvPrice }}">
                <p class="form-help">শূন্য বা তার বেশি — ঋণাত্মক মূল্য দেওয়া যাবে না।</p>
            </div>
            {# Browse all 1636 Lucide icons instead of typing a name from memory. #}
            {% include 'components/icon-picker.twig' with {
                name: 'icon',
                id: 'icon',
                value: fvIcon,
                label: 'আইকন (Lucide)',
                help: 'আইকন খুঁজে বেছে নিন, অথবা নামটি নিজে লিখুন (যেমন: zap, gift, smartphone)'
            } %}
            <div>
                <label for="badge" class="form-label">ব্যাজ</label>
                <input id="badge" type="text" name="badge" class="form-input" placeholder="যেমন: ইনস্ট্যান্ট ডেলিভারি" value="{{ fvBadge }}">
            </div>
            <div>
                <label for="description" class="form-label">বর্ণনা</label>
                <textarea id="description" name="description" rows="2" class="form-input">{{ fvDescription }}</textarea>
            </div>
            <div>
                <label for="rules" class="form-label">অর্ডারের নিয়মাবলি (প্রতি লাইন একটি নিয়ম)</label>
                <textarea id="rules" name="rules" rows="3" class="form-input" placeholder="যেমন: সঠিক নম্বর দিন — ভুল হলে টাকা ফেরতযোগ্য নয়">{{ fvRules }}</textarea>
                <p class="form-help">অর্ডার পেজে "নিয়মাবলি" কার্ড হিসেবে দেখানো হবে — প্রতিটি নতুন লাইন আলাদা বুলেট।</p>
            </div>
            {% set fvVariantsJson = fvVariants|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT')) %}
            <div x-data='{ rows: {{ fvVariantsJson }} }'>
                <label class="form-label">ভ্যারিয়েন্ট (ঐচ্ছিক)</label>
                <p class="form-help mb-2">ভিন্ন মূল্যের অপশন — যেমন "অরিজিনাল কপি" বনাম "স্মার্ট কার্ড কপি"। লেবেল ফাঁকা রাখলে সেই সারি বাদ যাবে; সব ফাঁকা হলে ভ্যারিয়েন্ট সিলেক্টর দেখাবে না।</p>
                <div class="space-y-2">
                    <template x-for="(row, index) in rows" :key="index">
                        <div class="flex items-center gap-2">
                            <input type="text" name="variant_label[]" class="form-input" placeholder="ভ্যারিয়েন্ট লেবেল (যেমন: স্মার্ট কার্ড কপি)" x-model="row.label" maxlength="120">
                            <input type="number" step="0.01" min="0" name="variant_price[]" class="form-input w-32" placeholder="মূল্য" x-model="row.price">
                            <button type="button" class="btn btn-ghost btn-sm text-danger-600" @click="rows.splice(index, 1)" aria-label="সারি মুছুন">
                                {{ icon('trash-2', 'w-4 h-4') }}
                            </button>
                        </div>
                    </template>
                </div>
                <button type="button" class="btn btn-ghost btn-sm mt-2" @click="rows.push({ label: '', price: '' })">
                    {{ icon('plus', 'w-4 h-4') }} ভ্যারিয়েন্ট যোগ করুন
                </button>
            </div>
            {% if isEdit %}
                <div>
                    <label for="status" class="form-label">স্ট্যাটাস</label>
                    <select id="status" name="status" class="form-input">
                        <option value="active" {% if fvStatus == 'active' %}selected{% endif %}>সক্রিয়</option>
                        <option value="inactive" {% if fvStatus == 'inactive' %}selected{% endif %}>নিষ্ক্রিয়</option>
                    </select>
                </div>
                <div>
                    <label for="sort_order" class="form-label">সর্ট অর্ডার</label>
                    <input id="sort_order" type="number" min="0" name="sort_order" class="form-input" value="{{ fvSortOrder }}">
                </div>
            {% endif %}
            <button type="submit" class="btn btn-primary btn-block">
                {{ icon('save', 'w-4 h-4') }} {{ isEdit ? 'আপডেট করুন' : 'তৈরি করুন' }}
            </button>
        </form>

        {# Form field configuration: which inputs the end-user sees (NID, জন্মতারিখ, …) #}
        {% if isEdit %}
            <div class="card mt-6 p-6">
                <h2 class="mb-1 flex items-center gap-2 text-lg font-bold text-neutral-900">
                    {{ icon('settings', 'w-5 h-5 text-primary-600') }} ফর্ম ফিল্ড কনফিগারেশন
                </h2>
                <p class="mb-4 text-xs text-neutral-500">
                    ইউজার ফর্মে কোন ফিল্ড দেখাবে, কোনগুলো আবশ্যক, এবং চাইলে নিজে নতুন ফিল্ড যোগ বা বাতিল করুন।
                </p>
                <p class="mb-4 rounded-lg bg-neutral-50 px-3 py-2 text-[11px] text-neutral-500">
                    টিক তুলে বন্ধ করলে ফিল্ডটি ইউজার ফর্মে আর দেখাবে না, কিন্তু সেটিং মুছে যাবে না — পরে আবার চালু করা যাবে। স্থায়ীভাবে মুছতে নিচের
                    <strong>এই কাস্টম ফিল্ডটি স্থায়ীভাবে মুছে ফেলুন</strong> ব্যবহার করুন।
                </p>
                {% if not usingFieldDefaults|default(true) %}
                    <p class="mb-4 rounded-lg bg-info-50 px-3 py-2 text-xs text-info-700">
                        এই সার্ভিসে সাধারণ ডিফল্ট ছাড়াই ফর্ম ফিল্ড কনফিগার করা আছে।
                    </p>
                {% endif %}
                <form method="post" action="/admin/services" class="space-y-3">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="do" value="fields">
                    <input type="hidden" name="id" value="{{ editService.id }}">

                    {% if fieldOptions|default([]) is empty %}
                        <p class="rounded-lg bg-neutral-50 px-3 py-2 text-xs text-neutral-500">
                            এই সার্ভিসের জন্য কোনো ডিফল্ট ফর্ম ফিল্ড নেই — নিচে নিজে যোগ করতে পারেন।
                        </p>
                    {% endif %}

                    {# ---- বর্তমান ফিল্ডগুলো ----
                       Each row carries its own `field_order[]` hidden input, so
                       the order the rows are in when the form is submitted IS
                       the order the fields are saved in. Nothing has to read the
                       arrangement off a script or a data attribute: moving a row
                       moves its name with it.

                       The handle is `draggable` and the row is not, because a
                       row is full of text inputs — a draggable row makes it
                       impossible to select a label or click into a field. The
                       two arrow buttons are not a nicety: a drag handle is
                       unusable with a keyboard and invisible to a screen
                       reader, and the position of a form field is exactly the
                       thing somebody configuring a form needs to set. #}
                    <div x-data="fieldSorter()"
                         @dragstart="start($event)"
                         @dragover.prevent="over($event)"
                         @drop="drop($event)"
                         @dragend="end()"
                         class="space-y-3">
                        {% for option in fieldOptions|default([]) %}
                            <div data-sortable-row="{{ option.name }}" class="flex items-start gap-2">
                                <div class="flex shrink-0 flex-col items-center gap-1 pt-3">
                                    <button type="button" draggable="true"
                                            class="cursor-grab touch-none rounded p-1 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-600 active:cursor-grabbing"
                                            aria-label="{{ option.label }} ফিল্ডটি টেনে সরান">
                                        {{ icon('grip-vertical', 'w-4 h-4') }}
                                    </button>
                                    <button type="button" data-sortable-up
                                            @click="step($el.closest('[data-sortable-row]'), -1)"
                                            class="rounded p-1 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-600"
                                            aria-label="{{ option.label }} ফিল্ডটি এক ধাপ উপরে সরান">
                                        {{ icon('chevron-up', 'w-3 h-3') }}
                                    </button>
                                    <button type="button" data-sortable-down
                                            @click="step($el.closest('[data-sortable-row]'), 1)"
                                            class="rounded p-1 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-600"
                                            aria-label="{{ option.label }} ফিল্ডটি এক ধাপ নিচে সরান">
                                        {{ icon('chevron-down', 'w-3 h-3') }}
                                    </button>
                                </div>
                                <input type="hidden" name="field_order[]" value="{{ option.name }}">
                                <div class="min-w-0 flex-1">
                        {% if option.custom %}
                            <div x-data="{ drop: false }" class="rounded-lg border p-4"
                                 :class="drop ? 'border-danger-300 bg-danger-50/40' : 'border-primary-200 bg-primary-50/30'">
                                <label class="flex flex-wrap items-center gap-2 text-sm font-medium text-neutral-800">
                                    <input type="checkbox" name="fields[]" value="{{ option.name }}" class="rounded border-neutral-300" {% if option.enabled %}checked{% endif %}>
                                    {{ icon('sparkles', 'w-4 h-4 text-primary-600') }}
                                    {{ option.label }}
                                    <code class="text-xs text-neutral-400">{{ option.name }}</code>
                                    <span class="text-xs text-neutral-400">({{ option.type }})</span>
                                    <span class="rounded-full bg-primary-100 px-2 py-0.5 text-[10px] font-semibold text-primary-700">কাস্টম</span>
                                </label>
                                <fieldset class="mt-3 space-y-2 pl-6" :disabled="drop">
                                    <div class="grid gap-3">
                                        <div>
                                            <label class="form-label" for="cl-{{ option.name }}">লেবেল</label>
                                            <input id="cl-{{ option.name }}" type="text" name="custom_label[{{ option.name }}]" class="form-input" maxlength="120" value="{{ option.label }}">
                                        </div>
                                        <div>
                                            <label class="form-label" for="ct-{{ option.name }}">টাইপ</label>
                                            <select id="ct-{{ option.name }}" name="custom_type[{{ option.name }}]" class="form-input">
                                                {% for type in fieldTypes|default(['text']) %}
                                                    <option value="{{ type }}" {% if option.type == type %}selected{% endif %}>{{ type }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="form-label" for="cp-{{ option.name }}">প্লেসহোল্ডার</label>
                                            <input id="cp-{{ option.name }}" type="text" name="custom_placeholder[{{ option.name }}]" class="form-input" maxlength="120" value="{{ option.placeholder }}">
                                        </div>
                                        <div>
                                            <label class="form-label" for="ch-{{ option.name }}">সহায়ক লেখা</label>
                                            <input id="ch-{{ option.name }}" type="text" name="custom_help[{{ option.name }}]" class="form-input" maxlength="190" value="{{ option.help }}">
                                        </div>
                                    </div>
                                    <label class="flex items-center gap-2 text-xs text-neutral-500">
                                        <input type="checkbox" name="required_fields[]" value="{{ option.name }}" class="rounded border-neutral-300" {% if option.required %}checked{% endif %}>
                                        এটি আবশ্যক
                                    </label>
                                </fieldset>
                                <label class="mt-3 flex items-center gap-2 border-t border-dashed border-neutral-200 pt-3 text-xs text-danger-600">
                                    <input type="checkbox" name="remove_custom[]" value="{{ option.name }}" class="rounded border-neutral-300" x-model="drop">
                                    এই কাস্টম ফিল্ডটি স্থায়ীভাবে মুছে ফেলুন
                                </label>
                            </div>
                        {% else %}
                            <div class="rounded-lg border border-neutral-200 p-4">
                                <label class="flex flex-wrap items-center gap-2 text-sm font-medium text-neutral-800">
                                    <input type="checkbox" name="fields[]" value="{{ option.name }}" class="rounded border-neutral-300" {% if option.enabled %}checked{% endif %}>
                                    {{ option.label }}
                                    <code class="text-xs text-neutral-400">{{ option.name }}</code>
                                    <span class="text-xs text-neutral-400">({{ option.type }})</span>
                                </label>
                                <label class="mt-2 flex flex-wrap items-center gap-2 pl-6 text-xs text-neutral-500">
                                    <input type="checkbox" name="required_fields[]" value="{{ option.name }}" class="rounded border-neutral-300" {% if option.required and option.enabled %}checked{% endif %}>
                                    এটি আবশ্যক
                                </label>
                            </div>
                        {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# ---- নতুন ফিল্ড যোগ করা ---- #}
                    <div class="rounded-lg border border-dashed border-neutral-300 bg-neutral-50/60 p-4">
                        <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-neutral-800">
                            {{ icon('plus', 'w-4 h-4 text-primary-600') }} নতুন ফিল্ড যোগ করুন
                        </h3>
                        {# The first row is plain HTML so adding a field still works without JavaScript;
                           the Alpine template below appends further rows. #}
                        <div x-data="{ rows: [] }" class="space-y-3">
                            {% set row = 0 %}
                                <div class="space-y-2 rounded-lg border border-neutral-200 bg-white p-3">
                                    <div class="grid gap-3">
                                        <div>
                                            <label class="form-label" for="new-name-{{ row }}">নাম (ইংরেজি) <span class="text-danger-600">*</span></label>
                                            <input id="new-name-{{ row }}" type="text" name="custom_new[{{ row }}][name]" class="form-input" maxlength="32" placeholder="mobile_number">
                                            <p class="form-help">ছোট ইংরেজি অক্ষর দিয়ে শুরু, তারপর ছোট অক্ষর/সংখ্যা/আন্ডারস্কোর। 'do', 'id', 'csrf' নামগুলো সংরক্ষিত।</p>
                                        </div>
                                        <div>
                                            <label class="form-label" for="new-label-{{ row }}">লেবেল <span class="text-danger-600">*</span></label>
                                            <input id="new-label-{{ row }}" type="text" name="custom_new[{{ row }}][label]" class="form-input" maxlength="120" placeholder="মোবাইল নম্বর">
                                        </div>
                                        <div>
                                            <label class="form-label" for="new-type-{{ row }}">টাইপ</label>
                                            <select id="new-type-{{ row }}" name="custom_new[{{ row }}][type]" class="form-input">
                                                {% for type in fieldTypes|default(['text']) %}
                                                    <option value="{{ type }}">{{ type }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="form-label" for="new-ph-{{ row }}">প্লেসহোল্ডার</label>
                                            <input id="new-ph-{{ row }}" type="text" name="custom_new[{{ row }}][placeholder]" class="form-input" maxlength="120" placeholder="যেমন: 01XXXXXXXXX">
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label" for="new-help-{{ row }}">সহায়ক লেখা</label>
                                        <input id="new-help-{{ row }}" type="text" name="custom_new[{{ row }}][help]" class="form-input" maxlength="190" placeholder="ইউজারকে কী লিখতে হবে সেটা ছোট করে লিখুন">
                                    </div>
                                    <label class="flex items-center gap-2 text-xs text-neutral-500">
                                        <input type="checkbox" name="custom_new[{{ row }}][required]" value="1" class="rounded border-neutral-300" checked>
                                        এটি আবশ্যক
                                    </label>
                                </div>

                            <template x-for="(row, i) in rows" :key="i">
                                <div class="space-y-2 rounded-lg border border-neutral-200 bg-white p-3">
                                    <div class="grid gap-3">
                                        <div>
                                            <label class="form-label">নাম (ইংরেজি) <span class="text-danger-600">*</span></label>
                                            <input type="text" class="form-input" maxlength="32" placeholder="mobile_number" :name="'custom_new[' + (i + 1) + '][name]'">
                                        </div>
                                        <div>
                                            <label class="form-label">লেবেল <span class="text-danger-600">*</span></label>
                                            <input type="text" class="form-input" maxlength="120" placeholder="মোবাইল নম্বর" :name="'custom_new[' + (i + 1) + '][label]'">
                                        </div>
                                        <div>
                                            <label class="form-label">টাইপ</label>
                                            <select class="form-input" :name="'custom_new[' + (i + 1) + '][type]'">
                                                {% for type in fieldTypes|default(['text']) %}
                                                    <option value="{{ type }}">{{ type }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="form-label">প্লেসহোল্ডার</label>
                                            <input type="text" class="form-input" maxlength="120" :name="'custom_new[' + (i + 1) + '][placeholder]'">
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label">সহায়ক লেখা</label>
                                        <input type="text" class="form-input" maxlength="190" :name="'custom_new[' + (i + 1) + '][help]'">
                                    </div>
                                    <label class="flex items-center gap-2 text-xs text-neutral-500">
                                        <input type="checkbox" value="1" class="rounded border-neutral-300" checked :name="'custom_new[' + (i + 1) + '][required]'">
                                        এটি আবশ্যক
                                    </label>
                                </div>
                            </template>

                            <button type="button" @click="rows.push({})" class="btn btn-sm btn-ghost">
                                {{ icon('plus', 'w-4 h-4') }} আরেকটি ফিল্ড যোগ করুন
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-ghost btn-block">
                        {{ icon('save', 'w-4 h-4') }} ফর্ম ফিল্ড সংরক্ষণ করুন
                    </button>
                </form>

                {% if not usingFieldDefaults|default(true) %}
                    <form method="post" action="/admin/services" class="mt-3"
                          onsubmit="return confirm('সব ফর্ম ফিল্ড কনফিগারেশন ডিফল্টে ফেরাবেন? সব কাস্টম ফিল্ড মুছে যাবে।')">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <input type="hidden" name="do" value="fields_reset">
                        <input type="hidden" name="id" value="{{ editService.id }}">
                        <button type="submit" class="btn btn-sm btn-ghost btn-block">
                            {{ icon('history', 'w-4 h-4') }} ডিফল্টে ফিরিয়ে আনুন
                        </button>
                    </form>
                {% endif %}
            </div>
        {% else %}
            <p class="mt-4 rounded-lg bg-info-50 px-3 py-2 text-xs text-info-600">
                সার্ভিস তৈরি করার পর <strong>এডিট</strong> থেকে NID / জন্মতারিখ ফর্ম ফিল্ড কনফিগার করা যাবে।
            </p>
        {% endif %}
    </section>

    <!-- List. min-w-0 keeps the 640px table from stretching the grid track on phones. -->
    <section class="min-w-0 lg:col-span-2">
        {# The whole card carries the selection state: one `change` listener on a
           common ancestor counts the ticked rows however many there are, and the
           count is what shows the bar. Without JavaScript the page is still
           usable — the checkboxes submit with the bar's form either way — it just
           stops counting and stops hiding an empty bar. #}
        <div class="card overflow-hidden" id="services-list"
             x-data="{ count: 0, total: {{ services|length }}, matched: {{ filterTotal|default(0) }},
                       filtered: {{ filterSet|default(false) ? 'true' : 'false' }},
                       all: false, target: '', scope: 'selected',
                       boxes() { return document.getElementById('services-rows').querySelectorAll('input[type=checkbox]'); },
                       up() { return this.count > 0 || this.filtered; },
                       confirm(action, n) {
                           if (action === 'deactivate') return confirm('নির্বাচিত ' + n + ' টি সার্ভিস নিষ্ক্রিয় করবেন? ইজারতে ওগুলো আর দেখা যাবে না।');
                           if (action === 'trash') return confirm('নির্বাচিত ' + n + ' টি সার্ভিস ট্র্যাশে পাঠাবেন? পুরনো লেনদেন রেকর্ড সংরক্ষিত থাকবে এবং চাইলে রিস্টোর করা যাবে।');
                           if (action === 'purge') return confirm('নির্বাচিত ' + n + ' টি সার্ভিস স্থায়ীভাবে মুছে ফেলবেন? এটি আর ফেরানো যাবে না।');
                           return true;
                       },
                       clear() {
                           this.boxes().forEach(row => row.checked = false);
                           this.count = 0; this.all = false; this.target = ''; this.scope = 'selected';
                       } }"
             @change="count = Array.from(boxes()).filter(b => b.checked).length;
                      all = count > 0 && count === total"
             x-effect="document.body.classList.toggle('services-bulk-active', up())">
            {% if trashedCount|default(0) > 0 %}
                {# Trash bar: soft-deleted services stay here until restored or purged. #}
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200 bg-danger-50/60 px-4 py-3">
                    <p class="text-sm font-medium text-danger-700">
                        {{ icon('alert-triangle', 'w-4 h-4 inline-block align-text-bottom') }}
                        ট্র্যাশে <strong>{{ trashedCount }}</strong>টি সার্ভিস আছে — ওগুলো সাইটে দেখা যাচ্ছে না, লেনদেন রেকর্ড অক্ষত আছে।
                    </p>
                    <form method="post" action="/admin/services" onsubmit="return confirm('ট্র্যাশের সব সার্ভিস ফিরিয়ে আনবেন?')">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <input type="hidden" name="do" value="restore_all">
                        <button type="submit" class="btn btn-sm">
                            {{ icon('history', 'w-4 h-4') }} সব ফিরিয়ে আনুন
                        </button>
                    </form>
                </div>
            {% endif %}
            {# Empty state lives outside the <table>: .table-base carries a 640px
               min-width, so a centred message inside it would sit off-screen on a phone. #}
            {% if services is empty %}
                <div class="flex flex-col items-center gap-2 px-4 py-12 text-center">
                    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                        {{ icon('inbox', 'w-6 h-6') }}
                    </span>
                    {# "No services" and "no services *here*" are different
                       answers, and with the filter on the second is the likely
                       one — so the way out of it is on screen. #}
                    <p class="text-sm text-neutral-500">
                        {% if filterSet|default(false) %}
                            এই ফিল্টারে কোনো সার্ভিস নেই।
                            <a href="/admin/services" class="underline">ফিল্টার মুছে সব দেখুন</a>
                        {% else %}
                            কোনো সার্ভিস নেই।
                        {% endif %}
                    </p>
                </div>
            {% else %}
            <div class="overflow-x-auto">
                <table class="table-base">
                    <thead>
                        <tr>
                            {# Drives the row boxes and is never itself submitted: it carries
                               no `name`, so it cannot end up in the `ids[]` payload. #}
                            <th class="w-10">
                                <input type="checkbox" x-model="all"
                                       @change="boxes().forEach(row => row.checked = $el.checked)"
                                       class="h-4 w-4 cursor-pointer rounded border-neutral-300 text-primary-600 focus:ring-primary-500"
                                       aria-label="এই পাতার সব সার্ভিস নির্বাচন করুন">
                            </th>
                            <th>সার্ভিস</th><th>ক্যাটাগরি</th><th>মূল্য</th><th>স্ট্যাটাস</th><th class="text-right">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody id="services-rows">
                        {# The category name is looked up with `filter`, not with a
                           prebuilt id => name map: `{(category.id): category.name}`
                           is not a keyed hash in Twig — the parenthesised key is
                           dropped and the literal becomes a 0-indexed list, so
                           `catNames[service.category_id]` answered with the
                           *next* category's name and the last category fell
                           through to a raw id. Every row read one chip too far. #}
                        {% for service in services %}
                            {% set isTrashed = service.deleted_at is not empty %}
                            <tr class="{{ isTrashed ? 'bg-neutral-50 text-neutral-400' : (isEdit and editService.id == service.id ? 'bg-primary-50/60' : '') }}">
                                {# `form=` associates this box with the bar's <form> below
                                   without being inside it — the only way to collect a
                                   selection here, because every row already carries its own
                                   form and nested forms are not valid HTML. #}
                                <td class="w-10">
                                    <input type="checkbox" name="ids[]" value="{{ service.id }}" form="services-bulk"
                                           class="h-4 w-4 cursor-pointer rounded border-neutral-300 text-primary-600 focus:ring-primary-500"
                                           aria-label="{{ service.name }} নির্বাচন করুন">
                                </td>
                                <td>
                                    <p class="font-semibold {{ isTrashed ? 'text-neutral-400 line-through' : 'text-neutral-800' }}">{{ service.name }}</p>
                                    <p class="font-mono text-xs text-neutral-400">{{ service.slug }}</p>
                                    {% if isTrashed %}
                                        <p class="text-xs text-danger-600">মুছে ফেলা: {{ service.deleted_at|bndate }}</p>
                                    {% endif %}
                                </td>
                                {% set rowCategory = categories|filter(c => c.id == service.category_id)|first %}
                                <td class="text-sm text-neutral-500">{{ rowCategory.name ?? service.category_id }}</td>
                                <td class="font-semibold {{ isTrashed ? 'text-neutral-400' : 'text-primary-700' }}">{{ service.price|money }}</td>
                                <td>
                                    {% if isTrashed %}
                                        {% include 'components/status-badge.twig' with { status: 'deleted' } %}
                                    {% else %}
                                        {% include 'components/status-badge.twig' with { status: service.status } %}
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="flex justify-end gap-2">
                                        {% if isTrashed %}
                                            {# Trashed: restore brings it back, purge is the only way to really remove it. #}
                                            <form method="post" action="/admin/services">
                                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                                <input type="hidden" name="do" value="restore">
                                                <input type="hidden" name="id" value="{{ service.id }}">
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    {{ icon('history', 'w-4 h-4') }} রিস্টোর
                                                </button>
                                            </form>
                                            <form method="post" action="/admin/services" onsubmit="return confirm('&quot;{{ service.name }}&quot; স্থায়ীভাবে মুছে ফেলবেন? এটি আর ফেরানো যাবে না।')">
                                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                                <input type="hidden" name="do" value="purge">
                                                <input type="hidden" name="id" value="{{ service.id }}">
                                                <button type="submit" class="btn btn-danger btn-sm">স্থায়ী মুছুন</button>
                                            </form>
                                        {% else %}
                                            <a href="/admin/services?edit={{ service.id }}" class="btn btn-ghost btn-sm" aria-label="{{ service.name }} এডিট করুন">এডিট</a>
                                            <form method="post" action="/admin/services">
                                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                                <input type="hidden" name="do" value="toggle">
                                                <input type="hidden" name="id" value="{{ service.id }}">
                                                <button type="submit" class="btn btn-ghost btn-sm">
                                                    {{ service.status == 'active' ? 'নিষ্ক্রিয়' : 'সক্রিয়' }}
                                                </button>
                                            </form>
                                            <form method="post" action="/admin/services" onsubmit="return confirm('&quot;{{ service.name }}&quot; ট্র্যাশে পাঠাবেন? পুরনো লেনদেন রেকর্ড সংরক্ষিত থাকবে এবং চাইলে রিস্টোর করা যাবে।')">
                                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                                <input type="hidden" name="do" value="delete">
                                                <input type="hidden" name="id" value="{{ service.id }}">
                                                <button type="submit" class="btn btn-danger btn-sm">মুছুন</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ---- Bulk bar ---- #}
            {# The bar's form cannot wrap the table: every row above already has its
               own restore / toggle / delete form, and the HTML parser closes an
               outer <form> at the first inner one — the selection would silently
               stop submitting. So the form lives here, below the list, and the row
               checkboxes point at it by id with `form=`.

               `do` and the action ride on hidden fields rather than on the button,
               because there is only one submission here — one form, one meaning.

               The bar is fixed to the bottom of the viewport so it is reachable
               however far down the list the admin has scrolled, and hidden until
               something is ticked: an always-present bar over a list nobody is
               acting on is just furniture. Both carry `x-cloak` so neither flashes
               into view before Alpine boots. The spacer keeps the last rows from
               sitting underneath it.

               Only the destructive actions confirm, and they confirm about
               themselves: a prompt on "সক্রিয় করুন" would train admins to click
               through the one that matters. #}
            <form id="services-bulk" method="post" action="/admin/services"
                  @submit="if (!confirm(target, scope === 'filtered' ? matched : count)) $event.preventDefault()">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <input type="hidden" name="do" value="bulk">
                {# Where the batch ran from, so the redirect after it — and the
                   Undo click after that — come back to this list rather than to
                   an unfiltered one. `return_*` names because the form's own
                   fields belong to the action. #}
                <input type="hidden" name="return_q" value="{{ filterState.q }}">
                <input type="hidden" name="return_category" value="{{ filterState.category }}">
                <input type="hidden" name="return_status" value="{{ filterState.status }}">
                <input type="hidden" name="return_trashed" value="{{ filterState.trashed }}">

                <div class="h-28" x-show="up()" x-cloak></div>

                {# The bar keeps its own z-40. It does not need to out-rank the push
                   prompt, because while the bar is up the prompt is stepped
                   aside by the scoped rule in the page_scripts block — that
                   rule needs no CSS rebuild, unlike a new z-* utility would. #}
                <div class="fixed inset-x-0 bottom-20 z-40 mx-auto w-full max-w-3xl px-4 sm:bottom-4"
                     x-show="up()" x-cloak>
                    <div class="card flex flex-wrap items-center gap-2 px-4 py-3 shadow-lg">
                        {# Two counts, because the two scopes do not act on the same
                           number of rows and a bar that claimed "3 selected" over
                           a 300-row filter would be lying about the batch it is
                           about to run. `matched` is the filter's total, which is
                           also the ceiling the service enforces. #}
                        <p class="mr-auto text-sm font-semibold text-neutral-800">
                            <span x-show="scope === 'selected'">
                                <span x-text="count"></span> টি সার্ভিস নির্বাচিত
                            </span>
                            <span x-show="scope === 'filtered'">
                                ফিল্টারে মিলেছে <span x-text="matched"></span> টি সার্ভিস
                            </span>
                        </p>

                        {# No `required`: the apply button is disabled until a target is
                           chosen, which states the same rule where it applies. #}
                        <select name="bulk_action" x-model="target" class="form-input sm:w-40"
                                aria-label="বাল্ক অ্যাকশন">
                            <option value="">অ্যাকশন বেছে নিন…</option>
                            {% for action in bulkActions %}
                                <option value="{{ action }}">{{ bulkActionLabels[action] ?? action }}</option>
                            {% endfor %}
                        </select>

                        <button type="submit" class="btn btn-primary btn-sm" @click="scope = 'selected'"
                                x-bind:disabled="target === '' || (scope === 'selected' && count === 0)">
                            {{ icon('list-checks', 'w-4 h-4') }} প্রয়োগ করুন
                        </button>

                        {# The scope is on the button rather than in Alpine: the
                           value below is what the server reads, so the batch is
                           "all matching" even if this script never ran, and a
                           stale `scope` cannot downgrade it. `runFiltered()`
                           resolves the ids from the same filter the list was
                           rendered from — the point being that the bar never
                           carries more ids than a request should, so a list of
                           thousands is still one batch.

                           Rendered only when a filter is actually narrowing: with
                           nothing set, "all matching" is the whole table, and for
                           `purge` that is every service in the shop. #}
                        {% if filterSet %}
                            <button type="submit" name="bulk_scope" value="filtered" class="btn btn-sm"
                                    @click="scope = 'filtered'">
                                {{ icon('list-filter', 'w-4 h-4') }} ফিল্টারের সবগুলো
                            </button>
                        {% endif %}

                        <button type="button" class="btn btn-ghost btn-sm" @click="clear()">বাতিল</button>
                    </div>
                </div>
            </form>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
