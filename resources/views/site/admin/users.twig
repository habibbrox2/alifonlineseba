{% extends 'layouts/dashboard.twig' %}

{% block title %}ইউজার ম্যানেজমেন্ট — Admin{% endblock %}

{% block dashboard_content %}
{% include 'components/page-header.twig' with {
    title: 'ইউজার ম্যানেজমেন্ট',
    description: 'মোট ' ~ total ~ ' জন সক্রিয় ইউজার — খুঁজুন, এডিট করুন বা ট্র্যাশে পাঠান',
} %}

{# Trash / live filter — trashed users are hidden from the site and from login until restored. #}
{% set currentFilter = deletedFilter|default('exclude') %}
<div class="mb-5 flex flex-wrap items-center gap-2">
    <span class="text-sm text-neutral-500">{{ icon('filter', 'w-4 h-4 inline-block align-text-bottom') }} ফিল্টার:</span>
    <a href="/admin/users" class="btn btn-sm {{ currentFilter == 'exclude' ? 'btn-primary' : 'btn-ghost' }}">সক্রিয় ইউজার</a>
    <a href="/admin/users?trashed=only" class="btn btn-sm {{ currentFilter == 'only' ? 'btn-primary' : 'btn-ghost' }}">
        {{ icon('alert-triangle', 'w-4 h-4') }} ট্র্যাশ ({{ trashedCount|default(0) }})
    </a>
    <a href="/admin/users?trashed=all" class="btn btn-sm {{ currentFilter == 'all' ? 'btn-primary' : 'btn-ghost' }}">সবাই দেখুন</a>
    {% if trashedCount|default(0) > 0 %}
        <form method="post" action="/admin/users" class="ml-auto" data-confirm="{{ { title: 'ট্র্যাশের সব ইউজার ফিরিয়ে আনবেন?', tone: 'neutral', message: 'ট্র্যাশে থাকা সব ইউজার আবার সক্রিয় হবে।', confirm: 'সব ফিরিয়ে আনুন' }|json_encode }}">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="do" value="restore_all">
            <button type="submit" class="btn btn-sm">
                {{ icon('history', 'w-4 h-4') }} সব ইউজার ফিরিয়ে আনুন
            </button>
        </form>
    {% endif %}
</div>

{% if can_access(identity, 'admin-users-create') %}
<!-- Create user -->
<details class="card mb-6 p-5" {{ flash_error is defined and flash_error ? 'open' }}>
    {# tap-row only kicks in under 640px, where a 24px summary line is too small to hit reliably. #}
    <summary class="tap-row cursor-pointer text-base font-bold text-neutral-800 select-none">
        {{ icon('user-plus', 'w-5 h-5 text-primary-600') }} নতুন ইউজার যোগ করুন
    </summary>
    <form method="post" action="/admin/users" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="do" value="create">
        <div>
            <label for="nu-full-name" class="form-label">পুরো নাম <span class="text-danger-600">*</span></label>
            <input id="nu-full-name" type="text" name="full_name" class="form-input" placeholder="যেমন: রহিম উদ্দিন" required>
        </div>
        <div>
            <label for="nu-username" class="form-label">ইউজারনেম <span class="text-danger-600">*</span></label>
            <input id="nu-username" type="text" name="username" class="form-input" placeholder="newuser" required>
        </div>
        <div>
            <label for="nu-phone" class="form-label">মোবাইল <span class="text-danger-600">*</span></label>
            <input id="nu-phone" type="tel" name="phone" class="form-input" placeholder="01712345678" required>
        </div>
        <div>
            <label for="nu-email" class="form-label">ইমেইল</label>
            <input id="nu-email" type="email" name="email" class="form-input" placeholder="optional">
        </div>
        {# The shared date widget — see components/date-field.twig. Same format,
           same check, same message as the profile and the service forms. #}
        {% include 'components/date-field.twig' with {
            id: 'nu-date-of-birth',
            name: 'date_of_birth',
            label: 'জন্ম তারিখ (ঐচ্ছিক)',
            value: '',
            required: false,
        } %}
        <div>
            <label for="nu-password" class="form-label">পাসওয়ার্ড <span class="text-danger-600">*</span></label>
            <input id="nu-password" type="password" name="password" class="form-input" minlength="8" required>
        </div>
        <div>
            <label for="nu-role" class="form-label">রোল</label>
            <select id="nu-role" name="role" class="form-input">
                <option value="user" selected>user</option>
                <option value="staff">staff</option>
                <option value="admin">admin</option>
            </select>
        </div>
        <div>
            <label for="nu-balance" class="form-label">প্রারম্ভিক ব্যালেন্স (৳)</label>
            <input id="nu-balance" type="number" step="0.01" min="0" name="balance" class="form-input" value="0">
        </div>
        <div class="sm:col-span-2 lg:col-span-3">
            <button type="submit" class="btn btn-primary">{{ icon('plus', 'w-4 h-4') }} তৈরি করুন</button>
        </div>
    </form>
</details>
{% endif %}

<form method="get" action="/admin/users" class="mb-5 flex gap-2 sm:max-w-md">
    <input type="search" name="q" value="{{ q }}" class="form-input" placeholder="পুরো নাম, ইউজারনেম, মোবাইল বা ইমেইল দিয়ে খুঁজুন…">
    <button type="submit" class="btn btn-primary btn-sm">{{ icon('search', 'w-4 h-4') }} খুঁজুন</button>
</form>

{% set trashedQuery = currentFilter != 'exclude' ? ('trashed=' ~ currentFilter ~ '&') : '' %}
{% set usersQuery = '/admin/users?' ~ (q ? ('q=' ~ q|url_encode) ~ '&' : '') ~ trashedQuery %}

{% set canBulk = can_access(identity, 'admin-users-status-update') %}

{# The bulk bar floats at the bottom, but its Alpine scope has to cover the
   table above it — so one wrapper owns the checkboxes, the counter and the
   bar. `@change` on the wrapper recounts ticked rows; `data-bulk` marks our
   checkboxes so the count never picks up a form widget belonging to a
   per-row action. #}
<div x-data="{ count: 0, all: false, target: '',
        clear() {
            this.$root.querySelectorAll('tbody input[data-bulk]').forEach(box => { box.checked = false; });
            this.count = 0; this.all = false; this.target = '';
        } }"
     @change="count = $root.querySelectorAll('tbody input[data-bulk]:checked').length;
               all = count > 0 && count === $root.querySelectorAll('tbody input[data-bulk]').length">

<div class="card overflow-hidden">
        {# Outside the <table> so the message is not stranded in a 640px-wide scroll area. #}
        {% if rows is empty %}
            <div class="flex flex-col items-center gap-2 px-4 py-12 text-center">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                    {{ icon('users', 'w-6 h-6') }}
                </span>
                <p class="text-sm text-neutral-500">
                    {% if currentFilter == 'only' %}ট্র্যাশে কোনো ইউজার নেই।
                    {% elseif q %}“{{ q }}” অনুসন্ধানে কোনো ইউজার পাওয়া যায়নি।
                    {% else %}কোনো ইউজার পাওয়া যায়নি।{% endif %}
                </p>
            </div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="table-base">
                <thead>
                    <tr>
                        {% if canBulk %}
                        {# The checkbox joins the *bulk* form by attribute, not by
                           ancestry: this table is full of per-row forms, and a
                           wrapper form would nest and silently break every one. #}
                        <th class="w-10">
                            <input type="checkbox" form="user-bulk-form" x-bind:checked="all"
                                   @change="const on = $el.checked; $root.querySelectorAll('tbody input[data-bulk]').forEach(box => { box.checked = on; }); all = on"
                                   class="h-4 w-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-500"
                                   aria-label="সব ইউজার নির্বাচন করুন">
                        </th>
                        {% endif %}
                        {% include 'components/sortable-header.twig' with { label: 'ইউজার', column: 'username', sort: sort, dir: dir, base: usersQuery } %}
                        {% include 'components/sortable-header.twig' with { label: 'ব্যালেন্স', column: 'balance', sort: sort, dir: dir, base: usersQuery } %}
                        {% include 'components/sortable-header.twig' with { label: 'রোল', column: 'role', sort: sort, dir: dir, base: usersQuery } %}
                        {% include 'components/sortable-header.twig' with { label: 'স্ট্যাটাস', column: 'status', sort: sort, dir: dir, base: usersQuery } %}
                        {% include 'components/sortable-header.twig' with { label: 'শেষ লগইন', column: 'last_login_at', sort: sort, dir: dir, base: usersQuery } %}
                        <th class="text-right">অ্যাকশন</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in rows %}
                        {% set isTrashed = user.deleted_at is not empty %}
                        <tr class="{{ isTrashed ? 'bg-neutral-50' }}">
                            {% if canBulk %}
                            <td>
                                {# Same eligibility as the backend's guards: a
                                   trashed row has no status to change, and self /
                                   higher-rank rows would only be counted as
                                   "skipped" — so they are not offered at all. #}
                                {% if not isTrashed and user.id != identity.id and identity.canManageRole(user.role) %}
                                    <input type="checkbox" data-bulk form="user-bulk-form" value="{{ user.id }}"
                                           class="h-4 w-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-500"
                                           aria-label="{{ user.username }} নির্বাচন করুন">
                                {% endif %}
                            </td>
                            {% endif %}
                            <td>
                                {# Name first, handle beneath: an admin scans for
                                   a person, and @username is the login detail
                                   they need only once they have found them. #}
                                <p class="font-semibold {{ isTrashed ? 'text-neutral-400 line-through' : 'text-neutral-800' }}">{{ user.full_name ?: user.username }}</p>
                                <p class="text-xs text-neutral-400">@{{ user.username }} · {{ user.phone }}{% if user.email %} · {{ user.email }}{% endif %}</p>
                                {# Stored as `2026-10-06`, shown as `06-10-2026` — the
                                   `displaydate` filter is a no-op for anything that is
                                   not a date, so it can sit on an unset column. #}
                                {% if user.date_of_birth %}
                                    <p class="text-xs text-neutral-400">জন্ম তারিখ: {{ user.date_of_birth|displaydate }}</p>
                                {% endif %}
                                {% if isTrashed %}
                                    <p class="text-xs text-danger-600">মুছে ফেলা: {{ user.deleted_at|bndate }}</p>
                                {% endif %}
                            </td>
                            <td class="font-semibold {{ isTrashed ? 'text-neutral-400' : 'text-primary-700' }}">{{ user.balance|money }}</td>
                            <td>
                                {% if isTrashed %}
                                    <span class="text-xs text-neutral-400">{{ user.role }}</span>
                                {% else %}
                                    {% if can_access(identity, 'admin-users-role-update') and identity.canManageRole(user.role) %}
                                        {# Quick promote buttons for regular users #}
                                        {% if user.role == 'user' %}
                                        <div class="flex flex-col gap-1">
                                            <form method="post" action="/admin/users" class="flex items-center gap-1" data-confirm="{{ { title: (user.username ~ ' কে এডমিন বানাবেন?'), tone: 'warn', message: 'এই ইউজার অ্যাডমিন প্যানেল, স্টাফ ব্যবস্থাপনা ও উত্তোলন অনুরোধ দেখতে পাবে।', confirm: 'এডমিন বানান' }|json_encode }}">
                                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                                <input type="hidden" name="do" value="role">
                                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                                <input type="hidden" name="role" value="admin">
                                                <button type="submit" class="btn btn-primary btn-xs px-2 py-1" title="এডমিন হিসেবেfilled">
                                                    {{ icon('shield-check', 'w-3.5 h-3.5') }} এডমিন
                                                </button>
                                            </form>
                                            <form method="post" action="/admin/users" class="flex items-center gap-1" data-confirm="{{ { title: (user.username ~ ' কে স্টাফ বানাবেন?'), tone: 'warn', message: 'স্টাফ এডমিন প্যানেল দেখতে পাবে, কিন্তু উত্তোলন বা প্ল্যাটফর্ম লেজার নয়।', confirm: 'স্টাফ বানান' }|json_encode }}">
                                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                                <input type="hidden" name="do" value="role">
                                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                                <input type="hidden" name="role" value="staff">
                                                <button type="submit" class="btn btn-info btn-xs px-2 py-1" title="স্টাফ হিসেবেfilled">
                                                    {{ icon('user-plus', 'w-3.5 h-3.5') }} স্টাফ
                                                </button>
                                            </form>
                                        </div>
                                        {% elseif user.role == 'staff' and identity.isSuperAdmin() %}
                                        {# Superadmin can promote staff to admin #}
                                        <form method="post" action="/admin/users" class="flex items-center gap-1" data-confirm="{{ { title: (user.username ~ ' কে এডমিন বানাবেন?'), tone: 'warn', message: 'এই ইউজার অ্যাডমিন প্যানেল, স্টাফ ব্যবস্থাপনা ও উত্তোলন অনুরোধ দেখতে পাবে।', confirm: 'এডমিন বানান' }|json_encode }}">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="do" value="role">
                                            <input type="hidden" name="user_id" value="{{ user.id }}">
                                            <input type="hidden" name="role" value="admin">
                                            <button type="submit" class="btn btn-primary btn-xs px-2 py-1" title="এডমিন হিসেবেfilled">
                                                {{ icon('shield-check', 'w-3.5 h-3.5') }} এডমিন
                                            </button>
                                        </form>
                                        {% elseif user.role == 'admin' and identity.isSuperAdmin() %}
                                        {# Superadmin can demote admin to staff #}
                                        <form method="post" action="/admin/users" class="flex items-center gap-1" data-confirm="{{ { title: (user.username ~ ' কে স্টাফ করবেন?'), tone: 'warn', message: 'এডমিনের অ্যাক্সেস চলে যাবে।', confirm: 'স্টাফ করান' }|json_encode }}">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="do" value="role">
                                            <input type="hidden" name="user_id" value="{{ user.id }}">
                                            <input type="hidden" name="role" value="staff">
                                            <button type="submit" class="btn btn-warning btn-xs px-2 py-1" title="স্টাফ হিসেবেfilled">
                                                {{ icon('user-minus', 'w-3.5 h-3.5') }} স্টাফ
                                            </button>
                                        </form>
                                        {% else %}
                                        {# Dropdown for other cases #}
                                        <form method="post" action="/admin/users" class="flex items-center gap-1.5">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="do" value="role">
                                            <input type="hidden" name="user_id" value="{{ user.id }}">
                                            <select name="role" onchange="this.form.submit()" class="form-input px-2 py-1 text-xs">
                                                {% for role in ['user', 'staff', 'admin'] %}
                                                    <option value="{{ role }}" {{ user.role == role ? 'selected' }}>{{ role }}</option>
                                                {% endfor %}
                                            </select>
                                        </form>
                                        {% endif %}
                                    {% else %}
                                    <select class="form-input px-2 py-1 text-xs opacity-50 cursor-not-allowed" disabled>
                                        <option value="{{ user.role }}" selected>{{ user.role }}</option>
                                    </select>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% if isTrashed %}
                                    {% include 'components/status-badge.twig' with { status: 'deleted' } %}
                                {% else %}
                                    {% include 'components/status-badge.twig' with { status: user.status } %}
                                {% endif %}
                            </td>
                            <td class="whitespace-nowrap text-xs text-neutral-500">{{ user.last_login_at ? user.last_login_at|bndate : '—' }}</td>
                            <td>
                                <div class="flex justify-end gap-2">
                                    {% if isTrashed %}
                                        {% if can_access(identity, 'admin-users-restore') %}
                                        <form method="post" action="/admin/users">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="do" value="restore">
                                            <input type="hidden" name="user_id" value="{{ user.id }}">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                {{ icon('history', 'w-4 h-4') }} রিস্টোর
                                            </button>
                                        </form>
                                        {% endif %}
                                    {% else %}
                                        {% if can_access(identity, 'admin-users-edit') %}
                                        <a href="/admin/users/{{ user.id }}" class="btn btn-ghost btn-sm">এডিট</a>
                                        {% endif %}
                                        {% if can_access(identity, 'admin-users-status-update') %}
                                        <form method="post" action="/admin/users">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="do" value="toggle">
                                            <input type="hidden" name="user_id" value="{{ user.id }}">
                                            <button type="submit" class="btn btn-ghost btn-sm {{ user.status == 'active' ? 'text-danger-600' : 'text-success-600' }}">
                                                {{ user.status == 'active' ? 'নিষ্ক্রিয় করুন' : 'সক্রিয় করুন' }}
                                            </button>
                                        </form>
                                        {% endif %}
                                        {% if can_access(identity, 'admin-users-password-reset') %}
                                        <form method="post" action="/admin/users" data-confirm="{{ { title: (user.username ~ ' এর পাসওয়ার্ড রিসেট করবেন?'), tone: 'warn', bullets: ['একটি নতুন এলোমেলো পাসওয়ার্ড তৈরি হবে', 'পাসওয়ার্ডটি একবারই দেখানো হবে', 'পুরনো পাসওয়ার্ড আর কাজ করবে না'], confirm: 'রিসেট করুন' }|json_encode }}">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="do" value="reset">
                                            <input type="hidden" name="user_id" value="{{ user.id }}">
                                            <button type="submit" class="btn btn-ghost btn-sm">রিসেট</button>
                                        </form>
                                        {% endif %}
                                        {% if user.id != identity.id and user.role != 'admin' %}
                                        {% if can_access(identity, 'admin-users-delete') %}
                                        <form method="post" action="/admin/users" data-confirm="{{ { title: (user.username ~ ' ট্র্যাশে পাঠাবেন?'), tone: 'danger', bullets: ['ইউজার আর লগইন করতে পারবে না', 'চাইলে পরে রিস্টোর করা যাবে'], confirm: 'ট্র্যাশে পাঠান' }|json_encode }}">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="do" value="delete">
                                            <input type="hidden" name="user_id" value="{{ user.id }}">
                                            <button type="submit" class="btn btn-danger btn-sm" aria-label="{{ user.username }} মুছুন">মুছুন</button>
                                        </form>
                                        {% endif %}
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
</div>

{% include 'components/pagination.twig' with {
    page: page, perPage: perPage, total: total,
    baseUrl: usersQuery ~ 'page=',
    sort: sort, dir: dir,
} %}

{% if canBulk %}
{# Selection is plain `name="ids[]"` checkboxes associated with this form via
   the `form` attribute (the table cannot wrap them: its rows hold their own
   forms). Without JavaScript the bar simply never appears, exactly like the
   order desk. Alpine adds the count, the select-all and the confirm. #}
<form method="post" action="/admin/users" id="user-bulk-form"
      @submit="if (count < 1 || target === '') { $event.preventDefault(); return; }
               if ($el.dataset.confirmed === '1') { return; }
               $event.preventDefault();
               bulkStatusAsk(count, target === 'active' ? 'সক্রিয়' : 'নিষ্ক্রিয়')
                   .then(ok => { if (ok) { $el.dataset.confirmed = '1'; $el.requestSubmit(); delete $el.dataset.confirmed; } });">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="do" value="bulk_status">
    {# The batch was picked within this view; the redirect lands back on it. #}
    <input type="hidden" name="return_q" value="{{ q }}">
    <input type="hidden" name="return_trashed" value="{{ currentFilter }}">
    <input type="hidden" name="return_page" value="{{ page }}">
    <input type="hidden" name="return_sort" value="{{ sort }}">
    <input type="hidden" name="return_dir" value="{{ dir }}">

    <div x-show="count > 0" x-cloak
         class="fixed bottom-4 left-1/2 z-40 w-[min(42rem,calc(100%-2rem))] -translate-x-1/2 rounded-2xl border border-neutral-200 bg-white/95 p-3 shadow-[0_18px_40px_-18px_rgba(15,23,42,0.45)] backdrop-blur">
        <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-neutral"><span x-text="count"></span> জন ইউজার নির্বাচিত</span>
            <select name="status" x-model="target" class="form-input w-auto text-sm" aria-label="নতুন স্ট্যাটাস">
                <option value="">নতুন স্ট্যাটাস…</option>
                <option value="active">সক্রিয় করুন</option>
                <option value="disabled">নিষ্ক্রিয় করুন</option>
            </select>
            <button type="submit" class="btn btn-primary btn-sm" :disabled="count < 1 || target === ''">প্রয়োগ করুন</button>
            <button type="button" class="btn btn-ghost btn-sm" @click="clear()">বাতিল</button>
        </div>
    </div>
</form>

{# The message has to carry the live count and the chosen direction, which a
   static data-confirm attribute cannot — same reason the order desk declares
   its asker as a global instead of inlining it in the Alpine expression. #}
<script>
    window.bulkStatusAsk = function (count, label) {
        var message = 'নির্বাচিত ' + count + ' জন ইউজারের স্ট্যাটাস "' + label + '" হবে।';
        if (typeof window.thConfirm !== 'function') {
            return Promise.resolve(window.confirm(message));
        }
        return window.thConfirm({
            title: count + ' জন ইউজারের স্ট্যাটাস বদলাবেন?',
            tone: 'warning',
            bullets: [
                'এই অ্যাকাউন্টগুলো একসাথে ' + label + ' হবে',
                'নিজের বা নিয়ন্ত্রণের বাইরের অ্যাকাউন্ট বাদ পড়বে',
            ],
            message: 'প্রয়োগের আগে তালিকা দেখে নিন।',
            confirm: label + ' করুন',
        });
    };
</script>
{% endif %}

</div>
{% endblock %}