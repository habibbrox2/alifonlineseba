{% extends 'layouts/dashboard.twig' %}

{% block title %}সার্ভিস অনুরোধ #{{ tx.id }} — Admin{% endblock %}

{% block dashboard_content %}
{% set headActions %}
    {% include 'components/status-badge.twig' with { status: tx.status } %}
{% endset %}
{% include 'components/page-header.twig' with {
    title: 'সার্ভিস অনুরোধ #' ~ tx.id,
    description: 'রেফারেন্স: ' ~ tx.reference ~ ' · জমার সময়: ' ~ (tx.created_at|bndate)
        ~ (tx.updated_at != tx.created_at ? ' · শেষ হালনাগাদ: ' ~ (tx.updated_at|bndate) : ''),
    backUrl: '/admin/transactions',
    backLabel: 'লেনদেন তালিকায় ফিরে যান',
    actions: headActions,
} %}

<div class="grid gap-6 lg:grid-cols-2">
    <!-- What was ordered -->
    <div class="space-y-6">
        <section class="card p-6">
            <h2 class="mb-5 flex items-center gap-2 text-lg font-bold text-neutral-900">
                {{ icon('user-circle', 'w-5 h-5 text-primary-600') }} ইউজার ও অনুরোধ
            </h2>

            <dl class="space-y-3.5">
                <div class="flex items-baseline justify-between gap-4 border-b border-neutral-100 pb-3">
                    <dt class="text-sm text-neutral-500">ইউজার</dt>
                    <dd class="text-right text-sm font-semibold text-neutral-800">
                        {{ user.username ?? '—' }}
                        <span class="block text-xs font-normal text-neutral-400">{{ user.phone ?? '' }}</span>
                    </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 border-b border-neutral-100 pb-3">
                    <dt class="text-sm text-neutral-500">সার্ভিস</dt>
                    <dd class="text-right text-sm font-semibold text-neutral-800">
                        {{ tx.service_name ?? (metadata.service_name ?? '—') }}
                        {% if metadata.variant %}
                            <span class="block text-xs font-normal text-neutral-400">{{ metadata.variant }}</span>
                        {% endif %}
                    </dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 border-b border-neutral-100 pb-3">
                    <dt class="text-sm text-neutral-500">পরিমাণ</dt>
                    <dd class="text-right text-lg font-extrabold text-primary-700">{{ tx.amount|money }}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-4 border-b border-neutral-100 pb-3">
                    <dt class="text-sm text-neutral-500">বর্তমান অবস্থা</dt>
                    <dd class="text-right">{% include 'components/status-badge.twig' with { status: tx.status } %}</dd>
                </div>
                {% if metadata.provider %}
                    <div class="flex items-baseline justify-between gap-4 border-b border-neutral-100 pb-3">
                        <dt class="text-sm text-neutral-500">প্রদানক</dt>
                        <dd class="text-right font-mono text-xs text-neutral-600">{{ metadata.provider }}</dd>
                    </div>
                {% endif %}
                {% if metadata.attempts %}
                    <div class="flex items-baseline justify-between gap-4">
                        <dt class="text-sm text-neutral-500">চেষ্টা</dt>
                        <dd class="text-right text-sm text-neutral-800">{{ metadata.attempts }}</dd>
                    </div>
                {% endif %}
            </dl>

            {% if metadata.input is defined and metadata.input %}
                {# What the user actually typed. This is the field the operator
                   has to check the result against, so it is shown verbatim
                   rather than summarised. #}
                <div class="mt-5 border-t border-neutral-100 pt-4">
                    <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-neutral-400">ইনপুট</h3>
                    <dl class="space-y-1.5">
                        {% for key, value in metadata.input %}
                            <div class="flex items-baseline justify-between gap-4 text-sm">
                                <dt class="text-neutral-500">{{ key }}</dt>
                                <dd class="select-all break-all text-right font-medium text-neutral-800">{{ value }}</dd>
                            </div>
                        {% endfor %}
                    </dl>
                </div>
            {% endif %}

            {% if metadata.error %}
                <div class="mt-4 rounded-lg bg-danger-50 px-3.5 py-3 text-sm text-danger-700">
                    {{ metadata.error }}
                </div>
            {% endif %}
        </section>

        {% if resultEntries %}
            <section class="card p-6">
                <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-neutral-900">
                    {{ icon('file-text', 'w-5 h-5 text-primary-600') }} স্বয়ংক্রিয় ফলাফল
                </h2>
                <dl class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
                    {% for entry in resultEntries %}
                        <div class="flex flex-col items-start gap-0.5 border-b border-dashed border-neutral-200 py-1
                                    sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
                            <dt class="text-xs text-neutral-500">{{ entry.label }}</dt>
                            <dd class="break-all text-sm font-medium text-neutral-800 sm:text-right">{{ entry.value }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            </section>
        {% endif %}
    </div>

    <!-- Status + deliverable -->
    <div class="space-y-6">
        <section class="card p-6">
            <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-neutral-900">
                {{ icon('refresh-cw', 'w-5 h-5 text-primary-600') }} অবস্থা পরিবর্তন
            </h2>

            {# Separate <form> from the upload below: a status change must not
               re-post the deliverable file. #}
            <form method="post" action="/admin/transactions/{{ tx.id }}" class="space-y-4">
                <input type="hidden" name="_csrf" value="{{ csrf }}">

                <div>
                    <label for="at_status" class="form-label">নতুন অবস্থা</label>
                    <select id="at_status" name="status" class="form-input" required>
                        {% for st in statuses %}
                            <option value="{{ st }}" {{ tx.status == st ? 'selected' }}>{{ st|statuslabel }}</option>
                        {% endfor %}
                    </select>
                    <p class="form-help">
                        ব্যর্থ বা বাতিল করলে আটকে রাখা টাকা ইউজারের ব্যালেন্সে ফেরত যাবে (যদি আগে ফেরত না দেওয়া হয়ে থাকে)।
                    </p>
                </div>

                <div>
                    <label for="at_note" class="form-label">অ্যাডমিন নোট (শুধু আপনার জন্য)</label>
                    <textarea id="at_note" name="admin_note" rows="2" class="form-input" maxlength="500"
                              placeholder="যেমন: NID ভেরিফায়েড, ফাইল আপলোড করা হলো">{{ metadata.admin_note ?? '' }}</textarea>
                </div>

                <button type="submit" name="do" value="status" class="btn btn-primary w-full"
                        onclick="return confirm('অনুরোধ #{{ tx.id }} এর অবস্থা পরিবর্তন করবেন?');">
                    {{ icon('check', 'w-4 h-4') }} অবস্থা সংরক্ষণ করুন
                </button>
            </form>
        </section>

        <section class="card p-6">
            <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-neutral-900">
                {{ icon('file-down', 'w-5 h-5 text-primary-600') }} ডেলিভারি ফাইল
            </h2>

            {% if not tx.deliverable_path %}
                <p class="rounded-lg bg-warning-50 px-3.5 py-3 text-sm text-warning-800">
                    এখনো কোনো ফাইল আপলোড করা হয়নি। ফাইল দিলে ইউজার তার সার্ভিস হিস্ট্রি পাতা থেকে ডাউনলোড করতে পারবে।
                </p>
            {% elseif not hasFile %}
                {# The row points at a path but the bytes are gone. Say so loudly
                   rather than showing a broken preview — the operator needs to
                   know the file has to be re-collected. #}
                <p class="rounded-lg bg-danger-50 px-3.5 py-3 text-sm text-danger-700">
                    ফাইলটি সার্ভারে পাওয়া যাচ্ছে না — নতুন করে আপলোড করতে হবে।
                </p>
            {% elseif isImage %}
                <a href="/service-requests/{{ tx.id }}/file" target="_blank" rel="noopener" class="block">
                    <img src="/service-requests/{{ tx.id }}/file" alt="ডেলিভারি ফাইল"
                         class="w-full rounded-xl border border-neutral-200 object-contain" loading="lazy">
                </a>
                <p class="mt-2.5 text-center text-xs text-neutral-400">বড় করে দেখতে ছবিতে ক্লিক করুন</p>
            {% else %}
                <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-6 text-center">
                    <p class="text-sm text-neutral-600">{{ tx.deliverable_mime ?? 'ফাইল' }}</p>
                    <a href="/service-requests/{{ tx.id }}/file" class="btn btn-primary btn-sm mt-3"
                       target="_blank" rel="noopener">
                        {{ icon('arrow-down', 'w-4 h-4') }} ডাউনলোড করে দেখুন
                    </a>
                </div>
            {% endif %}

            {% if tx.deliverable_name %}
                <p class="mt-3 truncate text-xs text-neutral-400">
                    {{ tx.deliverable_name }}{% if fileSize %} · {{ fileSize }}{% endif %}
                    {% if tx.deliverable_uploaded_at %} · {{ tx.deliverable_uploaded_at|bndate }}{% endif %}
                </p>
            {% endif %}

            <form method="post" action="/admin/transactions/{{ tx.id }}" enctype="multipart/form-data"
                  class="mt-5 space-y-4 border-t border-neutral-100 pt-5" x-data="{ busy: false, tooBig: false }"
                  @submit="if (busy) { $event.preventDefault(); return; } busy = true;">
                <input type="hidden" name="_csrf" value="{{ csrf }}">

                <div>
                    <label for="at_file" class="form-label">
                        {{ tx.deliverable_path ? 'ফাইল বদলান (পুরনোটি মুছে যাবে)' : 'ফাইল আপলোড করুন' }}
                    </label>
                    <input id="at_file" type="file" name="deliverable" required
                           accept="{{ acceptTypes }}"
                           class="form-input file:mr-3 file:rounded-lg file:border-0 file:bg-primary-50 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-primary-700"
                           x-ref="input"
                           @change="const f = $event.target.files[0];
                                    if (f && f.size > {{ maxBytes }}) { $event.target.value = ''; tooBig = true; }
                                    else { tooBig = false; }">
                    <p class="form-help">
                        সর্বোচ্চ {{ (maxBytes / 1024 / 1024)|round(0) }} MB —
                        {{ allowedExtensions|join(', ')|upper }} গ্রহণযোগ্য।
                    </p>
                    <p class="form-error" role="alert" x-show="tooBig" x-cloak>
                        ফাইলটি {{ (maxBytes / 1024 / 1024)|round(0) }} MB-এর বড় — ছোট করে আবার চেষ্টা করুন।
                    </p>
                </div>

                <button type="submit" name="do" value="attach" class="btn btn-primary w-full" :disabled="busy">
                    <span x-show="!busy" class="inline-flex items-center gap-2">
                        {{ icon('upload', 'w-4 h-4') }} আপলোড করুন
                    </span>
                    <span x-show="busy" x-cloak class="inline-flex items-center gap-2">
                        {{ icon('loader', 'w-4 h-4 animate-spin') }} আপলোড হচ্ছে…
                    </span>
                </button>
            </form>

            {% if tx.deliverable_path %}
                <form method="post" action="/admin/transactions/{{ tx.id }}" class="mt-3">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <button type="submit" name="do" value="detach" class="btn btn-ghost w-full text-danger-600"
                            onclick="return confirm('ফাইলটি স্থায়ীভাবে মুছে ফেলবেন? ইউজার আর ডাউনলোড করতে পারবে না।');">
                        {{ icon('trash-2', 'w-4 h-4') }} ফাইলটি মুছে ফেলুন
                    </button>
                </form>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
