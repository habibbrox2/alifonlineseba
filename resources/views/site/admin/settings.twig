{% extends 'layouts/dashboard.twig' %}

{% block title %}সাইট সেটিংস — Admin{% endblock %}

{% block dashboard_content %}
{% include 'components/page-header.twig' with {
    title: 'সাইট সেটিংস',
    description: 'সাইটের তথ্য, যোগাযোগ ও সোশ্যাল লিংক এখানে আপডেট করুন — পাবলিক পেজের ফুটারে সাথে সাথে দেখা যাবে।',
} %}

<form method="post" action="/admin/settings" class="max-w-2xl space-y-5" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <div class="card p-5">
        <h2 class="mb-4 flex items-center gap-2 text-base font-bold text-neutral-800">
            {{ icon('info', 'w-4 h-4 text-primary-600') }} সাইট তথ্য
        </h2>
        <div class="space-y-4">
            <div>
                <label for="f-tagline" class="form-label">ট্যাগলাইন</label>
                <input type="text" id="f-tagline" name="site_tagline" value="{{ settings.site_tagline }}" class="form-input" maxlength="200" placeholder="ইনস্ট্যান্ট ডিজিটাল সার্ভিস প্ল্যাটফর্ম">
                {% if errors.site_tagline is defined %}<p class="form-error">{{ errors.site_tagline }}</p>{% endif %}
            </div>
            <div>
                <label for="f-footer-note" class="form-label">ফুটার নোট</label>
                <textarea id="f-footer-note" name="footer_note" rows="2" class="form-input" maxlength="500" placeholder="ফুটারে দেখানো নোট বা ছোট বিবরণী">{{ settings.footer_note }}</textarea>
                {% if errors.footer_note is defined %}<p class="form-error">{{ errors.footer_note }}</p>{% endif %}
            </div>
        </div>
    </div>

    <div class="card p-5">
        <h2 class="mb-4 flex items-center gap-2 text-base font-bold text-neutral-800">
            {{ icon('send', 'w-4 h-4 text-primary-600') }} যোগাযোগ
        </h2>
        <div class="space-y-4">
            <div>
                <label for="f-email" class="form-label">ইমেইল</label>
                <input type="email" id="f-email" name="contact_email" value="{{ settings.contact_email }}" class="form-input" maxlength="200" placeholder="support@example.com">
                {% if errors.contact_email is defined %}<p class="form-error">{{ errors.contact_email }}</p>{% endif %}
            </div>
            <div>
                <label for="f-phone" class="form-label">ফোন</label>
                <input type="tel" id="f-phone" name="contact_phone" value="{{ settings.contact_phone }}" class="form-input" maxlength="20" placeholder="+8801XXXXXXXXX">
                {% if errors.contact_phone is defined %}<p class="form-error">{{ errors.contact_phone }}</p>{% endif %}
            </div>
        </div>
    </div>

    <div class="card p-5">
        <h2 class="mb-4 flex items-center gap-2 text-base font-bold text-neutral-800">
            {{ icon('globe', 'w-4 h-4 text-primary-600') }} সোশ্যাল লিংক
        </h2>
        <p class="mb-4 text-xs text-neutral-500">খালি রাখলে ফুটারে দেখানো হবে না। সম্পূর্ণ http(s) লিংক দিন।</p>
        <div class="space-y-4">
            <div>
                <label for="f-facebook" class="form-label">ফেসবুক পেজ</label>
                <input type="url" id="f-facebook" name="facebook_url" value="{{ settings.facebook_url }}" class="form-input" maxlength="500" placeholder="https://facebook.com/yourpage">
                {% if errors.facebook_url is defined %}<p class="form-error">{{ errors.facebook_url }}</p>{% endif %}
            </div>
            <div>
                <label for="f-youtube" class="form-label">ইউটিউব চ্যানেল</label>
                <input type="url" id="f-youtube" name="youtube_url" value="{{ settings.youtube_url }}" class="form-input" maxlength="500" placeholder="https://youtube.com/@yourchannel">
                {% if errors.youtube_url is defined %}<p class="form-error">{{ errors.youtube_url }}</p>{% endif %}
            </div>
            <div>
                <label for="f-whatsapp" class="form-label">হোয়াটসঅ্যাপ</label>
                <input type="url" id="f-whatsapp" name="whatsapp_url" value="{{ settings.whatsapp_url }}" class="form-input" maxlength="500" placeholder="https://wa.me/8801XXXXXXXXX">
                {% if errors.whatsapp_url is defined %}<p class="form-error">{{ errors.whatsapp_url }}</p>{% endif %}
            </div>
            <div>
                <label for="f-telegram" class="form-label">টেলিগ্রাম</label>
                <input type="url" id="f-telegram" name="telegram_url" value="{{ settings.telegram_url }}" class="form-input" maxlength="500" placeholder="https://t.me/yourchannel">
                {% if errors.telegram_url is defined %}<p class="form-error">{{ errors.telegram_url }}</p>{% endif %}
            </div>
        </div>
    </div>

    <div class="card p-5">
        <h2 class="mb-4 flex items-center gap-2 text-base font-bold text-neutral-800">
            {{ icon('wallet', 'w-4 h-4 text-primary-600') }} রিচার্জ সেটিংস
        </h2>
        <p class="mb-4 text-xs text-neutral-500">ইউজারের রিচার্জ অনুরোধ পেতে যাচাই করার সময় এই নিয়মগুলো মানা হবে।</p>
        <div class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="f-topup-min" class="form-label">সর্বনিম্ন পরিমাণ (৳)</label>
                    <input type="number" id="f-topup-min" name="topup_min_amount" min="1" step="0.01"
                           value="{{ settings.topup_min_amount }}" class="form-input" placeholder="10">
                    {% if errors.topup_min_amount is defined %}<p class="form-error">{{ errors.topup_min_amount }}</p>{% endif %}
                </div>
                <div>
                    <label for="f-topup-max" class="form-label">সর্বোচ্চ পরিমাণ (৳)</label>
                    <input type="number" id="f-topup-max" name="topup_max_amount" min="1" step="0.01"
                           value="{{ settings.topup_max_amount }}" class="form-input" placeholder="100000">
                    {% if errors.topup_max_amount is defined %}<p class="form-error">{{ errors.topup_max_amount }}</p>{% endif %}
                </div>
            </div>

            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-neutral-200 px-4 py-3">
                <input type="checkbox" name="topup_receipt_required" value="1"
                       {{ settings.topup_receipt_required == '1' ? 'checked' }}
                       class="mt-0.5 rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                <span>
                    <span class="block text-sm font-semibold text-neutral-800">রশিদ বাধ্যতামূলক</span>
                    <span class="block text-xs text-neutral-500">বন্ধ করলে ইউজার রশিদ ছাড়াই অনুরোধ জমা দিতে পারবেন।</span>
                </span>
            </label>

            <div>
                <label for="f-topup-note" class="form-label">রিচার্জ নির্দেশনা</label>
                <textarea id="f-topup-note" name="topup_note" rows="4" class="form-input" maxlength="1000"
                          placeholder="যেমন: bKash দিয়ে পাঠিয়ে TrxID ও রশিদ আপলোড করুন। যাচাই সাধারণত ২৪ ঘণ্টার মধ্যে হয়।">{{ settings.topup_note }}</textarea>
                <p class="mt-1 text-xs text-neutral-400">ইউজারের রিচার্জ পেজের উপরে এই নির্দেশনা দেখানো হবে।</p>
            </div>

            <div class="border-t border-neutral-100 pt-4">
                <p class="form-label">পার্সোনাল ওয়ালেট নম্বর</p>
                <p class="mb-3 text-xs text-neutral-500">রিচার্জের ২য় ধাপে ইউজার যে নম্বরে টাকা পাঠাবেন।</p>
                <div class="grid gap-4 sm:grid-cols-3">
                    <div>
                        <label for="f-wallet-bkash" class="form-label">bKash</label>
                        <input type="text" id="f-wallet-bkash" name="wallet_bkash" value="{{ settings.wallet_bkash }}"
                               class="form-input" inputmode="tel" placeholder="013XXXXXXXX">
                    </div>
                    <div>
                        <label for="f-wallet-nagad" class="form-label">Nagad</label>
                        <input type="text" id="f-wallet-nagad" name="wallet_nagad" value="{{ settings.wallet_nagad }}"
                               class="form-input" inputmode="tel" placeholder="013XXXXXXXX">
                    </div>
                    <div>
                        <label for="f-wallet-rocket" class="form-label">Rocket</label>
                        <input type="text" id="f-wallet-rocket" name="wallet_rocket" value="{{ settings.wallet_rocket }}"
                               class="form-input" inputmode="tel" placeholder="013XXXXXXXX">
                    </div>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="f-quick-amounts" class="form-label">দ্রুত এমাউন্ট বাটন</label>
                    <input type="text" id="f-quick-amounts" name="topup_quick_amounts" value="{{ settings.topup_quick_amounts }}"
                           class="form-input" placeholder="50,100,300,500,2000">
                    <p class="mt-1 text-xs text-neutral-400">কমা দিয়ে আলাদা করুন।</p>
                </div>
                <div>
                    <label for="f-offer-text" class="form-label">রিচার্জ অফার ব্যানার</label>
                    <input type="text" id="f-offer-text" name="topup_offer_text" value="{{ settings.topup_offer_text }}"
                           class="form-input" maxlength="300" placeholder="🔥 বিশেষ অফার…">
                    <p class="mt-1 text-xs text-neutral-400">রিচার্জ পেজের উপরে ব্যানার হিসেবে দেখাবে।</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card p-5">
        <h2 class="mb-4 flex items-center gap-2 text-base font-bold text-neutral-800">
            {{ icon('megaphone', 'w-4 h-4 text-primary-600') }} জরুরি নোটিশ (পপ-আপ)
        </h2>
        <p class="mb-4 text-xs text-neutral-500">লগইন ও ড্যাশবোর্ডে একবার দেখানো হবে — ইউজার বন্ধ করলে সেশনে মনে থাকে।</p>
        <div class="space-y-4">
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-neutral-200 px-4 py-3">
                <input type="checkbox" name="notice_enabled" value="1"
                       {{ settings.notice_enabled == '1' ? 'checked' }}
                       class="mt-0.5 rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                <span>
                    <span class="block text-sm font-semibold text-neutral-800">নোটিশ চালু</span>
                    <span class="block text-xs text-neutral-500">বন্ধ থাকলে কোথাও দেখানো হবে না।</span>
                </span>
            </label>
            <div>
                <label for="f-notice-title" class="form-label">শিরোনাম</label>
                <input type="text" id="f-notice-title" name="notice_title" value="{{ settings.notice_title }}"
                       class="form-input" maxlength="120" placeholder="জরুরি নোটিশ">
            </div>
            <div>
                <label for="f-notice-body" class="form-label">বিবরণ</label>
                <textarea id="f-notice-body" name="notice_body" rows="3" class="form-input" maxlength="1000"
                          placeholder="আমাদের সকল সম্মানিত রেগুলার কাস্টমারদের…">{{ settings.notice_body }}</textarea>
            </div>
        </div>
    </div>

    <div class="card p-5">
        <h2 class="mb-4 flex items-center gap-2 text-base font-bold text-neutral-800">
            {{ icon('gift', 'w-4 h-4 text-primary-600') }} রেফারেল প্রোগ্রাম (বন্ধুকে রেফার করুন)
        </h2>
        <p class="mb-4 text-xs text-neutral-500">
            ইউজার নিবন্ধনের সময় <code class="rounded bg-neutral-100 px-1 py-0.5 text-[11px]">?ref=কোড</code> লিংক থেকে আসে।
            বন্ধু যখন <strong>নির্ধারিত সংখ্যক অনুমোদিত রিচার্জ</strong> সম্পন্ন করবেন, তখন দুই পাশেই বোনাস ব্যালেন্সে যোগ হয় — নিবন্ধনের সময় নয়।
            <a href="/admin/referrals" class="font-semibold text-primary-600 hover:underline">রেফারেল তালিকা দেখুন →</a>
        </p>
        <div class="space-y-4">
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-neutral-200 px-4 py-3">
                <input type="checkbox" name="referral_enabled" value="1"
                       {{ settings.referral_enabled == '1' ? 'checked' }}
                       class="mt-0.5 rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                <span>
                    <span class="block text-sm font-semibold text-neutral-800">রেফারেল সিস্টেম চালু</span>
                    <span class="block text-xs text-neutral-500">
                        বন্ধ করলে নতুন কোড কাজ করবে না। ইতিমধ্যে অপেক্ষমাণ থাকা রেফারেল আগের শর্তে পরিশোধ হবে।
                    </span>
                </span>
            </label>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="f-ref-required" class="form-label">প্রয়োজনীয় সফল রিচার্জ সংখ্যা</label>
                    <input type="number" id="f-ref-required" name="referral_required_recharges" min="1" max="1000" step="1"
                           value="{{ settings.referral_required_recharges }}" class="form-input" placeholder="5">
                    <p class="mt-1 text-xs text-neutral-400">
                        বন্ধুর যতটি অনুমোদিত রিচার্জ এই সংখ্যক হবে, ততটি হলেই বোনাস দুই পাশেই পরিশোধ হবে।
                        ১ দিলে প্রথম অনুমোদিত রিচার্জেই বোনাস দেওয়া হবে।
                    </p>
                    {% if errors.referral_required_recharges is defined %}<p class="form-error">{{ errors.referral_required_recharges }}</p>{% endif %}
                </div>
                <div>
                    <label for="f-ref-qualmin" class="form-label">প্রতিটি রিচার্জ সর্বনিম্ন (৳)</label>
                    <input type="number" id="f-ref-qualmin" name="referral_min_qualifying_recharge" min="0" max="1000000" step="0.01"
                           value="{{ settings.referral_min_qualifying_recharge }}" class="form-input" placeholder="100">
                    <p class="mt-1 text-xs text-neutral-400">
                        এই পরিমাণের বেশি রিচার্জগুলোই গোনা হবে। ০ দিলে যেকোনো অনুমোদিত রিচার্জই গোনা হবে।
                    </p>
                    {% if errors.referral_min_qualifying_recharge is defined %}<p class="form-error">{{ errors.referral_min_qualifying_recharge }}</p>{% endif %}
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
                <div>
                    <label for="f-ref-referrer" class="form-label">রেফারকারীর বোনাস (৳)</label>
                    <input type="number" id="f-ref-referrer" name="referrer_bonus_amount" min="0" max="100000" step="0.01"
                           value="{{ settings.referrer_bonus_amount }}" class="form-input" placeholder="50">
                    <p class="mt-1 text-xs text-neutral-400">যিনি বন্ধুকে রেফার করেছেন তাঁর ব্যালেন্সে যাবে।</p>
                    {% if errors.referrer_bonus_amount is defined %}<p class="form-error">{{ errors.referrer_bonus_amount }}</p>{% endif %}
                </div>
                <div>
                    <label for="f-ref-referee" class="form-label">নতুন ইউজারের বোনাস (৳)</label>
                    <input type="number" id="f-ref-referee" name="referee_bonus_amount" min="0" max="100000" step="0.01"
                           value="{{ settings.referee_bonus_amount }}" class="form-input" placeholder="20">
                    <p class="mt-1 text-xs text-neutral-400">বন্ধুর ব্যালেন্সে যাবে, রিচার্জ শেষ হওয়ার পর।</p>
                    {% if errors.referee_bonus_amount is defined %}<p class="form-error">{{ errors.referee_bonus_amount }}</p>{% endif %}
                </div>
                <div>
                    <label for="f-ref-min" class="form-label">প্রথম রিচার্জ সর্বনিম্ন (৳)</label>
                    <input type="number" id="f-ref-min" name="referral_min_first_recharge" min="0" max="1000000" step="0.01"
                           value="{{ settings.referral_min_first_recharge }}" class="form-input" placeholder="100">
                    <p class="mt-1 text-xs text-neutral-400">
                        পুরোনো এক-রিচার্জ নিয়মের সেটিং। নতুন রেফারেলে <span class="font-medium">প্রতিটি রিচার্জ সর্বনিম্ন</span> ব্যবহার হবে;
                        এটি অপেক্ষমাণ রেফারেলের জন্য ব্যাকআপ হিসেবে থাকে।
                    </p>
                    {% if errors.referral_min_first_recharge is defined %}<p class="form-error">{{ errors.referral_min_first_recharge }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label for="f-ref-terms" class="form-label">শর্তাবলী</label>
                <textarea id="f-ref-terms" name="referral_terms" rows="3" class="form-input" maxlength="1000"
                          placeholder="বন্ধুকে রেফার করে বোনাস পান — শর্তাবলী">{{ settings.referral_terms }}</textarea>
                <p class="mt-1 text-xs text-neutral-400">ইউজারের রেফারেল পেজে এই লেখাটি দেখানো হবে।</p>
                {% if errors.referral_terms is defined %}<p class="form-error">{{ errors.referral_terms }}</p>{% endif %}
            </div>

            <p class="rounded-lg bg-info-50 px-3 py-2 text-xs text-info-800">
                {{ icon('info', 'w-3.5 h-3.5 inline-block align-text-bottom') }}
                বোনাসের পরিমাণ নিবন্ধনের সময়ই ফ্রিজ হয়ে যায় — অপেক্ষমাণ থাকা রেফারেলে আগের পরিমাণই পরিশোধ হবে।
            </p>
        </div>
    </div>

    <div class="card p-5">
        <h2 class="mb-4 flex items-center gap-2 text-base font-bold text-neutral-800">
            {{ icon('clock', 'w-4 h-4 text-primary-600') }} সার্ভিস অর্ডারের সময়
        </h2>
        <p class="mb-4 text-xs text-neutral-500">
            এই সময়ের বাইরে ইউজার নতুন সার্ভিস অর্ডার করতে পারবে না। সময় গণনা হয় বাংলাদেশ মান সময় (Asia/Dhaka) অনুযায়ী।
        </p>
        <div class="space-y-4">
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-neutral-200 px-4 py-3">
                <input type="checkbox" name="order_window_enabled" value="1"
                       {{ settings.order_window_enabled == '1' ? 'checked' }}
                       class="mt-0.5 rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                <span>
                    <span class="block text-sm font-semibold text-neutral-800">নির্দিষ্ট সময়ে অর্ডার চালু</span>
                    <span class="block text-xs text-neutral-500">বন্ধ করলে দিনে ২৪ ঘণ্টা অর্ডার করা যাবে।</span>
                </span>
            </label>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="f-window-start" class="form-label">অর্ডার শুরুর সময়</label>
                    <input type="time" id="f-window-start" name="order_window_start" value="{{ settings.order_window_start }}"
                           class="form-input">
                    {% if errors.order_window_start is defined %}<p class="form-error">{{ errors.order_window_start }}</p>{% endif %}
                </div>
                <div>
                    <label for="f-window-end" class="form-label">অর্ডার শেষের সময়</label>
                    <input type="time" id="f-window-end" name="order_window_end" value="{{ settings.order_window_end }}"
                           class="form-input">
                    {% if errors.order_window_end is defined %}<p class="form-error">{{ errors.order_window_end }}</p>{% endif %}
                </div>
            </div>

            <p class="rounded-lg bg-info-50 px-3 py-2 text-xs text-info-800">
                {{ icon('info', 'w-3.5 h-3.5 inline-block align-text-bottom') }}
                শেষের সময়ের পর আবার শুরুর সময় পর্যন্ত (যেমন রাত ১০টা থেকে সকাল ৬টা) অর্ডার বন্ধ থাকবে।
                ইতিমধ্যে জমা দেওয়া অর্ডার চালু করা বা বাতিল করায় এই সময়ের কোনো প্রভাব পড়ে না।
            </p>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        {{ icon('save', 'w-4 h-4') }} সংরক্ষণ করুন
    </button>
</form>
{% endblock %}
