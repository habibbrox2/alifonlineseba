{% extends 'layouts/dashboard.twig' %}

{% block title %}স্টাফ পরিচালনা — Admin{% endblock %}

{% block dashboard_content %}
{% set headActions %}
    <a href="/admin/withdraws" class="btn btn-sm btn-ghost">{{ icon('send', 'w-4 h-4') }} উত্তোলন অনুরোধ</a>
{% endset %}
{% include 'components/page-header.twig' with {
    title: 'স্টাফ পরিচালনা',
    description: 'কারা অর্ডার অনুমোদন করতে পারবে, কারা টাকা উত্তোলনের সিদ্ধান্ত নিতে পারবে — এবং কে কত আয় করেছেন',
    actions: headActions,
} %}

{# The two roles that are not interchangeable, stated once at the top.

   An `admin` earns money by approving orders. A `superadmin` additionally
   decides payouts and appoints staff. Keeping them apart is what stops one
   person approving their own withdrawal — see AdminWithdrawService::approve(). #}
<div class="mb-6 rounded-xl border border-info-200 bg-info-50 px-4 py-3 text-sm text-info-900">
    <p class="font-semibold">ভূমিকা কী বোঝায়:</p>
    <ul class="mt-1.5 list-inside list-disc space-y-0.5 text-[13px]">
        <li><strong>এডমিন</strong> — অর্ডার যাচাই ও অনুমোদন করতে পারে, অনুমোদনে টাকা আয় হয়, নিজে উত্তোলনের অনুরোধ করতে পারে।</li>
        <li><strong>স্টাফ</strong> — অর্ডার যাচাই করতে পারে, কিন্তু অনুমোদনে টাকা আয় হয় না।</li>
        <li><strong>সুপারএডমিন</strong> — সবকিছুর পাশাপাশি উত্তোলন অনুমোদন ও স্টাফ নিয়োগ/পদমুক্তির ক্ষমতা।</li>
    </ul>
</div>

{# Search and filter bar #}
<div class="mb-5 flex flex-wrap items-center gap-2">
    <form method="get" action="/admin/staff" class="flex flex-1 sm:max-w-md gap-2">
        <input type="search" name="q" value="{{ q }}" class="form-input" placeholder="নাম, ইউজারনেম, ইমেইল, মোবাইল দিয়ে খুঁজুন…">
        <button type="submit" class="btn btn-primary btn-sm">{{ icon('search', 'w-4 h-4') }} খুঁজুন</button>
    </form>

    {% set currentFilter = trashedFilter|default('exclude') %}
    <div class="flex items-center gap-2 ml-auto sm:ml-0">
        <span class="text-sm text-neutral-500">{{ icon('filter', 'w-4 h-4 inline-block align-text-bottom') }} ফিল্টার:</span>
        <a href="/admin/staff" class="btn btn-sm {{ currentFilter == 'exclude' ? 'btn-primary' : 'btn-ghost' }}">সক্রিয় স্টাফ</a>
        <a href="/admin/staff?trashed=only" class="btn btn-sm {{ currentFilter == 'only' ? 'btn-primary' : 'btn-ghost' }}">
            {{ icon('alert-triangle', 'w-4 h-4') }} ট্র্যাশ ({{ trashedCount|default(0) }})
        </a>
        <a href="/admin/staff?trashed=all" class="btn btn-sm {{ currentFilter == 'all' ? 'btn-primary' : 'btn-ghost' }}">সবাই দেখুন</a>
        {% if trashedCount|default(0) > 0 %}
        <form method="post" action="/admin/staff" onsubmit="return confirm('ট্র্যাশের সব স্টাফ ফিরিয়ে আনবেন?')">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="id" value="0">
            <input type="hidden" name="do" value="restore_all">
            <button type="submit" class="btn btn-sm">
                {{ icon('history', 'w-4 h-4') }} সব ফিরিয়ে আনুন
            </button>
        </form>
        {% endif %}
    </div>
</div>

<div class="card overflow-hidden">
    {% if staff is empty %}
        <div class="flex flex-col items-center gap-2 px-4 py-12 text-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                {{ icon('users', 'w-6 h-6') }}
            </span>
            <p class="text-sm text-neutral-500">
                {% if currentFilter == 'only' %}ট্র্যাশে কোনো স্টাফ নেই।
                {% elseif q %}“{{ q }}” অনুসন্ধানে কোনো স্টাফ পাওয়া যায়নি।
                {% else %}কোনো স্টাফ অ্যাকাউন্ট নেই।{% endif %}
            </p>
        </div>
    {% else %}
    <div class="overflow-x-auto">
        <table class="table-base">
            <thead>
                <tr>
                    {% include 'components/sortable-header.twig' with { label: 'অ্যাকাউন্ট', column: 'username', sort: sort, dir: dir, base: baseUrl } %}
                    {% include 'components/sortable-header.twig' with { label: 'ইমেইল', column: 'email', sort: sort, dir: dir, base: baseUrl } %}
                    {% include 'components/sortable-header.twig' with { label: 'ভূমিকা', column: 'role', sort: sort, dir: dir, base: baseUrl } %}
                    {% include 'components/sortable-header.twig' with { label: 'অবস্থা', column: 'status', sort: sort, dir: dir, base: baseUrl } %}
                    <th class="text-right">{{ icon('dollar-sign', 'w-4 h-4') }} ব্যালেন্স</th>
                    <th class="text-right">{{ icon('trending-up', 'w-4 h-4') }} আয়</th>
                    <th class="text-right">{{ icon('trending-down', 'w-4 h-4') }} উত্তোলন</th>
                    <th class="text-right">{{ icon('shopping-cart', 'w-4 h-4') }} অর্ডার</th>
                    {% include 'components/sortable-header.twig' with { label: 'শেষ লগইন', column: 'last_login_at', sort: sort, dir: dir, base: baseUrl, right: true } %}
                    <th class="text-right">ব্যবস্থাপনা</th>
                </tr>
            </thead>
            <tbody>
                {% for member in staff %}
                    {% set money = earnings[member.id] ?? { earned: 0, withdrawn: 0, orders: 0 } %}
                    <tr class="{{ member.deleted_at ? 'opacity-50' : '' }}">
                        <td>
                            <p class="font-medium text-neutral-800">
                                {{ member.full_name ?: member.username }}
                                {% if member.id == identity.id %}
                                    <span class="ml-1 text-[10px] text-neutral-400">(আপনি)</span>
                                {% endif %}
                            </p>
                            <p class="text-xs text-neutral-400">@{{ member.username }} · {{ member.phone }}</p>
                        </td>
                        <td class="text-sm text-neutral-600">{{ member.email ?: '—' }}</td>
                        <td>
                            {% if member.role == 'superadmin' %}
                                <span class="badge badge-primary">{{ icon('crown', 'w-3 h-3') }} {{ roleLabels[member.role] }}</span>
                            {% else %}
                                <span class="badge badge-neutral">{{ roleLabels[member.role] ?? member.role }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% include 'components/status-badge.twig' with { status: member.status } %}
                            {% if member.deleted_at %}
                                <span class="mt-1 block text-[10px] text-danger-600">ট্র্যাশে</span>
                            {% endif %}
                        </td>
                        <td class="text-right font-semibold text-neutral-800">{{ member.balance|money }}</td>
                        <td class="text-right text-success-700">{{ money.earned|money }}</td>
                        <td class="text-right text-neutral-600">{{ money.withdrawn|money }}</td>
                        <td class="text-right text-info-700">{{ money.orders }}</td>
                        <td class="whitespace-nowrap text-xs text-neutral-500 text-right">{{ member.last_login_at ? member.last_login_at|bndate : '—' }}</td>
                        <td>
                            {% if member.id == identity.id %}
                                <span class="text-xs text-neutral-400">—</span>
                            {% elseif member.role == 'superadmin' and not identity.isSuperAdmin() %}
                                <span class="text-xs text-neutral-400">সুপারএডমিন — সম্পাদনা অসম্ভব</span>
                            {% else %}
                                {# Role and status are separate forms rather than one
                                   combined control: they are separate decisions with
                                   separate consequences, and a single dropdown would
                                   let a typo demote somebody and suspend them at
                                   the same time. #}
                                <div class="flex flex-col items-end gap-1.5">
                                    {% if can_access(identity, 'admin-staff-role-update') %}
                                    <form method="post" action="/admin/staff" class="flex items-center gap-1.5">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <input type="hidden" name="id" value="{{ member.id }}">
                                        <select name="role" class="form-input form-input-sm py-1 text-xs"
                                                aria-label="{{ member.username }} এর ভূমিকা"
                                                onchange="this.form.requestSubmit()">
                                            {% for role in ['superadmin', 'admin', 'staff', 'user'] %}
                                                <option value="{{ role }}" {{ member.role == role ? 'selected' }}>
                                                    {{ roleLabels[role] }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                        <noscript><button type="submit" class="btn btn-ghost btn-sm">সংরক্ষণ</button></noscript>
                                    </form>
                                    {% else %}
                                    <select class="form-input form-input-sm py-1 text-xs opacity-50 cursor-not-allowed" disabled>
                                        <option value="{{ member.role }}" selected>
                                            {{ roleLabels[member.role] }}
                                        </option>
                                    </select>
                                    {% endif %}

                                    {% if can_access(identity, 'admin-staff-status-update') %}
                                    <form method="post" action="/admin/staff">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <input type="hidden" name="id" value="{{ member.id }}">
                                        <input type="hidden" name="status"
                                               value="{{ member.status == 'active' ? 'suspended' : 'active' }}">
                                        <button type="submit" name="do" value="status" class="btn btn-ghost btn-sm">
                                            {% if member.status == 'active' %}
                                                {{ icon('user-x', 'w-3.5 h-3.5') }} নিষ্ক্রিয় করুন
                                            {% else %}
                                                {{ icon('user-check', 'w-3.5 h-3.5') }} সক্রিয় করুন
                                            {% endif %}
                                        </button>
                                    </form>
                                    {% else %}
                                    <button type="button" class="btn btn-ghost btn-sm opacity-50 cursor-not-allowed" disabled>
                                        {% if member.status == 'active' %}
                                            {{ icon('user-x', 'w-3.5 h-3.5') }} নিষ্ক্রিয় করুন
                                        {% else %}
                                            {{ icon('user-check', 'w-3.5 h-3.5') }} সক্রিয় করুন
                                        {% endif %}
                                    </button>
                                    {% endif %}

                                    {% if can_access(identity, 'admin-staff-password-reset') %}
                                    {# Password reset is a recovery path, not a
                                       convenience: without it the panel drifts
                                       towards shared logins, which defeats having
                                       roles at all. It is a <details> so it does
                                       not sit on the table as an invitation. #}
                                    <details class="text-right">
                                        <summary class="cursor-pointer text-[11px] text-neutral-400 hover:text-neutral-600">
                                            পাসওয়ার্ড সেট করুন
                                        </summary>
                                        <form method="post" action="/admin/staff" class="mt-1.5 flex items-center gap-1.5">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="id" value="{{ member.id }}">
                                            <input type="password" name="password" minlength="8" required
                                                   class="form-input py-1 text-xs" placeholder="কমপক্ষে ৮ অক্ষর"
                                                   aria-label="{{ member.username }} এর নতুন পাসওয়ার্ড">
                                            <button type="submit" name="do" value="password" class="btn btn-ghost btn-sm">
                                                {{ icon('key', 'w-3.5 h-3.5') }}
                                            </button>
                                        </form>
                                    </details>
                                    {% endif %}

                                    {% if member.deleted_at and can_access(identity, 'admin-users-restore') %}
                                    <form method="post" action="/admin/staff">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <input type="hidden" name="id" value="{{ member.id }}">
                                        <input type="hidden" name="do" value="restore">
                                        <button type="submit" class="btn btn-primary btn-xs px-2 py-1">
                                            {{ icon('history', 'w-3.5 h-3.5') }} রিস্টোর
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>

{% include 'components/pagination.twig' with {
    page: page, perPage: perPage, total: total,
    baseUrl: baseUrl ~ 'page=',
    sort: sort, dir: dir,
} %}

{% endblock %}