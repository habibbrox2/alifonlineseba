{% extends 'layouts/dashboard.twig' %}

{% block title %}রিচার্জ অনুরোধ — Admin{% endblock %}

{% block dashboard_content %}
{% set headActions %}
    {% if stats.unresolved > 0 %}
        <span class="badge badge-warning">{{ icon('bell', 'w-3.5 h-3.5') }} {{ stats.unresolved }}টি অপেক্ষমাণ</span>
    {% else %}
        <span class="badge badge-success">{{ icon('check-check', 'w-3.5 h-3.5') }} সব প্রক্রিয়া হয়েছে</span>
    {% endif %}
{% endset %}
{% include 'components/page-header.twig' with {
    title: 'রিচার্জ অনুরোধ',
    description: 'ইউজারের ব্যালেন্স টপ-আপ অনুরোধ — যাচাই করে অনুমোদন বা বাতিল করুন',
    actions: headActions,
} %}

<!-- Stat cards -->
<div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {% include 'components/stat-card.twig' with { label: 'মোট অনুরোধ', value: stats.total, icon: 'inbox', tone: 'info' } %}
    {% include 'components/stat-card.twig' with { label: 'অপেক্ষমাণ', value: stats.unresolved, icon: 'bell', tone: 'accent' } %}
    {% include 'components/stat-card.twig' with { label: 'অনুমোদিত', value: stats.approved, icon: 'check-circle', tone: 'success' } %}
    {% include 'components/stat-card.twig' with { label: 'বাতিলকৃত', value: stats.rejected, icon: 'alert-circle', tone: 'primary' } %}
    {% include 'components/stat-card.twig' with { label: 'অনুমোদিত টাকা', value: stats.approved_amount|money, icon: 'wallet', tone: 'info' } %}
</div>

{# Queue filter chips. Each one keeps the current search box and sort so
   narrowing by state never silently discards what the admin was looking for.
   "অপেক্ষমাণ" and "যাচাই-ধরা" are separate because they are separate jobs: the
   first is unclaimed work, the second is work somebody already owns. #}
{% set filterBase = (query ? 'q=' ~ query|url_encode ~ '&' : '') ~ (sort != 'created_at' or dir != 'desc' ? 'sort=' ~ sort ~ '&dir=' ~ dir ~ '&' : '') %}
<div class="mb-4 flex flex-wrap items-center gap-2">
    <span class="text-sm font-medium text-neutral-500">ফিল্টার:</span>
    <a href="/admin/topups?{{ filterBase }}"
       class="btn btn-sm {{ status == '' ? 'btn-primary' : 'btn-ghost' }}">সব</a>
    {% for st in statuses %}
        <a href="/admin/topups?{{ filterBase }}status={{ st }}"
           class="btn btn-sm {{ status == st ? 'btn-primary' : 'btn-ghost' }}">
            {{ st|statusbadge|raw }}
            <span class="ml-1 rounded-full bg-black/5 px-1.5 text-[11px]">{{ statusCounts[st] ?? 0 }}</span>
        </a>
    {% endfor %}
</div>

<!-- Filters -->
<form method="get" action="/admin/topups" class="mb-5 flex flex-wrap items-end gap-2">
    <div class="min-w-52 flex-1">
        <label for="f-q" class="sr-only">খুঁজুন</label>
        <input id="f-q" type="search" name="q" value="{{ query }}" class="form-input"
               placeholder="ইউজার, ফোন, TrxID বা ওয়ালেট নম্বর খুঁজুন…">
    </div>

    <select name="status" class="form-input sm:w-44" onchange="this.form.submit()">
        <option value="">সব স্ট্যাটাস</option>
        {% for st in statuses %}
            <option value="{{ st }}" {{ status == st ? 'selected' }}>{{ st|statusbadge }}</option>
        {% endfor %}
    </select>

    <input type="hidden" name="sort" value="{{ sort }}">
    <input type="hidden" name="dir" value="{{ dir }}">
    <button type="submit" class="btn btn-primary">{{ icon('search', 'w-4 h-4') }} খুঁজুন</button>
    {% if query or status %}
        <a href="/admin/topups" class="btn btn-ghost">ফিল্টার মুছুন</a>
    {% endif %}
</form>

{# Bulk approve: for payments the operator has already verified out of band.
   The form wraps the table so per-row ids[] checkboxes post with it. Every row
   is re-checked by TopupService, so a stale selection is a no-op. #}
<form method="post" action="/admin/topups" id="topup-bulk-form"
      onsubmit="return bulkConfirm(this);">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="do" value="bulk-approve">

    {# Only unclaimed `pending` rows get a checkbox. A `review` row belongs to
       the admin who claimed it and must be decided on their own desk. #}
    <div class="mb-3 flex flex-wrap items-center gap-2 rounded-xl border border-warning-200 bg-warning-50 px-4 py-3">
        <span class="text-sm font-semibold text-warning-800">
            {{ icon('check-check', 'w-3.5 h-3.5 inline') }}
            <span id="bulk-count">০</span>টি নির্বাচিত
        </span>
        <button type="button" class="btn btn-ghost btn-sm" data-action="toggle-all"
                data-label-on="সব অপেক্ষমাণ নির্বাচন করুন"
                data-label-off="নির্বাচন বাতিল করুন">
            {{ icon('check-check', 'w-3.5 h-3.5') }}
            <span data-role="toggle-label">সব অপেক্ষমাণ নির্বাচন করুন</span>
        </button>
        <button type="submit" class="btn btn-primary btn-sm ml-auto" disabled
                data-role="bulk-submit" data-n="{{ stats.pending }}">
            নির্বাচিতগুলো অনুমোদন করুন
        </button>
    </div>

<div class="card overflow-hidden">
    {# Empty state lives outside the <table>: .table-base carries a 640px min-width,
       so a centred message inside it would sit off-screen on a phone. It stays inside
       the bulk <form> so the "select all" counter stays consistent either way. #}
    {% if rows is empty %}
        <div class="flex flex-col items-center gap-2 px-4 py-12 text-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                {{ icon('inbox', 'w-6 h-6') }}
            </span>
            <p class="text-sm text-neutral-500">
                {% if query or status %}এই ফিল্টারে কোনো অনুরোধ পাওয়া যায়নি।
                {% else %}কোনো রিচার্জ অনুরোধ নেই।{% endif %}
            </p>
            {% if status == 'review' %}
                <p class="max-w-sm text-xs text-neutral-400">“যাচাই ধরা হয়েছে” বলতে কোনো অ্যাডমিন অনুরোধটি খুলে দেখছেন, কিন্তু এখনো সিদ্ধান্ত দেননি।</p>
            {% endif %}
        </div>
    {% else %}
    <div class="overflow-x-auto">
        <table class="table-base">
            <thead>
                <tr>
                    <th class="w-10">
                        <span class="sr-only">নির্বাচন</span>
                    </th>
                    <th>ইউজার</th>
                    {% include 'components/sortable-header.twig' with {
                        label: 'পরিমাণ', column: 'amount', sort: sort, dir: dir, right: true,
                        base: '/admin/topups?' ~ (status ? 'status=' ~ status ~ '&' : '') ~ (query ? 'q=' ~ query|url_encode ~ '&' : ''),
                    } %}
                    <th>মেথড</th>
                    <th>সেন্ডার / TrxID</th>
                    <th>রশিদ</th>
                    <th>স্ট্যাটাস</th>
                    {% include 'components/sortable-header.twig' with {
                        label: 'তারিখ', column: 'created_at', sort: sort, dir: dir,
                        base: '/admin/topups?' ~ (status ? 'status=' ~ status ~ '&' : '') ~ (query ? 'q=' ~ query|url_encode ~ '&' : ''),
                    } %}
                    <th class="text-right">অ্যাকশন</th>
                </tr>
            </thead>
            <tbody>
                {% for t in rows %}
                    <tr>
                        <td>
                            {% if t.status == 'pending' %}
                                <input type="checkbox" name="ids[]" value="{{ t.id }}"
                                       data-role="row-check"
                                       aria-label="{{ t.username ?? 'ইউজার' }} এর অনুরোধ নির্বাচন করুন"
                                       class="rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                            {% endif %}
                        </td>
                        <td>
                            <p class="font-medium text-neutral-800">{{ t.username ?? '—' }}</p>
                            <p class="text-xs text-neutral-400">{{ t.phone ?? '' }}</p>
                        </td>
                        <td class="text-right font-semibold text-primary-700">{{ t.amount|money }}</td>
                        <td class="whitespace-nowrap text-sm text-neutral-600">{{ methods[t.method] ?? t.method|upper }}</td>
                        <td>
                            <p class="text-sm text-neutral-700">{{ t.sender_number ?? '—' }}</p>
                            {% if t.reference %}
                                <p class="font-mono text-xs text-neutral-400">{{ t.reference }}</p>
                            {% endif %}
                        </td>
                        <td>
                            {% if t.receipt_path %}
                                <a href="/recharge/receipt/{{ t.id }}" target="_blank" rel="noopener"
                                   class="inline-flex items-center gap-1 text-xs font-semibold text-primary-700 hover:underline">
                                    {{ icon('receipt', 'w-3.5 h-3.5') }} রশিদ
                                </a>
                            {% else %}
                                <span class="text-xs text-neutral-300">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% include 'components/status-badge.twig' with { status: t.status } %}
                            {% if t.status == 'review' and t.claimed_at %}
                                <p class="mt-1 text-[10px] text-neutral-400">ধরা {{ t.claimed_at|bndate }}</p>
                            {% endif %}
                        </td>
                        <td class="whitespace-nowrap text-neutral-500">{{ t.created_at|bndate }}</td>
                        <td>
                            <div class="flex justify-end">
                                <a href="/admin/recharges/{{ t.id }}" class="btn btn-ghost btn-sm">
                                    {% if t.status == 'review' %}
                                        {{ icon('eye', 'w-3.5 h-3.5') }} খুলুন
                                    {% else %}
                                        {{ icon('search-check', 'w-3.5 h-3.5') }} যাচাই
                                    {% endif %}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
</form>

{% include 'components/pagination.twig' with {
    page: page, perPage: perPage, total: total,
    baseUrl: '/admin/topups?' ~ (status ? 'status=' ~ status ~ '&' : '') ~ (query ? 'q=' ~ query|url_encode ~ '&' : '') ~ 'page=',
    sort: sort, dir: dir,
} %}

<script>
(function () {
    'use strict';
    var form = document.getElementById('topup-bulk-form');
    if (!form) { return; }
    var checks = Array.prototype.slice.call(form.querySelectorAll('[data-role="row-check"]'));
    var count = form.querySelector('#bulk-count');
    var submit = form.querySelector('[data-role="bulk-submit"]');
    var toggle = form.querySelector('[data-action="toggle-all"]');
    var toggleLabel = form.querySelector('[data-role="toggle-label"]');
    var BN_DIGITS = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];

    function toBn(n) { return String(n).split('').map(function (c) { return BN_DIGITS[+c] || c; }).join(''); }

    function sync() {
        var picked = checks.filter(function (c) { return c.checked; }).length;
        if (count) { count.textContent = toBn(picked); }
        if (submit) { submit.disabled = picked === 0; }
        if (toggle && toggleLabel) {
            var all = checks.length > 0 && picked === checks.length;
            toggleLabel.textContent = all
                ? toggle.getAttribute('data-label-off')
                : toggle.getAttribute('data-label-on');
        }
    }

    form.addEventListener('change', function (e) {
        if (e.target && e.target.matches('[data-role="row-check"]')) { sync(); }
    });

    if (toggle) {
        toggle.addEventListener('click', function () {
            var all = checks.length > 0 && checks.every(function (c) { return c.checked; });
            checks.forEach(function (c) { c.checked = !all; });
            sync();
        });
    }

    window.bulkConfirm = function () {
        var picked = checks.filter(function (c) { return c.checked; }).length;
        if (picked === 0) { return false; }
        return window.confirm(
            'নির্বাচিত ' + toBn(picked) + 'টি অনুরোধ অনুমোদন করবেন? এতে ইউজারদের ব্যালেন্স যোগ হবে।'
        );
    };

    sync();
})();
</script>
{% endblock %}
