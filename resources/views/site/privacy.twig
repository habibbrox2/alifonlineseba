{% extends 'layouts/public.twig' %}

{% block title %}গোপনীয়তা নীতি — All Seba{% endblock %}
{% block description %}All Seba গোপনীয়তা নীতি — আমরা কী ডাটা সংরক্ষণ করি এবং কীভাবে ব্যবহার করি।{% endblock %}

{% block content %}
<section class="container-app py-12">
    <div class="mx-auto max-w-3xl">
        <h1 class="text-3xl font-extrabold text-neutral-900">গোপনীয়তা নীতি</h1>
        <div class="card mt-6 p-6 leading-relaxed text-neutral-600 sm:p-8">
            <p><em>সর্বশেষ হালনাগাদ: {{ 'now'|date('Y') }}</em></p>
            <h2 class="mt-6 text-lg font-bold text-neutral-900">১. তথ্য ব্যবহার</h2>
            <p class="mt-2">
                আমরা শুধু অর্ডার সম্পন্ন করার জন্য প্রয়োজনীয় তথ্যই সংগ্রহ ও সংরক্ষণ করি। এই তথ্য কোনো
                তৃতীয় পক্ষের সঙ্গে ভাগ করা হয় না এবং বিজ্ঞাপনের উদ্দেশ্যে ব্যবহার করা হয় না।
            </p>
            <h2 class="mt-6 text-lg font-bold text-neutral-900">২. যা সংরক্ষণ করা হয়</h2>
            <ul class="mt-2 list-disc space-y-1.5 pl-6">
                <li>অ্যাকাউন্ট তথ্য: ইউজারনেম, মোবাইল, (ঐচ্ছিক) ইমেইল — পাসওয়ার্ড শুধু হ্যাশ আকারে।</li>
                <li>সার্ভিস ব্যবহারের লগ (সুরক্ষা নিরীক্ষার জন্য): অ্যাকশন, আইপি, ব্রাউজার।</li>
                <li>অর্ডার ও লেনদেন রেফারেন্স — অর্ডার ইতিহাস রক্ষার জন্য।</li>
            </ul>
            <h2 class="mt-6 text-lg font-bold text-neutral-900">৩. কুকি</h2>
            <p class="mt-2">
                শুধুমাত্র সেশন পরিচালনার জন্য প্রয়োজনীয় কুকি ব্যবহার করা হয় (HttpOnly, SameSite)।
            </p>
        </div>
    </div>
</section>
{% endblock %}
