{% extends 'layouts/auth.twig' %}

{% block description %}নতুন পাসওয়ার্ড সেট করুন — All Seba।{% endblock %}
{% block robots %}noindex, follow{% endblock %}
{% block title %}নতুন পাসওয়ার্ড — All Seba{% endblock %}

{% block auth_content %}
<div class="rounded-2xl bg-white p-6 shadow-lg sm:p-8">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-extrabold text-neutral-900">নতুন পাসওয়ার্ড</h1>
        <p class="mt-1.5 text-sm text-neutral-500">
            {{ channel == 'email' ? 'ইমেইলের লিংক থেকে এসেছেন — নতুন পাসওয়ার্ড দিন।' : 'ইমেইল/হোয়াটসঅ্যাপ/টেলিগ্রামে পাওয়া কোড দিয়ে যাচাই করুন।' }}
        </p>
    </div>

    <form method="post" action="/reset-password" class="space-y-4" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        {# The link token rides in a hidden field rather than the query string:
           the POST body is where credentials belong, and a token in the action
           URL would be re-sent on every validation bounce. #}
        {% if channel == 'email' %}
            <input type="hidden" name="token" value="{{ token }}">
        {% else %}
            <div>
                <label for="code" class="form-label">ভেরিফিকেশন কোড</label>
                <input id="code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
                       maxlength="6" pattern="[0-9]{6}" class="form-input text-center font-mono text-xl tracking-[0.4em]"
                       placeholder="000000" required autofocus>
                {% if errors.code is defined %}<p class="form-error" role="alert">{{ errors.code }}</p>{% endif %}
            </div>
        {% endif %}
        {% if errors.token is defined %}<p class="form-error" role="alert">{{ errors.token }}</p>{% endif %}

        <div>
            <label for="password" class="form-label">নতুন পাসওয়ার্ড</label>
            <input id="password" type="password" name="password" class="form-input"
                   autocomplete="new-password" minlength="6" required>
        </div>
        <div>
            <label for="password_confirm" class="form-label">নতুন পাসওয়ার্ড আবার</label>
            <input id="password_confirm" type="password" name="password_confirm" class="form-input"
                   autocomplete="new-password" minlength="6" required>
            {% if errors.password_confirm is defined %}<p class="form-error" role="alert">{{ errors.password_confirm }}</p>{% endif %}
        </div>

        <button type="submit" class="btn btn-primary btn-block">পাসওয়ার্ড সেভ করুন</button>
    </form>

    <p class="mt-6 text-center text-sm text-neutral-500">
        <a href="/forgot-password" class="tap-target font-medium text-primary-600 hover:underline">
            কোড/লিংক না এলে নতুন অনুরোধ করুন
        </a>
    </p>
</div>
{% endblock %}
