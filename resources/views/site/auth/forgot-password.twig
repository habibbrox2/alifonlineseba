{% extends 'layouts/auth.twig' %}

{% block description %}All Seba অ্যাকাউন্টের পাসওয়ার্ড রিসেট করুন — ইমেইল লিংক বা হোয়াটসঅ্যাপ/টেলিগ্রামে কোড।{% endblock %}
{% block robots %}noindex, follow{% endblock %}
{% block title %}পাসওয়ার্ড রিসেট — All Seba{% endblock %}

{% block auth_content %}
<div class="rounded-2xl bg-white p-6 shadow-lg sm:p-8">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-extrabold text-neutral-900">পাসওয়ার্ড রিসেট</h1>
        <p class="mt-1.5 text-sm text-neutral-500">যে পদ্ধতিতে পারেন সেটিই বেছে নিন</p>
    </div>

    <form method="post" action="/forgot-password" class="space-y-4" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf }}">

        <div>
            <label for="identifier" class="form-label">ইউজারনেম / মোবাইল / ইমেইল</label>
            <input id="identifier" type="text" name="identifier" value="{{ old.identifier }}"
                   class="form-input" placeholder="01712345678" autocomplete="username" required>
            {% if errors.identifier is defined %}<p class="form-error" role="alert">{{ errors.identifier }}</p>{% endif %}
        </div>

        {# Three radios rather than one hidden default: a phone-only account
           cannot recover by email, and one that has never started the bot
           cannot recover by Telegram. The person has to be able to name the
           proof they can actually produce. #}
        <fieldset>
            <legend class="form-label">কীভাবে যাচাই করবেন?</legend>
            <div class="space-y-2">
                <label class="tap-row flex items-center gap-3 rounded-xl border border-neutral-200 px-4 py-3">
                    <input type="radio" name="channel" value="email" class="h-4 w-4 text-primary-600"
                           {{ old.channel == 'email' ? 'checked' }}>
                    <span>
                        <span class="block text-sm font-semibold text-neutral-800">ইমেইল লিংক</span>
                        <span class="block text-xs text-neutral-400">অ্যাকাউন্টে ইমেইল থাকলে লিংক পাবেন</span>
                    </span>
                </label>
                <label class="tap-row flex items-center gap-3 rounded-xl border border-neutral-200 px-4 py-3">
                    <input type="radio" name="channel" value="whatsapp" class="h-4 w-4 text-primary-600"
                           {{ old.channel == 'whatsapp' ? 'checked' }}>
                    <span>
                        <span class="block text-sm font-semibold text-neutral-800">হোয়াটসঅ্যাপ কোড</span>
                        <span class="block text-xs text-neutral-400">প্রোফাইলে হোয়াটসঅ্যাপ নম্বর থাকলে</span>
                    </span>
                </label>
                <label class="tap-row flex items-center gap-3 rounded-xl border border-neutral-200 px-4 py-3">
                    <input type="radio" name="channel" value="telegram" class="h-4 w-4 text-primary-600"
                           {{ old.channel == 'telegram' ? 'checked' }}>
                    <span>
                        <span class="block text-sm font-semibold text-neutral-800">টেলিগ্রাম কোড</span>
                        <span class="block text-xs text-neutral-400">বটের সাথে যুক্ত থাকলে</span>
                    </span>
                </label>
            </div>
            {% if errors.channel is defined %}<p class="form-error" role="alert">{{ errors.channel }}</p>{% endif %}
        </fieldset>

        <button type="submit" class="btn btn-primary btn-block">
            পাঠান
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-neutral-500">
        <a href="/login" class="tap-target inline-flex items-center gap-1.5 font-medium text-primary-600 hover:underline">
            লগইনে ফিরে যান
        </a>
    </p>
</div>
{% endblock %}
