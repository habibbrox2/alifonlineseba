{% extends 'layouts/dashboard.twig' %}

{% block title %}সার্ভিস হিস্ট্রি — All Seba{% endblock %}

{% block dashboard_content %}
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
        <h1 class="mb-1 text-2xl font-extrabold text-neutral-900">আপনার সকল অর্ডার ও ফলাফল</h1>
        <p class="text-sm text-neutral-500">যেকোনো সেবার অর্ডারের সর্বশেষ অবস্থা, ডেলিভারি ফাইল ও রেজাল্ট বিস্তারিত দেখুন</p>
    </div>
    <a href="/services" class="btn btn-primary btn-sm">+ নতুন সেবা অর্ডার করুন</a>
</div>

<!-- Order-type chips (service category), like the reference's orders page -->
<div class="mb-4 -mx-1 flex gap-2 overflow-x-auto px-1 pb-1">
    <a href="/service-history"
       class="chip shrink-0 {{ category == '' ? 'chip-active' }}">
        📦 সকল অর্ডার ({{ counts.all }})
    </a>
    {% for cat in categories %}
        <a href="/service-history?type={{ cat.slug }}"
           class="chip chip-accent shrink-0 {{ accent(cat) }} {{ category == cat.slug ? 'chip-active' }}">
            {{ cat.name }} ({{ categoryCounts[cat.slug] ?? 0 }})
        </a>
    {% endfor %}
</div>

<!-- Status filter chips, each with its row count (only meaningful without a type filter) -->
{% if category == '' %}
<div class="mb-5 flex flex-wrap gap-2">
    {% set filters = [
        { key: '', label: 'সব' },
        { key: 'pending', label: 'পেন্ডিং' },
        { key: 'processing', label: 'প্রসেসিং' },
        { key: 'completed', label: 'সম্পন্ন' },
        { key: 'failed', label: 'ব্যর্থ' },
        { key: 'cancelled', label: 'বাতিল' },
    ] %}
    {% for filter in filters %}
        <a href="/service-history{% if filter.key %}?status={{ filter.key }}{% endif %}"
           data-count-status="{{ filter.key|default('all') }}"
           class="chip {{ status == filter.key ? 'chip-active' }}">
            {{ filter.label }}
            <span class="ml-1 opacity-60" data-count>{{ counts[filter.key|default('all')] ?? 0 }}</span>
        </a>
    {% endfor %}
</div>
{% endif %}

{# data-watch-rows tells the poller this page has live rows to refresh. The ids #}
{# themselves are re-derived from the components Alpine builds, so there is no #}
{# list to keep in step with the markup here. #}
<div class="card overflow-hidden" data-watch-rows>
    {# Empty state lives outside the <table>: the 640px min-width on .table-base
       would otherwise centre it off-screen on a phone. #}
    {% if requests is empty %}
        <div class="flex flex-col items-center gap-2 px-4 py-12 text-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                {{ icon('inbox', 'w-6 h-6') }}
            </span>
            <p class="text-sm text-neutral-500">কোনো সার্ভিস অনুরোধ পাওয়া যায়নি।</p>
            <a href="/services" class="btn btn-primary btn-sm mt-2">সার্ভিস দেখুন</a>
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="table-base">
                <thead>
                    <tr>
                        <th>রেফারেন্স</th>
                        <th>সার্ভিস</th>
                        <th>পরিমাণ</th>
                        <th>অবস্থা</th>
                        <th>তারিখ</th>
                        <th class="text-right">কার্যক্রম</th>
                    </tr>
                </thead>
                    {# One <tbody> per request: the row and its result panel are siblings, #}
                    {# so the Alpine scope has to be the element that contains both of them. #}
                    {% for request in requests %}
                        <tbody data-request="{{ request|json_encode|e('html_attr') }}"
                               x-data="thServiceRequest($el.dataset.request)">
                        <tr class="align-top">

                            <td class="font-mono text-xs">{{ request.reference }}</td>
                            <td>
                                <p class="font-medium text-neutral-800">{{ request.service_name }}</p>
                                <p class="text-[11px] text-neutral-400" x-show="updatedAt !== initialUpdatedAt"
                                   x-text="updatedAt ? 'হালনাগাদ: ' + updatedAt : ''"></p>
                            </td>
                            <td class="whitespace-nowrap font-semibold text-primary-700">{{ request.amount|money }}</td>
                            <td>
                                <span class="badge" :class="badge" x-text="label"></span>
                                {# Spelled out server-side so the file is named even if the #}
                                {# download button is scrolled out of view on a phone. #}
                                <p x-show="hasDeliverable" x-cloak class="mt-1 max-w-[10rem] truncate text-[11px] text-neutral-400"
                                   x-text="deliverableName"></p>
                            </td>
                            <td class="whitespace-nowrap text-neutral-500">{{ request.created_at|bndate }}</td>
                            <td>
                                <div class="flex flex-col items-end gap-1.5">
                                    {# Actions come from the server, so they always match the current status. #}
                                    <div class="flex flex-wrap items-center justify-end gap-1.5">
                                        <template x-for="action in actions" :key="action.key">
                                            <span class="inline-flex items-center gap-1">
                                                {# The download is a navigation, so it is a real <a>: the #}
                                                {# browser streams the bytes and can save them, with no #}
                                                {# fetch-then-blob dance. An <a download> is also the only #}
                                                {# control that announces itself as a download to a screen #}
                                                {# reader and shows a target in the status bar. #}
                                                <template x-if="action.key === 'download'">
                                                    <a class="btn btn-sm" :class="action.variant" :href="fileUrl">
                                                        <svg class="h-3.5 w-3.5" aria-hidden="true">
                                                            <use :href="'/assets/icons/lucide-sprite.svg#' + action.icon"></use>
                                                        </svg>
                                                        <span x-text="action.label"></span>
                                                    </a>
                                                </template>
                                                <template x-if="action.key !== 'download'">
                                                    <button type="button" class="btn btn-sm" :class="action.variant"
                                                            :disabled="loading !== null"
                                                            @click="run(action)">
                                                        <svg class="h-3.5 w-3.5" aria-hidden="true">
                                                            <use :href="'/assets/icons/lucide-sprite.svg#' + action.icon"></use>
                                                        </svg>
                                                        <span x-text="confirming === action.key ? 'নিশ্চিত করুন' : action.label"></span>
                                                    </button>
                                                </template>
                                                <button type="button" x-show="confirming === action.key" x-cloak
                                                        class="text-[11px] text-neutral-500 hover:underline"
                                                        @click="confirming = null">না</button>
                                            </span>
                                        </template>
                                        <span x-show="actions.length === 0" class="text-xs text-neutral-400">—</span>
                                    </div>

                                    <p x-show="notice" x-cloak
                                       class="max-w-[16rem] text-right text-[11px] font-medium"
                                       :class="notice?.kind === 'success' ? 'text-success-600' : 'text-danger-600'"
                                       x-text="notice ? notice.text : ''"></p>

                                    <p x-show="error && !showResult" x-cloak class="max-w-[16rem] text-right text-[11px] text-danger-600">
                                        <span x-text="error"></span>
                                        <button type="button" class="ml-1 underline" @click="showResult = true">বিস্তারিত</button>
                                    </p>
                                </div>
                            </td>
                        </tr>

                        {# Result / error detail — revealed by the "ফলাফল দেখুন" button. #}
                        <tr x-show="showResult" x-cloak class="bg-neutral-50">
                            <td colspan="6" class="px-4 py-3">
                                <div class="alert alert-danger" x-show="error" x-cloak>
                                    <span x-text="error"></span>
                                </div>
                                <dl x-show="entries.length" class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
                                    <template x-for="entry in entries" :key="entry.key">
                                        {# The table keeps a 640px minimum, so on narrow screens the value would #}
                                        {# sit off-screen to the right. Stack label over value until there is room. #}
                                        <div class="flex flex-col items-start gap-0.5 border-b border-dashed border-neutral-200 py-1
                                                    sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
                                            <dt class="text-xs text-neutral-500" x-text="entry.label"></dt>
                                            <dd class="text-sm font-medium text-neutral-800 sm:text-right" x-text="entry.value"></dd>
                                        </div>
                                    </template>
                                </dl>
                                <p x-show="!entries.length && !error" class="text-sm text-neutral-500">
                                    এই অনুরোধের জন্য কোনো ফলাফল সংরক্ষিত নেই।
                                </p>
                            </td>
                        </tr>
                        </tbody>
                    {% endfor %}
            </table>
        </div>
    {% endif %}
</div>

{% include 'components/pagination.twig' with {
    page: page, perPage: perPage, total: total,
    baseUrl: '/service-history?' ~ (status ? 'status=' ~ status ~ '&' : '') ~ 'page=',
} %}
{% endblock %}

{% block page_scripts %}
<script type="module" src="/assets/js/service-history.js"></script>
{% endblock %}
