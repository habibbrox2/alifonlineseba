{% extends 'layouts/dashboard.twig' %}

{% block title %}পেমেন্ট করুন — রিচার্জ — Alif Tools{% endblock %}

{# Brand identity of the chosen method: label, official colour, logo mark.
   `method` comes from the query string and is re-validated by RechargeAction
   before the template is reached, but payment_brand() still degrades to an
   unbranded default for an unknown key rather than throwing. #}
{% set brand = payment_brand(method) %}

{% block dashboard_content %}
<div class="mb-6">
    <h1 class="text-2xl font-extrabold text-neutral-900">নিরাপদ ও দ্রুত ব্যালেন্স টপ-আপ</h1>
    <p class="mt-1 text-sm text-neutral-500">পার্সোনাল সেন্ড মানির মাধ্যমে তাৎক্ষণিক ব্যালেন্স রিচার্জ করুন</p>
</div>

{% if offerText %}
    <div class="mb-5 rounded-xl border border-accent-200 bg-accent-50 px-4 py-3 text-sm font-medium text-accent-800" role="status">
        {{ offerText }}
    </div>
{% endif %}

{% if hasPending %}
    <div class="mb-5 flex items-start gap-3 rounded-xl border border-warning-200 bg-warning-50 p-4 text-sm text-warning-800" role="status">
        {{ icon('history', 'w-5 h-5 shrink-0') }}
        <p>আপনার একটি রিচার্জ অনুরোধ ইতিমধ্যে পেন্ডিং আছে — সেটি প্রক্রিয়া হওয়ার পর নতুন করে জমা দিতে পারবেন।</p>
    </div>
{% endif %}

<div class="mx-auto max-w-xl">
    <section class="card p-6">
        <div class="mb-5 flex items-center justify-between gap-3">
            <h2 class="flex items-center gap-2 text-lg font-bold text-neutral-900">
                {% if brand.logo %}
                    <img src="{{ brand.logo }}" alt="{{ brand.label }}" class="pay-mark-sm">
                {% else %}
                    <span class="pay-mark-tile text-xs font-extrabold text-white"
                          style="background-color: {{ brand.color }}">{{ brand.initials }}</span>
                {% endif %}
                {{ methodLabel }} পার্সোনাল পেমেন্ট
            </h2>
            <a href="/recharge" class="text-xs font-semibold text-neutral-400 hover:text-neutral-600">← পরিবর্তন</a>
        </div>

        <p class="mb-4 text-sm text-neutral-500">নিচের নম্বরে সেন্ড মানি করুন</p>

        <div class="pay-panel pay-{{ method }} mb-5 rounded-xl p-4">
            <p class="pay-panel-eyebrow text-xs font-medium uppercase tracking-wide">পরিশোধ করতে হবে</p>
            <p class="pay-panel-amount mt-1 text-3xl font-extrabold">{{ amount|money }}</p>
        </div>

        {% if wallet %}
            <div class="mb-5" x-data="{ copied: false }">
                <p class="form-label">পার্সোনাল নম্বর:</p>
                <div class="flex items-stretch gap-2">
                    <input id="wallet-number" type="text" value="{{ wallet }}" readonly
                           class="form-input flex-1 font-mono text-lg font-bold tracking-wide text-neutral-800"
                           aria-label="{{ methodLabel }} পার্সোনাল নম্বর">
                    <button type="button" class="btn pay-accent-bg pay-{{ method }} shrink-0"
                            @click="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('wallet-number').value); copied = true; setTimeout(() => copied = false, 1500)">
                        {{ icon(copied ? 'check' : 'copy', 'w-4 h-4') }}
                        <span x-text="copied ? 'কপি হয়েছে' : 'কপি'">কপি</span>
                    </button>
                </div>
                <p class="form-help">সেন্ড মানি করুন — {{ methodLabel }} পার্সোনাল নম্বরে।</p>
            </div>
        {% else %}
            <div class="mb-5 rounded-xl border border-warning-200 bg-warning-50 px-4 py-3 text-sm text-warning-800">
                {{ icon('info', 'w-4 h-4 inline align-[-2px]') }}
                {{ methodLabel }} পার্সোনাল নম্বর এখনো যোগ করা হয়নি — অনুগ্রহ করে সাপোর্টে যোগাযোগ করুন।
            </div>
        {% endif %}

        {% if instruction %}
            <div class="mb-5 rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm leading-relaxed text-neutral-600">
                <span class="font-semibold">নির্দেশনা:</span> {{ instruction }}
            </div>
        {% endif %}

        <form method="post" action="/recharge" enctype="multipart/form-data" class="space-y-5"
              x-data="{ tooBig: false }"
              @submit="if (tooBig) { $event.preventDefault(); }">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="method" value="{{ method }}">
            <input type="hidden" name="amount" value="{{ amount|number_format(2, '.', '') }}">

            <div>
                <label for="rc_reference" class="form-label">
                    ট্রানজেকশন আইডি (TrxID) <span class="text-danger-600">*</span>
                </label>
                <input id="rc_reference" type="text" name="reference"
                       class="form-input font-mono uppercase" maxlength="64"
                       placeholder="যেমন: 9N78GH65" required>
                <p class="form-help">পেমেন্টের পর {{ methodLabel }} অ্যাপে যে TrxID দেখায় সেটিই দিন।</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label for="rc_sender" class="form-label">
                        সেন্ডার ওয়ালেট নম্বর <span class="text-danger-600">*</span>
                    </label>
                    <input id="rc_sender" type="tel" name="sender_number"
                           class="form-input" inputmode="tel" placeholder="01XXXXXXXXX" required>
                    <p class="form-help">যে নম্বর থেকে পেমেন্ট পাঠিয়েছেন।</p>
                </div>
                <div>
                    <label for="rc_sender_name" class="form-label">সেন্ডারের নাম (ঐচ্ছিক)</label>
                    <input id="rc_sender_name" type="text" name="sender_name" class="form-input" maxlength="100">
                </div>
            </div>

            <div>
                <label for="rc_receipt" class="form-label">
                    পেমেন্টের স্ক্রিনশট আপলোড (ঐচ্ছিক)
                </label>
                <input id="rc_receipt" type="file" name="receipt"
                       accept="{{ allowedExtensions|join(',') }}"
                       class="form-input file:mr-3 file:rounded-lg file:border-0 file:bg-primary-50 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-primary-700"
                       @change="const f = $event.target.files[0];
                                if (f && f.size > {{ maxBytes }}) { $event.target.value = ''; tooBig = true; }
                                else { tooBig = false; }">
                <p class="form-help">
                    সর্বোচ্চ {{ (maxBytes / 1024 / 1024)|round(2) }} MB —
                    {{ allowedExtensions|join(', ')|upper }} ফাইল গ্রহণযোগ্য।
                </p>
                <p class="form-error" role="alert" x-show="tooBig" x-cloak>
                    ফাইলটি {{ (maxBytes / 1024 / 1024)|round(2) }} MB-এর বড় — ছোট করে আবার চেষ্টা করুন।
                </p>
            </div>

            <div>
                <label for="rc_note" class="form-label">অতিরিক্ত নোট (ঐচ্ছিক)</label>
                <textarea id="rc_note" name="note" rows="2" class="form-input" maxlength="500"></textarea>
            </div>

            <div class="flex flex-wrap items-center gap-3 pt-1">
                <a href="/recharge" class="btn btn-ghost">← ফিরে যান</a>
                <button type="submit" class="btn pay-accent-bg pay-{{ method }} flex-1" :disabled="tooBig">
                    {{ icon('send', 'w-4 h-4') }} টাকা জমা দিয়েছি
                </button>
            </div>
        </form>
    </section>
</div>
{% endblock %}
