{% extends 'layouts/dashboard.twig' %}

{% block title %}লেনদেন — All Seba{% endblock %}

{% block dashboard_content %}
<h1 class="mb-2 text-2xl font-extrabold text-neutral-900">আমার লেনদেন</h1>
<p class="mb-6 text-sm text-neutral-500">
    প্রতিটি লেনদেনের হিসাব — কোথা থেকে টাকা এসেছে, কোথায় গেছে এবং লেনদেনের পর ব্যালেন্স কত ছিল।
</p>

<!-- Type filter chips -->
<div class="mb-5 flex flex-wrap gap-2">
    <a href="/transactions" class="chip {{ type == '' ? 'chip-active' }}">সব</a>
    {% for t in types %}
        <a href="/transactions?type={{ t }}" class="chip {{ type == t ? 'chip-active' }}">{{ t|ledgertype }}</a>
    {% endfor %}
</div>

<div class="card overflow-hidden">
    {# Empty state lives outside the <table>: the 640px min-width on .table-base
       would otherwise centre it off-screen on a phone. #}
    {% if rows is empty %}
        <div class="flex flex-col items-center gap-2 px-4 py-12 text-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                {{ icon('receipt', 'w-6 h-6') }}
            </span>
            <p class="text-sm text-neutral-500">
                {% if type %}এই ধরনের কোনো লেনদেন নেই।
                {% else %}কোনো লেনদেন নেই। সার্ভিস অর্ডার বা রিচার্জ করলে এখানে দেখা যাবে।{% endif %}
            </p>
            <a href="/services" class="btn btn-primary btn-sm mt-2">সার্ভিস দেখুন</a>
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="table-base">
                <thead>
                    <tr>
                        <th>রেফারেন্স</th>
                        <th>ধরন</th>
                        <th>বিবরণ</th>
                        <th class="text-right">পরিমাণ</th>
                        <th class="text-right">ব্যালেন্স</th>
                        <th>তারিখ</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tx in rows %}
                        <tr>
                            <td class="font-mono text-xs">{{ tx.reference }}</td>
                            <td><span class="badge {{ tx.type|ledgerbadge }}">{{ tx.type|ledgertype }}</span></td>
                            <td class="text-sm text-neutral-600">
                                {{ tx.description ?? (tx.service_name ?? '—') }}
                                {# Order-linked rows link to the order, not to the
                                   transaction: the customer is trying to remember
                                   a *purchase*, and that is what they can act on. #}
                                {% if tx.service_order_id %}
                                    <a href="/service-history" class="block text-[11px] text-primary-600 hover:underline">
                                        অর্ডার #{{ tx.service_order_id }} দেখুন
                                    </a>
                                {% endif %}
                            </td>
                            {# The sign is drawn, not implied by the colour: a
                               statement where every number is positive cannot
                               be balanced by the reader, and this one has to be. #}
                            <td class="text-right font-semibold {{ tx.direction == 'debit' ? 'text-danger-600' : 'text-success-700' }}">
                                {{ tx.direction == 'debit' ? '−' : '+' }}{{ tx.amount|money }}
                            </td>
                            <td class="text-right text-sm text-neutral-500">
                                {{ tx.balance_after !== null ? tx.balance_after|money : '—' }}
                            </td>
                            <td class="whitespace-nowrap text-neutral-500">{{ tx.created_at|bndate }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{% include 'components/pagination.twig' with {
    page: page, perPage: perPage, total: total,
    baseUrl: '/transactions?' ~ (type ? 'type=' ~ type ~ '&' : '') ~ 'page=',
} %}
{% endblock %}
