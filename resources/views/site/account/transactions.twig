{% extends 'layouts/dashboard.twig' %}

{% block title %}লেনদেন — TH Tools{% endblock %}

{% block dashboard_content %}
<h1 class="mb-6 text-2xl font-extrabold text-neutral-900">আমার লেনদেন</h1>

<!-- Status filter chips -->
<div class="mb-5 flex flex-wrap gap-2">
    {% set filters = [
        ['', 'সব'], ['completed', 'সম্পন্ন'], ['pending', 'পেন্ডিং'],
        ['processing', 'প্রসেসিং'], ['failed', 'ব্যর্থ'], ['cancelled', 'বাতিল'],
    ] %}
    {% for filter in filters %}
        {% set value = filter[0] %}{% set label = filter[1] %}
        <a href="/transactions{% if value %}?status={{ value }}{% endif %}"
           class="chip {{ (status == value) ? 'chip-active' }}">
            {{ label }}
        </a>
    {% endfor %}
</div>

<div class="card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="table-base">
            <thead>
                <tr>
                    <th>রেফারেন্স</th>
                    <th>সার্ভিস</th>
                    <th>পরিমাণ</th>
                    <th>স্ট্যাটাস</th>
                    <th>তারিখ</th>
                </tr>
            </thead>
            <tbody>
                {% if rows is empty %}
                    <tr>
                        <td colspan="5" class="px-4 py-12 text-center">
                            <div class="mx-auto flex max-w-xs flex-col items-center gap-2">
                                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                                    {{ icon('inbox', 'w-6 h-6') }}
                                </span>
                                <p class="text-sm text-neutral-500">কোনো লেনদেন পাওয়া যায়নি।</p>
                                <a href="/services" class="btn btn-primary btn-sm mt-2">সার্ভিস দেখুন</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {% for tx in rows %}
                        <tr>
                            <td class="font-mono text-xs">{{ tx.reference }}</td>
                            <td class="font-medium">{{ tx.service_name ?? '—' }}</td>
                            <td class="font-semibold text-primary-700">{{ tx.amount|money }}</td>
                            <td>{% include 'components/status-badge.twig' with { status: tx.status } %}</td>
                            <td class="whitespace-nowrap text-neutral-500">{{ tx.created_at|bndate }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

{% include 'components/pagination.twig' with {
    page: page, perPage: perPage, total: total,
    baseUrl: '/transactions?' ~ (status ? 'status=' ~ status ~ '&' : '') ~ 'page=',
} %}
{% endblock %}
