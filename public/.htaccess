# TH Tools — Apache shared-hosting entry point (place inside public/).
# If your host cannot point DocumentRoot at public/, see docs/deployment.md
# for the root-level wrapper variant.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to real files/dirs (assets, favicon, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Block dotfiles (.env, .git, ...)
    RewriteRule (^\.|/\.) - [F]

    # Front controller
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>

# Never serve secrets if someone requests them directly.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
