Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow well-known resources to reach Apache/front controller.
    RewriteRule ^\.well-known/(?:assetlinks\.json|acme-challenge/) - [E=ALLOW_WELL_KNOWN:1]

    # Block dotfiles except explicitly allowed .well-known resources.
    RewriteCond %{ENV:ALLOW_WELL_KNOWN} !=1
    RewriteRule (^|/)\. - [F,L]

    # Serve existing files/directories directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [END]

    # Yii front controller.
    RewriteRule ^ index.php [END]
</IfModule>

# Defense-in-depth for dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html \
        text/css \
        application/javascript \
        application/json \
        image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>