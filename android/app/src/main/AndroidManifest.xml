<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Sideloaded updates. From API 26 the user must allow this app to install
      packages from Settings before an install intent will work at all; the app
      routes them there via UpdateChecker.requestInstallPermission(). It is
      "normal" rather than "special" protection, so it is granted at install
      time and the per-app Settings toggle is what actually gates the install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Alif Tools"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AlifTools"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AlifTools.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: tap on a push lands on the exact screen (audit §7).
                 App Links over https + a custom scheme fallback for the pilot. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="onlinesheba.broxlab.online"
                    android:pathPrefix="/requests/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aliftools" android:host="requests" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.AlifToolsFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
