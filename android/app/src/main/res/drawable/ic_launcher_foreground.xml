<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground layer of the adaptive icon: the gold bolt and the white tick
     from public/assets/brand/logo-mark.svg, without the tile.

     The tile itself is the background layer (@color/ic_launcher_background,
     primary-900), because the launcher masks this layer to whatever shape the
     device uses; a rounded tile drawn here would be cropped by the mask.

     Geometry is the 64-unit design grid mapped onto the 108-unit canvas by a
     factor of 1.125 (72/64), which is exactly the inner safe zone of an
     adaptive icon, then centred with an 18-unit offset. Scaling by anything
     larger puts the tick's far end inside the region a circular mask cuts
     away, and the tick is the part of the mark that has to survive. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- bolt: speed -->
    <path
        android:fillColor="#F5B301"
        android:pathData="M56.25,25.875 L37.125,59.625 L48.375,59.625 L45,82.125 L66.375,48.375 L54,48.375 Z" />

    <!-- tick halo, then the tick: verified -->
    <path
        android:pathData="M61.875,69.75 L69.1875,76.5 L81,58.5"
        android:strokeColor="#083F31"
        android:strokeWidth="12.375"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M61.875,69.75 L69.1875,76.5 L81,58.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7.875"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>