<?xml version="1.0" encoding="utf-8"?>
<!-- Night themes. Two things have to move together, otherwise fixing the
     splash just moves the seam:

       1. Theme.AlifTools.Splash inherits @color/brand_primary from
          values-night/colors.xml, so the launch backdrop is the app's own dark
          surface instead of a green block in front of it.
       2. Theme.AlifTools switches from android:Theme.Material.Light to the
          dark parent. postSplashScreenTheme hands off to this style, so if it
          stayed Light the very first frame after the splash would be white —
          exactly the flash this whole set exists to remove.
       3. windowBackground is pinned to the same @color/brand_primary in both
          files. The window background is what is visible in the gap between
          the system splash disappearing and the first Compose frame, so
          leaving it white reintroduces a white sliver on a dark launch. -->
<resources>
    <style name="Theme.AlifTools" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_primary</item>
    </style>

    <style name="Theme.AlifTools.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AlifTools</item>
    </style>
</resources>
