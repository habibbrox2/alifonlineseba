[TEMPLATE]
# Copy to .env and adjust per environment.
APP_ENV=prod            # dev | test | prod
APP_DEBUG=false        # MUST be false in production
APP_URL=https://allseba.dgtts.org

# The app reads DB_DSN directly (host/port/dbname/charset in one string).
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=alif_tools;charset=utf8mb4
DB_USERNAME=root
DB_PASSWORD=
DB_TABLE_PREFIX=

CACHE_PATH=runtime/cache
SESSION_NAME=ALIF_SESSION
THROTTLE_MAX_ATTEMPTS=5
THROTTLE_DECAY_SECONDS=300

# --- Notifications (leave empty to disable the channel) ---
NOTIFY_QUEUE_BATCH=200
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BACKOFF_BASE=60
NOTIFY_RETENTION_DAYS=180

# --- Admin bulk actions (the order queue's status + export bar) ---
# Orders settled per chunk by `app:bulk:work`. Smaller chunks report progress
# more often and survive a tighter request limit; larger ones do less
# bookkeeping. Batches themselves are capped at 100 by the service layer.
BULK_CHUNK_SIZE=25

# --- API tokens (machine auth for the APK) ---
# openssl rand -hex 32 — required for bearer-token HMAC and PII encryption
APP_KEY=
API_TOKEN_TTL_DAYS=30

# --- Telegram (admin bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Firebase / FCM (path OUTSIDE the web root to the service-account JSON) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Verify with: php yii app:fcm:check [--token=DEVICE_TOKEN]
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# --- Web Push (VAPID, RFC 8292) — browser notifications for signed-out visitors ---
# Both values must be set or the channel reports itself unavailable and the /app
# page shows the "not configured" notice. Generate a pair with:
#   php scripts/generate-vapid-keys.php mailto:ops@example.com
# VAPID_SUBJECT must be a mailto: or https: URI — push services use it to reach
# you about a revoked subscription, and a bare domain is rejected.
VAPID_SUBJECT=
# Raw 32-byte P-256 scalar, base64url encoded (NOT a PEM: dotenv eats newlines).
VAPID_PRIVATE_KEY=
# Seconds a push service may hold a message for an offline device. 86400 is
# roughly "a phone that was off over the weekend still gets it".
WEB_PUSH_TTL=86400
# 0-5. At or below 5 the message is sent as `normal`; above that as `high`,
# which wakes the device but is rationed by the push service. Leave at 5.
WEB_PUSH_URGENCY=5

# --- Android app distribution ---
# Set to 0 to take /app/apk offline without unpublishing the release record.
APP_DOWNLOADS_ENABLED=true

# --- Trusted Web Activity (the /app APK runs the site full screen) ---
# The APK may only hide the browser address bar for an origin that publishes its
# signing certificate at /.well-known/assetlinks.json. Without both values below
# that route answers 403 and the installed app quietly opens as a browser tab.
# TWA_ORIGIN is the bare https origin: no path, no trailing slash, and it is
# never derived from the request Host header.
TWA_ORIGIN=https://allseba.dgtts.org
# package@SHA256:AA:BB: pairs, comma or newline separated. The package must be the
# TWA applicationId (online.broxlab.aliftools.twa); the native client id belongs
# to a different APK and can never be satisfied by this one. List the debug and the
# release certificate both, or the unlisted build shows a browser bar. Generate the
# value with:
#   php yii app:twa:fingerprints --cert=release.cer --package=online.broxlab.aliftools.twa
TWA_FINGERPRINTS=
