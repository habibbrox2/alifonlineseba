# Alif Tools environment
# Copy this file to .env, then set the values for your environment.
# Keep real credentials and private keys in .env, never in this template.

# --- Application ---
APP_ENV=dev                         # dev | test | prod
APP_DEBUG=true                      # Set false in production
APP_URL=http://127.0.0.1:8080       # Public base URL; no trailing slash
CANONICAL_URL=                      # Optional canonical host, e.g. https://allseba.online
APP_C3=false                        # Enable Codeception C3 profiling only for tests
APP_HOST_PATH=                      # Optional error trace-link path; does not enable subdirectory hosting

# --- Database ---
# Keep charset=utf8mb4 so Bengali text is stored and returned correctly.
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=alif_tools;charset=utf8mb4
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TABLE_PREFIX=

# --- Runtime, sessions, and rate limits ---
CACHE_PATH=runtime/cache
SESSION_NAME=ALIF_SESSION
THROTTLE_MAX_ATTEMPTS=5
THROTTLE_DECAY_SECONDS=300

# --- Security and API tokens ---
# Generate a random 32-byte key, for example: php -r "echo bin2hex(random_bytes(32));"
# Required for bearer-token HMAC and PII encryption; changing it invalidates tokens.
APP_KEY=
API_TOKEN_TTL_DAYS=30

# --- Email (leave MAIL_FROM empty to disable email delivery) ---
MAIL_FROM=
MAIL_FROM_NAME="All Seba"

# --- Notifications ---
NOTIFY_QUEUE_BATCH=200
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BACKOFF_BASE=60
NOTIFY_RETENTION_DAYS=180

# Admin order bulk-processing chunk size (batches are capped at 100).
BULK_CHUNK_SIZE=25

# --- Telegram admin bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Firebase Cloud Messaging (optional) ---
# Path to the service-account JSON; keep the JSON outside the public web root.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# --- Firebase Authentication for the web (optional) ---
# Get the web app values from Firebase Console > Project settings > General.
# FIREBASE_PROJECT_ID is shared with the Firebase Cloud Messaging configuration.
# Set FIREBASE_AUTH_WEB_CLIENT_ID to enable the social sign-in UI.
FIREBASE_AUTH_WEB_CLIENT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# --- Firebase phone authentication (optional) ---
# reCAPTCHA v3 site key; add your domain to its allowed domains.
RECAPTCHA_SITE_KEY=

# --- Browser push notifications (optional; VAPID) ---
# Generate with: php scripts/generate-vapid-keys.php mailto:ops@example.com
# VAPID_SUBJECT must be a mailto: or https: URI.
VAPID_SUBJECT=
# Base64url-encoded raw 32-byte P-256 private scalar (not a PEM).
VAPID_PRIVATE_KEY=
WEB_PUSH_TTL=86400                   # Seconds a push service may retain a message
WEB_PUSH_URGENCY=5                   # 0-5 normal; above 5 is high urgency

# --- Android app distribution ---
APP_DOWNLOADS_ENABLED=true

# --- Trusted Web Activity (optional) ---
# Set both values to publish /.well-known/assetlinks.json and hide the browser bar.
# Origin must be a bare HTTPS origin (no path or trailing slash).
TWA_ORIGIN=
# Comma- or newline-separated package@SHA256:AA:BB:... certificate fingerprints.
# Generate with: php yii app:twa:fingerprints --cert=release.cer --package=online.broxlab.aliftools.twa
TWA_FINGERPRINTS=
