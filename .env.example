# All Seba / Alif Tools — environment configuration
# Copy to .env and fill in the values. Never commit .env.

APP_ENV=dev
APP_DEBUG=false
APP_URL=https://beta.allseba.online
# The one host search engines may index. Empty = same as APP_URL.
CANONICAL_URL=

# --- Database ---
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=th_tools;charset=utf8mb4
DB_USERNAME=root
DB_PASSWORD=
DB_TABLE_PREFIX=

# --- Paths ---
CACHE_PATH=runtime/cache
SESSION_NAME=ALIF_SESSION

# --- Throttling ---
THROTTLE_MAX_ATTEMPTS=5
THROTTLE_DECAY_SECONDS=300

# --- Notifications ---
NOTIFY_QUEUE_BATCH=200
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BACKOFF_BASE=60
NOTIFY_RETENTION_DAYS=180

# --- API tokens ---
API_TOKEN_TTL_DAYS=30
APP_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# --- Web Push (VAPID) ---
VAPID_SUBJECT=
VAPID_PRIVATE_KEY=
WEB_PUSH_TTL=86400
WEB_PUSH_URGENCY=5

# --- Android app distribution ---
APP_DOWNLOADS_ENABLED=true

# --- Trusted Web Activity ---
TWA_ORIGIN=
TWA_FINGERPRINTS=